{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coldbox status v1",
  "type": "object",
  "required": ["schema_version", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "verdict": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "build": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ok", "message"],
        "properties": {
          "ok": {"type": "boolean"},
          "message": {"type": "string"},
          "fix": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "details": {"$ref": "#/$defs/lines"},
    "hosts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/host"}},
    "error": {"type": "string"}
  },
  "additionalProperties": false,
  "oneOf": [
    {"required": ["build", "checks", "details"], "properties": {"verdict": {"enum": ["PASS", "FAIL"]}}},
    {"required": ["hosts"]},
    {"required": ["error"], "properties": {"verdict": {"const": "INCOMPLETE"}}}
  ],
  "$defs": {
    "lines": {"type": "array", "items": {"type": "string"}},
    "host": {
      "type": "object",
      "required": ["host", "build", "verdict", "orphans", "last_receipt", "jobs_24h", "supervisors", "health"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "build": {"type": "string", "pattern": "^([0-9a-f]{12}|-)$"},
        "verdict": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
        "orphans": {"type": "string", "pattern": "^(\\d+|-)$"},
        "last_receipt": {"type": "string"},
        "jobs_24h": {"type": "string"},
        "supervisors": {"$ref": "#/$defs/lines"},
        "health": {"$ref": "#/$defs/lines"}
      },
      "additionalProperties": false
    }
  }
}
