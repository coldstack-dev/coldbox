def direct_cache(repo, sha, token):
    if not token:
        return None
    try:
        folder = cache_folder(repo, False)
        if not folder:
            return None
        if any(r['target'].casefold() == repo.casefold() and r['allow_public'] for r in registrations()):
            return None
        metadata = app_request(f'repos/{repo}', token)
        if metadata['visibility'] != 'private' or metadata['full_name'].casefold() != repo.casefold():
            return None
        branches = app_request(f'repos/{repo}/commits/{sha}/branches-where-head', token)
        if any(branch['commit']['sha'] == sha for branch in branches):
            return folder
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, AttributeError):
        return None


def cache_in(name, folder, tool):
    tar = folder / f'{tool}.tar'
    started = time.time()
    try:
        with tar.open('rb') as data:
            size = os.fstat(data.fileno()).st_size
            code = subprocess.run(ic_exec(name, 'tar', '-x', '-C', f'/home/{RUNNER}', CACHES[tool], timeout=600),
                                  stdin=data, capture_output=True).returncode
    except FileNotFoundError:
        return dict(in_bytes=0)
    except (OSError, subprocess.SubprocessError) as error:
        return dict(in_bytes=0, in_error=str(error))
    return dict(in_bytes=size, in_seconds=round(time.time() - started, 3), in_exit=code)


def fills_cache(repo, runner, runner_id, github):
    try:
        run = gh(f"repos/{repo}/actions/runs/{int(github['run_id'])}")
        jobs = attempt_jobs(repo, run['id'], int(github['run_attempt']))
        default = gh(f'repos/{repo}')['default_branch']
        tip = gh(f'repos/{repo}/git/ref/heads/{default}')['object']['sha']
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return False
    mine = [job for job in jobs if job.get('runner_name') == runner]
    return (run.get('event') == 'push' and run.get('head_branch') == default and run.get('head_sha') == tip
            and ((run.get('head_repository') or {}).get('full_name') or '').casefold() == repo.casefold()
            and runner_id is not None and len(mine) == 1 and mine[0].get('runner_id') == runner_id
