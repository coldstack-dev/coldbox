def cache_out(name, folder, tool):
    started, size = time.time(), 0
    if subprocess.run(ic_exec(name, 'test', '-e', f'/home/{RUNNER}/{CACHES[tool]}', timeout=60),
                      capture_output=True).returncode == 1:
        return dict(out_bytes=0, out_absent=True)
    with (folder / '.fill.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return dict(out_bytes=0, out_refused='another job of this repo is saving the cache')
        for stale in folder.glob(f'.{tool}.tar.*'):
            stale.unlink(missing_ok=True)
        partial = folder / f'.{tool}.tar.{name}'
        try:
            with partial.open('wb') as out, \
                    subprocess.Popen(ic_exec(name, 'tar', '-c', '-C', f'/home/{RUNNER}', CACHES[tool], timeout=600),
                                     stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL) as proc:
                try:
                    while size <= CACHE_MAX_BYTES and (chunk := proc.stdout.read(2**20)):
                        size += len(chunk)
                        out.write(chunk)
                except BaseException:
                    proc.kill()
                    raise
                if size > CACHE_MAX_BYTES:
                    proc.kill()
            if proc.returncode == 0 and size <= CACHE_MAX_BYTES:
                os.replace(partial, folder / f'{tool}.tar')
                return dict(out_bytes=size, out_seconds=round(time.time() - started, 3))
            return dict(out_bytes=0, out_refused=f'tar exit {proc.returncode}, {size} bytes read')
        finally:
            partial.unlink(missing_ok=True)


