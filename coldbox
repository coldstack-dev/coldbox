    rows = json.loads(ic('list', '--format', 'json', '--columns', 'n'))
    return {vm['name'] for vm in rows if vm['name'].startswith('cbx-')}


def waiting(worker):
    if worker.kind != 'base':
        return False
    try:
        return not runner_state(STATE / 'receipts' / f'{worker.name}.log')[0]
    except FileNotFoundError:
        return True


def holds_slots(registration):
    return registration.get('configured') or registration['active'] not in IDLE_UNIT


def host_load(workers):
    """Count this host's job VMs as (busy, warm). Warm ones are slot VMs still waiting for a job; every other Coldbox
    VM is busy."""
    return capacity_used(workers), sum(map(waiting, workers))


def vm_bytes(worker, memory):
    return getattr(worker, 'memory', None) or memory


def additional_vm_memory(workers, memory, vms=None, retiring=None):
    retiring_set = {retiring} if isinstance(retiring, str) else set(retiring or ())
    sizes = {worker.name: vm_bytes(worker, memory) for worker in workers}
    owned = (host_vms() if vms is None else vms) | set(sizes)
    committed = 0
    for vm in query('/1.0/instances?recursion=1&all-projects=true'):
        if vm['type'] != 'virtual-machine' or vm['status'] != 'Running':
            continue
        if vm['project'] == PROJECT and vm['name'] in retiring_set:
            continue
        counted = sizes.get(vm['name'], memory) if vm['project'] == PROJECT and vm['name'] in owned else 0
        limit = (vm.get('expanded_config') or {}).get('limits.memory') or (vm.get('config') or {}).get('limits.memory')
        size = size_bytes(limit) if limit else memory
        if vm['project'] != PROJECT:
            size = memory_in_use(vm) or size
        committed += max(0, size - counted)
    return committed


def memory_in_use(vm):
    try:
        usage = query(f"/1.0/instances/{vm['name']}/state?project={vm['project']}")['memory']['usage']
    except (subprocess.CalledProcessError, ValueError, TypeError, KeyError):
        return None
    return usage if type(usage) is int and usage > 0 else None


def capacity_used(workers):
    """Busy job VMs: every Coldbox VM and worker except slot VMs still waiting for a job."""
    return len(host_vms() - {worker.name for worker in workers}) + len(workers) - sum(map(waiting, workers))


def host_room(workers, memory, need, load, reserve, vms=None, retiring=None):
    """Room for job VMs of need bytes beside workers and every Coldbox VM on this host, by each admission check."""
    host, vms = host_memory(), host_vms() if vms is None else vms
    retiring_set = {retiring} if isinstance(retiring, str) else set(retiring or ())
    if retiring_set:
        vms = vms - retiring_set
        workers = [worker for worker in workers if worker.name not in retiring_set]
    untracked = vms - {worker.name for worker in workers}
    extra = additional_vm_memory(workers, memory, vms, retiring)
    committed = sum(vm_bytes(worker, memory) for worker in workers) + len(untracked) * memory + extra
    available = host_memory('MemAvailable') - extra - sum(map(unready, untracked)) * memory - \
        sum(vm_bytes(worker, memory) for worker in workers if unready(worker.name))
    now = time.time()
    booting = sum(warming(worker.name, now) for worker in workers)
    return rooms(len(untracked) + len(workers), host_cpus(), load + CORES_PER_JOB * booting, available,
                 memory_floor(host), need, reserve,
                 (host - host_share(host) - committed) // need)


def vm_room():
    """Count job VMs without the host lock, as (busy, the most busy VMs the admission rule allows now). Workers are
    read between two VM listings and only VMs in both count, so every counted worker or VM existed when the workers
    were read."""
    memory, listed = vm_memory(), host_vms()
    workers = live_workers(STATE / 'workers', prune=False)
    vms = listed & host_vms()
    used = len(vms - {worker.name for worker in workers}) + len(workers) - sum(map(waiting, workers))
    disks, _ = storage_room(workers)
    if not disks:
        return used, used
    room = host_room(workers, memory, memory, os.getloadavg()[0], host_setting(RESERVE, 'CPU threads'), vms)
    return used, used + burst_count(disks, room)


def admit(target, name, kind, writers=None, memory=None, submissions=None, *, sample_cpu=False):
    me = argparse.Namespace(pid=os.getpid(), target=target, name=name, kind=kind, writers=writers, memory=memory)
    with host_lock():
        queued = False
        if submissions is not None:
            queue = waiting_submissions(submissions)
            result = submissions / f'{name}.json'
            if result.exists():
                raise SystemExit(json.loads(result.read_text())['error'])
            queued = any(request['id'] == name for request in queue)
            if queued and queue[0]['id'] != name:
                return False
        workers = live_workers(STATE / 'workers')
        if kind == 'burst' and any(worker.pid == me.pid and worker.target == target and worker.name == name
                                   and worker.kind == kind for worker in workers):
            note_worker(me.pid, target, name, kind, writers, me.memory)
            return True
        workers = [worker for worker in workers if worker.pid != me.pid]
        memory = vm_memory()
        if kind == 'vm' and (refusal := past_vm_max(name, workers)):
            raise SystemExit(refusal)
        ci = kind not in ('vm', 'warm')
        cpu_load = host_cpu_load() if sample_cpu else 0
        load = max(cpu_load, os.getloadavg()[0]) if ci else 0
        room = host_room(workers, memory, vm_bytes(me, memory), load, host_setting(RESERVE, 'CPU threads') if ci else 0)
        if not burst_count(1, room):
            print(f'coldbox: no room for a job VM: {declined(room)} ({room})', file=sys.stderr, flush=True)
            return False
        _, refusal = storage_room(workers)
        if refusal:
            print(refusal, file=sys.stderr, flush=True)
            return False
        if queued and time.time() >= queue[0]['deadline']:
            waiting_submissions(submissions)
            return False
        note_worker(me.pid, target, name, kind, writers, me.memory)
        if queued:
            write_json(submissions / 'queue.json', queue[1:])
        return True


def past_vm_max(name, workers):
    if not VM_MAX.exists():
        return None
    cap = host_setting(VM_MAX, 'VMs')
    if len({name} | {worker.name for worker in workers if worker.kind == 'vm'} | set(adhoc_vms())) > cap:
        return f'coldbox: {cap} ad-hoc VM(s) already running, the limit in {VM_MAX}; coldbox vm down one first'
    return None


def host_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    lock = os.fdopen(os.open(STATE / 'autoscale.lock', os.O_RDONLY | os.O_CREAT, 0o644))
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def unready(name):
    if (STATE / 'ready' / name).exists():
        return False
    try:
        return not (STATE / 'receipts' / f'{name}.log').stat().st_size
    except OSError:
        return True


def warming(name, now):
    try:
        return now - (STATE / 'ready' / name).stat().st_mtime < STARTING_SECONDS
    except FileNotFoundError:
        return unready(name)


def starting(name, now):
    try:
        return now - int(name.split('-')[1]) < STARTING_SECONDS
    except (IndexError, ValueError):
        return False


def free_runners(runners, bursts, now):
    """Runners that can still take a queued job, by size: online and idle, starting up, or a burst not yet on GitHub."""
    listed = {runner['name'] for runner in runners}
    free = collections.Counter(job_size(label['name'] for label in runner.get('labels', ())) or 'default'
                               for runner in runners if runner['name'].startswith('cbx-') and not runner['busy']
                               and (runner['status'] == 'online' or starting(runner['name'], now)))
    free.update(getattr(burst, 'size', 'default') for burst in bursts
                if burst.name not in listed and starting(burst.name, now))
    return free


def journal_stderr():
    stream = os.environ.get('JOURNAL_STREAM')
    if stream and os.environ.get('INVOCATION_ID'):
        with contextlib.suppress(OSError, ValueError):
            stat = os.fstat(sys.stderr.fileno())
            return stream == f'{stat.st_dev}:{stat.st_ino}'
    return False


def log_queue_witness(size, witness, queued, idle, room=None, stopping=False, storage=False, ramp=False, spawned=()):
    age, run_id, job_id, attempt = witness
    if not all(type(value) is int and 0 < value < 2**63 for value in (run_id, job_id)):
        return
    attempt_field = f' attempt={attempt}' if type(attempt) is int and 0 < attempt < 2**63 else ''
    decision = ('result=covered' if room is None else
                f'result=dispatch room={room["ceiling"]}/{room["memory"]}/{room["load"]}'
                f' stopping={int(stopping)} storage={int(storage)} ramp={int(ramp)}')
    with contextlib.suppress(OSError, ValueError):
        print(f'coldbox: stall witness size={size} eligible=1 run={run_id} job={job_id}{attempt_field}'
              f' age_s={age} queued={queued} idle={idle} {decision} spawned={",".join(spawned) or "-"}'
              ' association=capacity-only', file=sys.stderr, flush=True)


def autoscale(github, args, bursts):
    """Start a burst runner for each queued job no free runner can take, and return the seconds to wait before the
    next pass."""
    folder = STATE / 'workers'
    finished = [burst for burst in bursts if burst.poll() is not None]
    if finished:
        bursts[:] = [burst for burst in bursts if burst not in finished]
        with host_lock():
            live_workers(folder)
    try:
        writers = public_rules(github, args)
    except Unsafe:
        release_waiting(github, args.target, lambda worker: True)
        raise
    release_waiting(github, args.target, lambda worker: worker.writers != writers)
    reserve = host_setting(RESERVE, 'CPU threads')
    witnesses = {} if writers is None and journal_stderr() else None
    seen, oldest, sizes = observe_queue(github, args.target, writers=writers, witnesses=witnesses)
    if seen:
        print(f'coldbox: queue on {args.target}: {seen} queued job(s); oldest waited {oldest} s',
              file=sys.stderr, flush=True)
    idle = collections.Counter()
    if seen:
        for burst in bursts:
            if (record := worker_record(folder / str(burst.pid))) is not None:
                burst.name = record[2]
        runners = listing(github, f'repos/{args.target}/actions/runners?', 'runners')
        idle = free_runners(runners, bursts, time.time())
    github.forget_unused()
    wanted = {size: sizes[size] - idle[size] for size in SIZES if sizes[size] > idle[size]}
    raw_load, cpu_load = (os.getloadavg()[0], host_cpu_load()) if wanted else (0, 0)
    reclaim_attempted = False
    for size, extra in wanted.items():
        first_spawn = len(bursts)
        size_memory, _ = vm_shape(size)
        reclaimed = None
        pool_stamp = None
        if size == 'default' and warm_pool_on():
            with contextlib.suppress(OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError):
                pool_stamp = warm_job_stamp(offline=False)
        with host_lock() as lock:
            workers, memory = live_workers(folder), vm_memory()
            need = size_memory or memory
            booting = sum(worker.kind == 'burst' and starting(worker.name, time.time()) for worker in workers)
            (vms, warm), cpus = host_load(workers), host_cpus()
            load = max(cpu_load, raw_load) + booting
            room = host_room(workers, memory, need, load, reserve)
            stopping = STOPPING.is_set()
            claimable_standbys = []
            if not stopping and (burst_count(extra, room) < extra or size == 'default'):
                ready_standbys, evictable = standby_warm_vms(workers, stamp=pool_stamp)
                if ready_standbys:
                    candidate = ready_standbys[:extra]
                    with_standbys = host_room(workers, memory, need, load, reserve, retiring=candidate)
                    usable = min(len(candidate), burst_count(extra, with_standbys))
                    claimable_standbys = candidate[:usable]
                    if claimable_standbys:
                        room = host_room(workers, memory, need, load, reserve, retiring=claimable_standbys)
                if burst_count(extra, room) < extra and evictable:
                    per_job = max(1, math.ceil(need / memory))
                    evict_names = evictable[:(extra - burst_count(extra, room)) * per_job]
                    for standby_name in evict_names:
                        ic('config', 'set', standby_name, f'{WARM_JOB}=retired')
                    fcntl.flock(lock, fcntl.LOCK_UN)
                    for standby_name in evict_names:
                        destroy(standby_name)
                        (STATE / 'ready' / standby_name).unlink(missing_ok=True)
                        note_pool('reaped', vm=standby_name, reason='yielded')
                    raw_load, cpu_load = os.getloadavg()[0], host_cpu_load()
                    fcntl.flock(lock, fcntl.LOCK_EX)
                    workers = live_workers(folder)
                    reserved_now = {worker.name for worker in workers}
                    claimable_standbys = [name for name in claimable_standbys if name not in reserved_now]
                    booting = sum(worker.kind == 'burst' and starting(worker.name, time.time()) for worker in workers)
                    (vms, warm) = host_load(workers)
                    load = max(cpu_load, raw_load) + booting
                    room = host_room(workers, memory, need, load, reserve, retiring=claimable_standbys)
                    stopping = STOPPING.is_set()
            if (not stopping and not reclaim_attempted and warm and room['ceiling'] == 0
                    and room['memory'] > 0 and room['load'] > 0 and ramp_room(1, vms) and storage_room(workers)[0]):
                reclaim_attempted = True
                fcntl.flock(lock, fcntl.LOCK_UN)
                reclaimed = reclaim(github, args.target, workers, memory, need, lock=lock)
                if reclaimed:
                    raw_load, cpu_load = os.getloadavg()[0], host_cpu_load()
                fcntl.flock(lock, fcntl.LOCK_EX)
                if reclaimed:
                    extra = 1
                    if reclaimed in (workers := live_workers(folder)):
                        (folder / str(reclaimed.pid)).unlink(missing_ok=True)
                        workers.remove(reclaimed)
                    booting = sum(worker.kind == 'burst' and starting(worker.name, time.time()) for worker in workers)
                    (vms, warm) = host_load(workers)
                    load = max(cpu_load, raw_load) + booting
                    room = host_room(workers, memory, need, load, reserve, retiring=claimable_standbys)
                    stopping = STOPPING.is_set()
            add = 0 if stopping else burst_count(extra, room)
            refusal = None
            reuse = min(add, len(claimable_standbys))
            if add - reuse:
                disks, refusal = storage_room(workers)
                if refusal:
                    print(refusal, file=sys.stderr, flush=True)
                add = reuse + min(add - reuse, disks)
            uncapped = add
            add = ramp_room(add, max(0, vms - reuse))
            for index in range(add):
                name = claimable_standbys[index] if index < len(claimable_standbys) else new_id()
                burst = subprocess.Popen(worker_argv(args, '--once', '--idle', str(BURST_IDLE_SECONDS), '--name',
                                                     name, *['--standby'] * (index < len(claimable_standbys)),
                                                     *(['--size', size] if size != 'default' else [])))
                burst.name, burst.size = name, size
                note_worker(burst.pid, args.target, name, 'burst', None, size_memory)
                bursts.append(burst)
        print(f'coldbox: {sizes[size]} queued job(s) and {idle[size]} idle runner(s) on {args.target}'
              + (f' for {size} VMs' if size != 'default' else '') +
              f'; oldest waited {oldest} s; started {add} burst runner(s); host has {vms} busy and {warm} warm job VM(s) and load {load:.1f} on '
              f'{cpus} CPU threads' + (f' ({reserve} reserved)' if reserve else '') +
              f'; raw load {raw_load:.1f}; booting {booting}; room {room}; VM memory {need}; stopping {stopping}' +
              (f'; declined by {declined(room)}' if add < extra and not stopping else '') +
              (f'; ramp admitted {add} of {uncapped}' if (STATE / 'ramp-cap.json').exists() else '') +
              (f'; reclaimed idle slot {reclaimed.name}' if reclaimed else ''),
              file=sys.stderr, flush=True)
        if witnesses and size in witnesses:
            log_queue_witness(size, witnesses[size], sizes[size], idle[size], room, stopping, bool(refusal),
                              add < uncapped, (burst.name for burst in bursts[first_spawn:]))
    for size, witness in (witnesses or {}).items():
        if size not in wanted:
            log_queue_witness(size, witness, sizes[size], idle[size])
    return AUTOSCALE_SECONDS


def public_rules(github, args):
    repo = github.get(f'repos/{args.target}')
    if repo['full_name'].casefold() != args.target.casefold() or repo['visibility'] != 'private' and not args.allow_public:
        raise Unsafe(f"{args.target} now resolves to {repo['visibility']} {repo['full_name']}; not scaling it")
    return None if repo['visibility'] == 'private' else public_writers(github.get, args.target, repo)


def release_waiting(github, target, stale):
    """Deregister this host's idle runners for target whose worker holds stale approval rules, and wake those workers
    so they start over with fresh rules. Runs every pass, so a failed delete or a runner registered after the rules
    changed is caught next time. GitHub refuses to delete a busy runner, so running jobs keep going."""
    with host_lock():
        pids = {worker.name: worker.pid for worker in live_workers(STATE / 'workers')
                if worker.target == target and stale(worker)}
    if not pids:
        return
    runners = listing(github, f'{scope(target)}/actions/runners?', 'runners')
    released = 0
    for runner in runners:
        if runner['name'] not in pids or runner['busy']:
            continue
        with contextlib.suppress(RuntimeError, OSError):
            release(target, runner['id'])
            os.kill(pids[runner['name']], signal.SIGUSR1)
            released += 1
    print(f'coldbox: released {released} waiting runner(s) on {target} that held out-of-date approval rules; '
          f'running jobs keep going', file=sys.stderr, flush=True)


def release(target, runner_id, **request):
    gh('-X', 'DELETE', f'{scope(target)}/actions/runners/{runner_id}', **request)


def wake_slot(worker):
    fields = worker_record(STATE / 'workers' / str(worker.pid))
    if (fields is not None and fields[2] == worker.name and fields[1]
            and fields[1] == process_start(worker.pid) and waiting(worker)):
        os.kill(worker.pid, signal.SIGUSR1)
        return True
    return False


def reclaim(github, target, workers, memory, need, *, lock=None):
    workers = {worker.name: worker for worker in workers}
    candidates = []
    runners = {}
    for name in sorted(host_vms()):
        worker = workers.get(name)
        if worker is not None and worker.kind != 'base':
            continue
        try:
            receipt = json.loads((STATE / 'receipts' / f'{name}.json').read_text())
            repo, started, runner_id = receipt['repo'], at(receipt['job_started_at']), receipt['runner_id']
        except (OSError, ValueError, TypeError, KeyError):
            continue
        if receipt.get('mode') != 'runner' or not isinstance(repo, str) or '/' not in repo or type(runner_id) is not int:
            continue
        if repo not in runners:
            runners[repo] = {runner['id']: runner for runner in listing(github, f'{scope(repo)}/actions/runners?', 'runners')}
        runner = runners[repo].get(runner_id)
        if runner is None or runner['name'] != name:
            return None
        if (worker is not None and worker.target.casefold() == repo.casefold() and repo.casefold() != target.casefold()
                and vm_bytes(worker, memory) >= need and runner['status'] == 'online' and not runner['busy']
                and waiting(worker)):
            candidates.append((started, name, worker, runner_id))
    if not candidates or STOPPING.is_set():
        return None
    _, name, worker, runner_id = min(candidates)
    try:
        with (STATE / 'receipts' / f'{name}.json').open() as claim:
            fcntl.flock(claim, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if not reclaim_room(worker, memory, need):
                return None
            if STOPPING.is_set() or name not in host_vms() or not waiting(worker):
                return None
            release(worker.target, runner_id, _retries=[0])
            print(f'coldbox: reclaim deregistered idle slot {name} for {target}', file=sys.stderr, flush=True)
            if lock is not None:
                fcntl.flock(lock, fcntl.LOCK_EX)
            if not wake_slot(worker):
                return None
            deadline = time.monotonic() + RECLAIM_SECONDS
            while name in host_vms():
                if time.monotonic() >= deadline:
                    return None
                time.sleep(1)
    except (OSError, RuntimeError):
        return None
    return worker


def reclaim_room(donor, memory, need):
    cpu_load = host_cpu_load()
    with host_lock():
        workers = live_workers(STATE / 'workers')
        vms = host_vms()
        if donor not in workers or donor.name not in vms:
            return False
        now = time.time()
        reserve = host_setting(RESERVE, 'CPU threads')
        load = max(cpu_load, os.getloadavg()[0]) + sum(w.kind == 'burst' and starting(w.name, now) for w in workers)
        current = host_room(workers, memory, need, load, reserve, vms)
        if current['ceiling'] != 0 or not storage_room(workers)[0]:
            return False
        busy = len(vms - {w.name for w in workers}) + len(workers) - sum(map(waiting, workers))
        after = host_room(workers, memory, need, load, reserve, vms, retiring=donor.name)
        return bool(burst_count(1, after) and ramp_room(1, busy))


def instance(target):
    return subprocess.run(['systemd-escape', target], check=True, capture_output=True, text=True).stdout.strip()


def registrations():
    listed = subprocess.run(['systemctl', 'list-units', 'coldbox-runner@*', '--all', '--plain', '--no-legend'],
                            capture_output=True, text=True).stdout
    found = []
    for line in listed.splitlines():
        unit, _load, active = line.split()[:3]
        escaped = unit.split('@', 1)[1].removesuffix('.service')
        target = subprocess.run(['systemd-escape', '--unescape', escaped], capture_output=True, text=True).stdout
        conf = Path(f'/etc/systemd/system/{unit}.d/coldbox.conf')
        text = conf.read_text() if conf.exists() else ''
        match = re.search(r'COLDBOX_SLOTS=(\d+)', text)
        found.append(dict(unit=unit, target=target.strip(), active=active, slots=int(match[1]) if match else 1,
                          configured=conf.exists(), allow_public='COLDBOX_ALLOW_PUBLIC=1\n' in text,
                          personal_login='COLDBOX_ALLOW_PERSONAL_LOGIN=1\n' in text))
    return found


def vm_memory():
    return size_bytes(ic('profile', 'get', 'coldbox', 'limits.memory').strip())


def vm_disk():
    return size_bytes(ic('profile', 'device', 'get', 'coldbox', 'root', 'size').strip())


def storage_room(workers):
    # Sample readiness first so the pool reading follows each completed Incus clone and start.
    committed = sum(not (STATE / 'ready' / worker.name).exists() for worker in workers)
    committed += len(unreadable_live_workers(STATE / 'workers'))
    space = query(f'/1.0/storage-pools/{POOL}/resources')['space']
    free, disk, reserve = space['total'] - space['used'], vm_disk(), space['total'] // 10
    if disk <= 0:
        raise RuntimeError('coldbox: the coldbox profile must specify a positive root disk size')
    available = free - committed * disk
    if available < disk + reserve:
        outstanding = f' after {committed} worker disk commitment(s)' if committed else ''
        return 0, (f'coldbox: storage pool {POOL} has {available / 2**30:.0f} GiB free{outstanding}, below one '
                   f'{disk / 2**30:g} GiB root disk plus a {reserve / 2**30:.0f} GiB reserve; '
                   'run coldbox reap, or reinstall with a larger COLDBOX_POOL_SIZE')
    return (available - reserve) // disk, None


def slots_text(slots):
    return f'{slots} job VM slot(s)' if slots else 'burst only: 0 slots, VMs start only for queued jobs'


def register(args):
    ci_host()
    if args.slots is None and os.environ.get('COLDBOX_SLOTS'):
        args.slots = int(os.environ['COLDBOX_SLOTS'])
    if args.slots is not None and (args.slots < 0 or args.slots == 0 and '/' not in args.target):
        raise SystemExit('coldbox: --slots must be at least 1 for an org; 0 (burst only) needs OWNER/REPO')
    with host_lock():
        return register_locked(args)


def register_locked(args):
    memory, host, reserve = vm_memory(), host_memory(), host_setting(RESERVE, 'CPU threads')
    current = registrations()
    others = sum(r['slots'] for r in current if holds_slots(r) and r['target'] != args.target)
    kept = next((r['slots'] for r in current if r['target'] == args.target and holds_slots(r)), None)
    limit = slot_limit(memory, host, reserve)
    if limit < 0:
        raise SystemExit(f'coldbox: this host cannot run one job VM: {host_cpus()} CPU threads ({reserve} reserved, '
                         f'{CORES_PER_JOB} per VM) and {host / 2**30:.0f} GiB of RAM ({host_share(host) / 2**30:g} GiB '
                         f'stays with the host, {memory / 2**30:g} GiB per VM); reinstall with a smaller COLDBOX_MEMORY '
                         'or use a larger host')
    reused = args.slots is None and kept is not None
    if reused:
        args.slots = kept
    elif args.slots is None:
        args.slots = 1 if '/' not in args.target else min(1, max(0, limit - others))
    if not reused and args.slots and others + args.slots > limit:
        raise SystemExit(f'coldbox: {others + args.slots} slot VMs of {memory / 2**30:g} GiB, counting every '
                         f'registered slot, plus one {large_memory(memory, host) / 2**30:g} GiB large VM exceed '
                         f'the ceiling of {host / 2**30:.0f} GiB of RAM ({host_share(host) / 2**30:g} GiB stays '
                         f'with the host) and {host_cpus()} CPU threads ({reserve} reserved, {CORES_PER_JOB} per VM), so a '
                         f'job no idle slot can take could wait forever. Lower --slots to at most '
                         f'{max(0, limit - others)}' + ('.' if limit == vm_bound(reserve) - 1 else
                                                        ' or reinstall with a smaller COLDBOX_MEMORY.'))
    personal = getattr(args, 'allow_personal_login', False)
    os.environ.pop('COLDBOX_ALLOW_PERSONAL_LOGIN', None)
    if personal:
        os.environ['COLDBOX_ALLOW_PERSONAL_LOGIN'] = '1'
    writers = guard(args.target, args.allow_public)
    unit = f'coldbox-runner@{instance(args.target)}.service'
    dropin = (f'[Service]\nEnvironment=COLDBOX_ALLOW_PUBLIC={int(args.allow_public)}\nEnvironment=COLDBOX_SLOTS={args.slots}\n'
              + ('Environment=' 'COLDBOX_ALLOW_PERSONAL_LOGIN=1\n' if personal else ''))
    subprocess.run(['sudo', 'mkdir', '-p', f'/etc/systemd/system/{unit}.d'], check=True)
    subprocess.run(['sudo', 'tee', f'/etc/systemd/system/{unit}.d/coldbox.conf'], input=dropin, text=True,
                   check=True, stdout=subprocess.DEVNULL)
    subprocess.run(['sudo', 'systemctl', 'daemon-reload'], check=True)
    subprocess.run(['sudo', 'systemctl', 'enable', unit], check=True)
    subprocess.run(['sudo', 'systemctl', 'restart', '--no-block', unit], check=True)
    print(f'coldbox: {unit} running {slots_text(args.slots)}. '
          f'Add runs-on: [self-hosted, coldbox] to a workflow in {args.target}; '
          'coldbox detect --workflow prints one.')
    if writers is not None:
        print(f"coldbox: {args.target} is public. Jobs triggered by {', '.join(writers) or 'nobody'} (write access) "
              'run at once; pull requests from forks never run here, so review those by hand.')
    return 0


def unregister(args):
    _, app_id, key = app_credentials(scope(args.target))
    if not (app_id and key.exists()):
        personal_login()
    unit = f'coldbox-runner@{instance(args.target)}.service'
    subprocess.run(['sudo', 'systemctl', 'disable', '--now', unit], check=False)
    subprocess.run(['sudo', 'rm', '-rf', f'/etc/systemd/system/{unit}.d'], check=True)
    subprocess.run(['sudo', 'systemctl', 'daemon-reload'], check=True)
    env = gh_env(scope(args.target))
    listed = subprocess.run(['gh', 'api', '--paginate', f'{scope(args.target)}/actions/runners?per_page=100', '--jq',
                             '.runners[] | select(.name | startswith("cbx-")) | "\\(.id) \\(.name)"'],
                            capture_output=True, text=True, env=env or dict(os.environ, GH_HOST='github.com'))
    if listed.returncode:
        raise RuntimeError('GitHub App runner listing failed' if env else f'gh api runners: {listed.stderr.strip()}')
    ids = [runner_id for runner_id, name in (line.split(' ', 1) for line in listed.stdout.splitlines())
           if re.fullmatch(r'cbx-[A-Za-z0-9-]+', name)
           and any((STATE / 'receipts' / f'{name}{kind}').exists() for kind in ('.json', '.registered'))]
    for runner_id in ids:
        gh('-X', 'DELETE', f'{scope(args.target)}/actions/runners/{runner_id}')
    print(f'coldbox: stopped {unit}; deleted {len(ids)} coldbox runner registration(s) this host started '
          f'from {args.target}')
    return 0


def reap(args):
    failed = 0
    try:
        sync_acl()
    except Exception as error:
        failed += 1
        print(f'coldbox reap: FAILED to refresh network ACL: {error}', file=sys.stderr)
    try:
        mark_host_objects()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        failed += 1
        print(f'coldbox reap: FAILED to mark Incus objects {MANAGED}=true {EXPIRES}=never: {error}', file=sys.stderr)
    with host_lock():
        live = {worker.name for worker in live_workers(STATE / 'workers')} | tearing_down()
        unreadable = unreadable_live_workers(STATE / 'workers')
        listed = json.loads(ic('list', '--format', 'json'))
        vms = [vm for vm in listed if vm['name'].startswith('cbx-')]
    if unreadable:
        print(f"coldbox reap: kept worker-less VMs: cannot read the records of live worker(s) {', '.join(unreadable)}",
              file=sys.stderr)
    for vm in vms:
        if (vm.get('config') or {}).get(WARM) or (vm.get('config') or {}).get(WARM_JOB):
            continue
        if orphan(vm, live) and not unreadable:
            gone = destroy(vm['name'])
            failed += not gone
            print(f"coldbox reap: {vm['name']} has no live worker; {'deleted' if gone else 'FAILED to delete'}")
            continue
        try:
            expires = int((vm.get('config') or {})['user.coldbox.expires'])
        except (KeyError, TypeError, ValueError):
            try:
                expires = int(vm['name'].split('-')[1]) + 86400
            except (IndexError, ValueError):
                expires = float('inf')
            if expires >= time.time():
                print(f"coldbox reap: skipped {vm['name']}: no readable user.coldbox.expires", file=sys.stderr)
                continue
        if expires < time.time():
            gone = destroy(vm['name'])
            failed += not gone
            print(f"coldbox reap: {vm['name']} {'deleted' if gone else 'FAILED to delete'}")
    if any(vm['name'] == 'base-smoke' for vm in listed):
        try:
            with open(STATE / 'build-base.lock') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                gone = destroy('base-smoke')
        except OSError as error:
            print(f'coldbox reap: skipped base-smoke: build-base lock not free: {error}', file=sys.stderr)
        else:
            failed += not gone
            print(f"coldbox reap: base-smoke left by an interrupted build-base; "
                  f"{'deleted' if gone else 'FAILED to delete'}")
    if any(not vm['name'].startswith('cbx-') and vm['name'] != 'base-smoke' for vm in listed):
        try:
            with open(STATE / 'build-base.lock') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                failed += reap_bases(json.loads(ic('list', '--format', 'json')))
        except OSError as error:
            print(f'coldbox reap: skipped bases: build-base lock not free: {error}', file=sys.stderr)
    with os.fdopen(os.open(STATE / 'reap-verification.lock', os.O_RDONLY | os.O_CREAT, 0o644)) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with host_lock():
            workers = STATE / 'workers'
            live = {worker.name for worker in live_workers(workers)} | tearing_down()
            present = host_vms()
            for marker in (STATE / 'ready').glob('cbx-*'):
                if marker.name not in live | present:
                    marker.unlink(missing_ok=True)
            candidates = [] if unreadable_live_workers(workers) else list(unreconciled(live | present, checks=True))
            reap_evidence(live | present | {receipt['id'] for _, receipt in candidates}, args.keep_days)
        for path, receipt in candidates:
            if not receipt['vm']['destroyed']:
                receipt['vm'].update(destroyed=True, destroyed_at=now_iso())
                receipt['reconciled_by'] = 'coldbox reap'
                if not receipt.get('error') and 'job_ended_at' not in receipt:
                    receipt['error'] = 'worker_interrupted'
                receipt.setdefault('verification', dict(state='pending'))
                settle(receipt)
                write_json(path, receipt, durable=True)
                print(f"coldbox reap: finalized {receipt['id']} receipt as {receipt['verdict']}: VM gone, no live worker")
            if receipt['verification']['state'] in ('pending', 'sending'):
                finish_receipt_check(path, receipt)
    try:
        if VM_WARM.exists() or any((vm.get('config') or {}).get(WARM) for vm in vms):
            failed += fill_warm()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        failed += 1
        print(f'coldbox reap: FAILED to refill warm VMs: {error}', file=sys.stderr)
    try:
        if WARM_POOL.exists() or os.environ.get('COLDBOX_WARM_POOL_SIZE') \
                or any((vm.get('config') or {}).get(WARM_JOB) for vm in vms):
            failed += fill_warm_pool()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        failed += 1
        print(f'coldbox reap: FAILED to refill warm pool: {error}', file=sys.stderr)
    return int(bool(failed))


def expired_submissions(folder, active, cutoff):
    expired = [path for path in folder.glob('cbx-*.json') if path.stem not in active
               and path.is_file() and path.stat().st_mtime < cutoff]
    if not expired:
        return expired
    try:
        queue = json.loads((folder / 'queue.json').read_text())
        if not isinstance(queue, list):
            raise ValueError('expected a list of requests')
        queued = {request['id'] for request in queue}
        if any(not isinstance(name, str) for name in queued):
            raise ValueError('expected string request IDs')
    except FileNotFoundError:
        return expired
    except (OSError, ValueError, TypeError, KeyError) as error:
        print(f'coldbox reap: kept submission records: cannot read queue.json: {error}', file=sys.stderr)
        return []
    return [path for path in expired if path.stem not in queued]


def reap_evidence(active, keep_days):
    receipts = STATE / 'receipts'
    if keep_days > 0:
        cutoff = time.time() - keep_days * 86400
        old = [path for path in receipts.glob('cbx-*') if path.name.partition('.')[0] not in active
               and path.is_file() and path.stat().st_mtime < cutoff]
        old.extend(expired_submissions(receipts / 'submissions', active, cutoff))
        for path in old:
            path.unlink(missing_ok=True)
        if old:
            print(f'coldbox reap: deleted {len(old)} receipt file(s) older than {keep_days} days')
    unmarkable = []
    for folder in receipts.glob('cbx-*.artifacts'):
        if not folder.is_dir():
            continue
        name = folder.name.removesuffix('.artifacts')
        expires = folder_expiry(folder)
        prunable = keep_days > 0 and name not in active and expires != 'never'
        orphaned = prunable and not (receipts / f'{name}.json').exists()
        expired = prunable and expires is not None and expires.isdigit() \
            and int(expires) < time.time() + (KEEP_DAYS - keep_days) * 86400
        if orphaned or expired:
            shutil.rmtree(folder)
        elif expires is None:
            try:
                mark_folder(folder, int(time.time()) + KEEP_DAYS * 86400)
            except OSError as error:
                unmarkable.append(error)
    if unmarkable:
        print(f'coldbox reap: skipped marking {len(unmarkable)} artifact folder(s) with {MANAGED} and {EXPIRES}, '
              f'so they are deleted by age only: {unmarkable[0]}', file=sys.stderr)


def rollback_pending():
