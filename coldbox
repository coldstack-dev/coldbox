        batched = background.submit(batch_repos, [r['target'] for r in repos])
        check_guest_drift(check)
        batched = batched.result()

    def repo_health(registration):
        results = []
        target = registration['target']
        repo = check_visibility(registration, lambda *result: results.append(result), batched.get(target))
        finding = merge_enforcement(target, repo) if registration['active'] == 'active' else None
        return target, results, finding

    with concurrent.futures.ThreadPoolExecutor(STATUS_LOOKUPS) as pool:
        for target, results, finding in pool.map(repo_health, repos):
            for result in results:
                check(*result)
            if finding is not None:
                show(f'  merge enforcement {target}: {finding}')
                if finding != 'ENFORCED':
                    failures.append(finding)
    try:
        version = query('/1.0')['environment']['server_version']
        check(not incus_crashes(version), f'Incus {version} has the fix for crash lxc/incus#2865 (6.0.6+)',
              f'{ZABBLY_LTS} && sudo coldbox build-base')
