def folder_expiry(folder):
    try:
        expires = os.getxattr(folder, EXPIRES).decode()
        managed = os.getxattr(folder, MANAGED) == b'true'
    except (OSError, UnicodeDecodeError):
        return None
    return expires if managed and (expires == 'never' or expires.isdigit()) else None


def xattrs_supported(path):
    try:
        os.getxattr(path, MANAGED)
    except OSError as error:
        return error.errno != errno.ENOTSUP
    return True


def mark_folder(folder, expires):
