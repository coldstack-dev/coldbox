def requires_app_check(checks, id_field, app_id):
    if not isinstance(checks, list):
        raise ValueError('invalid required checks')
    found = False
    for check in checks:
        context, source = check['context'], check.get(id_field)
        if not isinstance(context, str) or (source is not None and type(source) is not int):
            raise ValueError('invalid required check')
        found |= context == VERIFY_CHECK and source == app_id
    return found


def branch_requires_verify(read, path, branch, app_id):
    page = 1
    while True:
        rules = read(f'{path}/rules/branches/{branch}?per_page=100&page={page}')
        if not isinstance(rules, list):
            raise ValueError('invalid branch rules')
        checks = [requires_app_check(rule['parameters']['required_status_checks'], 'integration_id', app_id)
                  for rule in rules if rule['type'] == 'required_status_checks']
        if any(checks):
            return True
        if len(rules) < 100:
            break
        page += 1
    try:
        classic = read(f'{path}/branches/{branch}/protection/required_status_checks')
    except urllib.error.HTTPError as error:
        if error.code == 404 and json.load(error).get('message') in (
                'Branch not protected', 'Required status checks not enabled'):
            return False
        raise
    return requires_app_check(classic.get('checks', []), 'app_id', app_id)


def workflow_requires_tests(file):
    import yaml

    if file['type'] != 'file' or file['encoding'] != 'base64':
        raise ValueError('unsupported workflow contents')
    text = base64.b64decode(''.join(file['content'].splitlines()), validate=True)
    try:
        workflow = yaml.load(text, Loader=yaml.BaseLoader)
    except (yaml.YAMLError, RecursionError):
        raise ValueError('invalid workflow YAML') from None
    if not isinstance(workflow, dict):
        raise ValueError('invalid workflow YAML')
    events = workflow.get('on')
    if events != 'pull_request' and not (
            isinstance(events, (list, dict)) and 'pull_request' in events):
        return False
    jobs = workflow['jobs']
    verify = [job for name, job in jobs.items() if job.get('name', name) == 'verify']
    if len(verify) != 1:
        return False
    job = verify[0]
    if job.get('if') not in (None, VERIFY_PR_GUARD, '${{ ' + VERIFY_PR_GUARD + ' }}'):
        return False
    labels = job.get('runs-on')
    if isinstance(labels, dict):
        labels = labels.get('labels')
    if labels != 'coldbox' and not (isinstance(labels, list) and 'coldbox' in labels):
        return False
    if job.get('continue-on-error', 'false') != 'false' or 'strategy' in job:
        return False
    shell = ((job.get('defaults') or {}).get('run') or {}).get('shell',
            ((workflow.get('defaults') or {}).get('run') or {}).get('shell'))
    return any(isinstance(step.get('run'), str) and step['run'].strip() == 'coldbox require-tests'
               and step.get('if') in (None, 'success()', '${{ success() }}')
               and step.get('continue-on-error', 'false') == 'false'
               and step.get('shell', shell) in (None, 'bash', 'sh')
               for step in job['steps'])


def merge_enforcement(target, repo):
    path = scope(target)
    try:
        token, app_id = app_token(path), app_credentials(path)[1]
        if not token or not app_id:
            return 'UNVERIFIED; no GitHub App installation token or App ID'
        app_id = int(app_id)
    except (OSError, RuntimeError, ValueError) as error:
        return f'UNVERIFIED; GitHub App authentication: {error}'
    branch = (repo or {}).get('default_branch')
    if not isinstance(branch, str) or not branch or any(c.isspace() for c in branch):
        return 'UNVERIFIED; default branch metadata unavailable (GitHub App Metadata: read)'
    ref = urllib.parse.quote(branch, safe='')
    input_name = ''

    def read(endpoint):
        nonlocal input_name
        resource = endpoint.removeprefix(path + '/')
        if resource.startswith('rules/branches/'):
            input_name = 'branch rules (Metadata: read)'
        elif resource.startswith('branches/'):
            input_name = 'classic branch protection (Administration: read)'
        else:
            input_name = f'{VERIFY_WORKFLOW} (Contents: read)'
        return app_request(endpoint, token)

    gaps, unreadable = [], []
    try:
        if not branch_requires_verify(read, path, ref, app_id):
            gaps.append(f'{branch} does not require the Coldbox App check {VERIFY_CHECK!r}')
    except urllib.error.HTTPError as error:
        unreadable.append(f'{input_name}: HTTP {error.code}')
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        unreadable.append(f'{input_name}: unreadable response')
    try:
        if not workflow_requires_tests(read(f'{path}/contents/{VERIFY_WORKFLOW}?ref={ref}')):
            gaps.append(f'{VERIFY_WORKFLOW} lacks an unconditional coldbox require-tests step in verify')
    except urllib.error.HTTPError as error:
        detail = ' (workflow missing or inaccessible)' if error.code == 404 else ''
        unreadable.append(f'{input_name}: HTTP {error.code}{detail}')
    except ImportError:
        unreadable.append(f'{input_name}: PyYAML unavailable')
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        unreadable.append(f'{input_name}: unreadable response')
    return '; '.join([*(['UNVERIFIED', *unreadable] if unreadable else []),
                     *(['GAP', *gaps] if gaps else [])]) or 'ENFORCED'


GUEST_DIGEST = '''set -euo pipefail
export LC_ALL=C
cd "$1"
entries=$(find . -mindepth 1 -maxdepth 1 -printf '%P\\n' | sort)
while IFS= read -r e; do
    [ -n "$e" ] || continue
    d=$({ find "$e" -printf '%y %m %p %l\\n' | sort; find "$e" -type f -print0 | sort -z | xargs -0r sha256sum; } |
        sha256sum | cut -c1-16)
    printf '%s %s\\n' "$d" "$e"
done <<< "$entries"'''


def guest_digests(host):
    command = ['bash', '-c', GUEST_DIGEST, 'bash', str(GUEST_FILES / 'opt')]
    if host != os.uname().nodename:
        command = ssh(host, command)
        if os.geteuid() == 0 and os.environ.get('SUDO_USER'):
            command = ['runuser', '-u', os.environ['SUDO_USER'], '--', *command]
    result = subprocess.run(command, capture_output=True, text=True, timeout=60, check=True)
    return {name: digest for digest, name in (line.split(' ', 1) for line in result.stdout.splitlines())}


def check_guest_drift(check):
    try:
        host, policy = admitted_fleet()
    except RuntimeError as error:
        check(False, f'guest overlay drift unchecked: {error}', f'fix {CI_HOSTS}')
        return
    peers = [peer for peer in [policy[0], *policy[1]] if peer != host] if policy else []
    if not peers:
        return

    def digests(name):
        try:
            return guest_digests(name)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            return error

    with concurrent.futures.ThreadPoolExecutor(STATUS_LOOKUPS) as pool:
        mine, *others = pool.map(digests, [host, *peers])
    drift = []
    if isinstance(mine, Exception):
        mine, drift = {}, [f'{host}: unreadable ({mine})']
    for peer, theirs in zip(peers, others):
        if isinstance(theirs, Exception):
            drift.append(f'{peer}: unreadable')
            continue
        drift += [f'{peer}: opt/{name}' for name in sorted(mine.keys() | theirs.keys()) if mine.get(name) != theirs.get(name)]
    check(not drift, f"guest overlay {GUEST_FILES / 'opt'} matches {' '.join(peers)}"
          f"{': differs on ' if drift else ''}{', '.join(drift)}",
          'run sudo systemctl start coldverify-guest-refresh.service on every CI host so all copy the same commits')


def host_status(host):
    local = host == os.uname().nodename
    run = lambda command: subprocess.run(command if local else ssh(host, command),
                                         capture_output=True, text=True, timeout=300)
    row = dict(host=host, build='-', verdict='INCOMPLETE', orphans='-', last_receipt='-', jobs_24h='-',
               supervisors=[], health=[])
    try:
        result = run(['coldbox', 'status'])
    except subprocess.TimeoutExpired:
        row['health'].append('UNREADABLE; status timed out; check host and SSH connectivity')
        return row
    except (OSError, subprocess.SubprocessError):
        row['health'].append('UNREADABLE; could not run coldbox status')
        return row
    if result.returncode == 255 and not local:
        row['health'].append('UNREACHABLE; check host and SSH connectivity')
        return row
    build = re.match(r'coldbox \S+ \(build ([0-9a-f]{12})\)\n', result.stdout)
    if result.returncode not in (0, 1) or not build:
        row['health'].append('UNREADABLE; run coldbox status on the host')
        return row
    orphans = re.search(r'^(?:PASS|FAIL)  (\d+) job VM\(s\) without a live worker', result.stdout, re.M)
    receipts = result.stdout.partition('\nRecent receipts\n')[2]
    last = re.search(r'\d{4}-\d\d-\d\dT[^\s;]+', receipts.splitlines()[0] if receipts else '')
    row.update(build=build[1], verdict='FAIL' if result.returncode else 'PASS',
               orphans=orphans[1] if orphans else '-', last_receipt=last[0] if last else '-')
    row['supervisors'] = re.findall(
        rf'^  (supervisor {TARGET.pattern}: build (?:unknown|[0-9a-f]{{12}} \((?:current|stale)\)))$',
        result.stdout, re.M)
    if any(not supervisor.endswith(' (current)') for supervisor in row['supervisors']):
        row['health'].append('check stale or unknown supervisor builds and schedule an idle restart')
    queues = dict(re.findall(rf'^  queue health ({TARGET.pattern}): ([^\n]+)$', result.stdout, re.M))
    row['health'].extend(f'queue health {target}: {health}' for target, health in queues.items()
                         if not health.startswith('FRESH; '))
    active = re.findall(rf'^  ({TARGET.pattern}) +active +', result.stdout, re.M)
    row['health'].extend(f'queue health {target}: UNREADABLE; upgrade Coldbox to read queue health'
                         for target in active if '/' in target and target not in queues)
    enforcement = dict(re.findall(rf'^  merge enforcement ({TARGET.pattern}): ([^\n]+)$', result.stdout, re.M))
    row['health'].extend(f'merge enforcement {target}: {finding}' for target, finding in enforcement.items()
                         if finding != 'ENFORCED')
    row['health'].extend(f'merge enforcement {target}: UNVERIFIED; upgrade Coldbox to audit merge enforcement'
                         for target in active if '/' in target and target not in enforcement)
    if row['health']:
        row['verdict'] = 'FAIL'
    try:
        collected = run(['coldbox', 'stats', '--json', '--since', '24h'])
        if collected.returncode not in (0, 1, 2):
            raise ValueError(f'stats exited {collected.returncode}')
        stats = json.loads(collected.stdout)
        if collected.returncode and stats.get('schema_version') != 1:
            raise ValueError('unversioned stats error')
        unreadable = stats.get('unreadable_receipts')
        row['jobs_24h'] = f"{stats['jobs']}{f' ({unreadable} unreadable)' if unreadable else ''}"
        if collected.returncode == 1:
            row['verdict'] = 'FAIL'
            row['health'].append(f"stats: {stats['orphans']} receipt-based orphan(s); run coldbox status")
        elif collected.returncode == 2:
            raise ValueError('incomplete stats')
    except (OSError, ValueError, KeyError, TypeError, AttributeError, subprocess.SubprocessError):
        row['health'].append('UNREADABLE; run coldbox stats --json --since 24h on the host')
        if row['verdict'] == 'PASS':
            row['verdict'] = 'INCOMPLETE'
    return row


def fleet_status(hosts, as_json=False):
    with concurrent.futures.ThreadPoolExecutor(len(hosts)) as pool:
        rows = list(pool.map(host_status, hosts))
    primary = rows[0]
    for row in rows[1:]:
        if '-' not in (primary['build'], row['build']) and row['build'] != primary['build']:
            row['verdict'] = 'FAIL'
            row['health'].append(f"BUILD DRIFT; installed {row['build']}; primary {primary['host']} has "
                                 f"{primary['build']}; check the intended rollout build")
    if as_json:
        verdicts = {row['verdict'] for row in rows}
        code = 1 if 'FAIL' in verdicts else 2 if 'INCOMPLETE' in verdicts else 0
        print(json.dumps(dict(schema_version=1, verdict=('PASS', 'FAIL', 'INCOMPLETE')[code], hosts=rows)))
        return code
    keys = ('host', 'build', 'verdict', 'orphans', 'last_receipt', 'jobs_24h')
    table = [['HOST', 'BUILD', 'VERDICT', 'ORPHANS', 'LAST RECEIPT', 'JOBS 24H']] + [[row[k] for k in keys] for row in rows]
    widths = [max(len(line[i]) for line in table) for i in range(len(keys))]
    for line in table:
        print(' '.join(value.ljust(width) for value, width in zip(line, widths)).rstrip())
    for row in rows:
        for supervisor in row['supervisors']:
            print(f"  {row['host']}: {supervisor}")
        for finding in row['health']:
            print(f"  {row['host']}: {finding}")
    return 0 if all(row['verdict'] == 'PASS' for row in rows) else 1


def read_queue_health(path):
    try:
        queue = json.loads(path.read_text())
        observed = datetime.fromisoformat(queue['observed_at'])
        now = datetime.now(timezone.utc)
        if observed.tzinfo is None or observed > now or type(queue['stalled']) is not bool or any(
                type(queue[key]) is not int or queue[key] < 0 for key in ('queued', 'oldest_wait_seconds')):
            raise ValueError('invalid queue observation')
    except FileNotFoundError:
        return 'MISSING', None
    except (OSError, ValueError, KeyError, TypeError, OverflowError):
        return 'UNREADABLE', None
    if (now - observed).total_seconds() > QUEUE_FRESH_SECONDS:
        return 'STALE', queue
    return ('STALLED' if queue['stalled'] else 'FRESH'), queue


def pool_report(listed=None):
    """The warm pool as coldbox pool status and coldbox status show it: what is configured, what a job could claim
    now, what is on its way in or out, what should already be gone, and the event counts. It changes nothing."""
    now = time.time()
    checks = []
    try:
        configured = warm_pool_size()
    except (OSError, ValueError) as error:
        configured = None
        checks.append(dict(ok=False, message=str(error),
                           fix=f'write a whole number or warm_pool_size = N to {WARM_POOL}, or delete it'))
    if listed is None:
        listed = json.loads(ic('list', '--format', 'json'))
    pool = [vm for vm in listed if vm['name'].startswith('cbx-') and (vm.get('config') or {}).get(WARM_JOB)]
    stamp = base = None
    if configured or pool:
        try:
            snapshot = query(f"/1.0/instances/{BASE.replace('/', '/snapshots/', 1)}?project={PROJECT}")
            base = dict(snapshot=BASE, created_at=snapshot['created_at'],
                        image=(snapshot.get('config') or {}).get('volatile.base_image'))
            stamp = warm_job_stamp(offline=False)
            checks.append(dict(ok=True, message=f"warm pool stamp {stamp} for {BASE} created {base['created_at']}"))
        except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
            checks.append(dict(ok=False, message=f'warm pool stamp unreadable, so no standby VM can be claimed: {error}',
                               fix='coldbox status'))
    standbys = dict.fromkeys(('ready', 'booting', 'claimed', 'stale', 'retired'), 0)
    overdue, born = [], []
    for vm in pool:
        value, expires = vm['config'][WARM_JOB], vm['config'].get(EXPIRES, '')
        standbys['ready' if claimable(vm, stamp, now) else value if value in ('booting', 'retired') else
                 'claimed' if value.startswith('claimed') else 'stale'] += 1
        if not expires.isdigit() or int(expires) <= now:
            overdue.append(vm['name'])
        with contextlib.suppress(IndexError, ValueError):
            born.append(int(vm['name'].split('-')[1]))
    if configured or pool:
        checks.append(dict(ok=not overdue, message=f"{len(overdue)} warm pool VM(s) past their expiry"
                           f"{': ' if overdue else ''}{' '.join(overdue)}", **({'fix': 'coldbox reap'} if overdue else {})))
    live, waits, abandoned = tearing_down(prune=False), [], 0
    for record in (STATE / 'teardown').glob('cbx-*'):
        if record.name not in live:
            abandoned += 1
            continue
        with contextlib.suppress(OSError):
            waits.append(now - record.stat().st_mtime)
    seen = pool_counters()
    return dict(configured=configured, ready=standbys['ready'], standbys=standbys, overdue=overdue, stamp=stamp,
                base=base, oldest_standby_seconds=round(now - min(born)) if born else None,
                teardown=dict(pending=len(live), abandoned=abandoned,
                              oldest_seconds=round(max(waits)) if waits else None),
                metrics=dict(since=seen['since'], hits=seen['counts'].get('hit', 0), misses=seen['counts'].get('miss', 0),
                             reaped=seen['reaped'], refill_failures=seen['counts'].get('refill_failed', 0),
                             last=seen['last']),
                checks=checks)


def pool_lines(report):
    standbys, teardown, metrics = report['standbys'], report['teardown'], report['metrics']
    if report['configured'] == 0 and not any(standbys.values()):
        lines = [f'coldbox pool: off; write a number of VMs to {WARM_POOL} to keep that many standby VMs']
    else:
        size = 'an unreadable number' if report['configured'] is None else report['configured']
        lines = [f"coldbox pool: {report['ready']} of {size} standby VM(s) ready ({WARM_POOL})"]
    for check in report['checks']:
        lines.append(f"{'PASS' if check['ok'] else 'FAIL'}  {check['message']}")
        if not check['ok']:
            lines.append(f"      fix: {check['fix']}")
    age = report['oldest_standby_seconds']
    lines.append('  standby VMs: ' + ', '.join(f'{count} {state}' for state, count in standbys.items())
                 + (f'; oldest {age / 60:.0f} min' if age is not None else ''))
    if report['base']:
        lines.append(f"  base image: {report['base']['image'] or 'unknown'}")
    wait = teardown['oldest_seconds']
    lines.append(f"  teardowns: {teardown['pending']} pending" + (f', oldest {wait} s' if wait is not None else '')
                 + f"; {teardown['abandoned']} left by a dead worker for coldbox reap")
    if metrics['since'] is None:
        lines.append('  events: none recorded')
    else:
        reaped = ', '.join(f'{count} {reason}' for reason, count in sorted(metrics['reaped'].items()))
        lines.append(f"  events since {metrics['since']}: {metrics['hits']} hit(s), {metrics['misses']} miss(es), "
                     f"{sum(metrics['reaped'].values())} reaped{f' ({reaped})' if reaped else ''}, "
                     f"{metrics['refill_failures']} failed refill(s)")
        for event, entry in sorted(metrics['last'].items()):
            detail = ' '.join(str(value) for key, value in entry.items() if key != 'at')
            lines.append(f"  last {event.replace('_', ' ')}: {entry.get('at')} {detail}")
    return lines


def pool_cmd(args):
    report = pool_report()
    failed = any(not check['ok'] for check in report['checks'])
    if args.json:
        print(json.dumps(dict(schema_version=1, verdict='FAIL' if failed else 'PASS', **report)))
    else:
        print('\n'.join(pool_lines(report)))
    return int(failed)


def status(args):
    monitor = bool(args and args.hosts)
    as_json = getattr(args, 'json', False)
    policy = fleet() if monitor else None
    if policy:
        return fleet_status([policy[0], *policy[1]], as_json)
    checks, details = [], []
    show = details.append if as_json else print
