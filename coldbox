OVERLAY_DIRS_RECORD = 'var/lib/coldbox/overlay-dirs'


def guest_overlay_dirs():
    if os.path.lexists(GUEST_FILES / OVERLAY_DIRS_RECORD):
        raise ValueError(f'guest files may not contain {OVERLAY_DIRS_RECORD}; Coldbox keeps its own record there')
    found = []
    for top, names, _ in os.walk(GUEST_FILES):
        for directory in names:
            path = Path(top, directory)
            relative = str(path.relative_to(GUEST_FILES))
            if '\n' in relative:
                raise ValueError(f'guest file directory name contains a newline: {relative!r}')
            if not path.is_symlink():
                found.append(f'0{path.lstat().st_mode & 0o7777:04o} '.encode() + os.fsencode(relative) + b'\n')
    return b''.join(found)


def pack_guest_files():
    command = ['tar', '-C', str(GUEST_FILES), '--owner=0', '--group=0', '--numeric-owner', '-c', '.']
    for last in (False, True):
        dirs = guest_overlay_dirs()
        pack = subprocess.run(command, capture_output=True)
        sys.stderr.write(pack.stderr.decode(errors='replace'))
        if not pack.returncode and guest_overlay_dirs() == dirs:
            return dirs, pack.stdout
        lines = pack.stderr.splitlines()
        swapped = not pack.returncode or (
            pack.returncode == 1 and lines and all(line.endswith(b': file changed as we read it') for line in lines))
        if not swapped or last:
            break
    if pack.returncode:
        raise subprocess.CalledProcessError(pack.returncode, command, stderr=pack.stderr)
    raise RuntimeError(f'{GUEST_FILES} changed while it was packed, twice')


OVERLAY_STAMP = 'user.coldbox.guest-files'
OVERLAY_STAT = r'''import hashlib, os, stat, sys
os.chdir(sys.argv[1])
if not stat.S_ISREG(os.lstat(sys.argv[2]).st_mode):
    sys.exit(1)
digest = hashlib.sha256()
for path in sys.stdin.buffer.read().split(b'\0'):
    entry = os.lstat(path)
    identity = (entry.st_dev, entry.st_ino, entry.st_mode, entry.st_uid, entry.st_gid)
    if not stat.S_ISDIR(entry.st_mode):
        identity += (entry.st_size, entry.st_mtime_ns, entry.st_ctime_ns)
    digest.update(repr(identity).encode())
print(digest.hexdigest())
'''


def guest_files_paths():
    root = os.fsencode(GUEST_FILES)
    paths = [b'.']
    for top, names, files in os.walk(root):
        names.sort()
        paths += [os.path.join(top, entry)[len(root) + 1:] for entry in sorted(names + files)]
    return paths


def overlay_state(name, link):
    paths = [*guest_files_paths(), os.fsencode(OVERLAY_DIRS_RECORD), *([os.fsencode(link)] if link else [])]
    result = subprocess.run(ic_exec(name, '/usr/bin/python3', '-I', '-B', '-S', '-c', OVERLAY_STAT, '/',
                                     OVERLAY_DIRS_RECORD, user=None), input=b'\0'.join(paths), capture_output=True)
    if not result.returncode and re.fullmatch(rb'[0-9a-f]{64}\n', result.stdout):
        return result.stdout.decode().strip()


def push_guest_files(name, *, mode='image', strict_stamp=False):
    if not GUEST_FILES.is_dir():
        if strict_stamp:
            try:
                stamp = query(f'/1.0/instances/{name}?project={PROJECT}', timeout=10)['config'].get(OVERLAY_STAMP)
            except UNREADABLE as error:
                raise WarmOverlayMismatch(f'could not verify warm VM overlay stamp: {error}') from error
            if stamp:
                raise WarmOverlayMismatch('guest overlay was removed after warm VM preparation')
        return
    dirs, archive = pack_guest_files()
    tool, link = 'opt/coldverify/coldverify', 'usr/local/bin/coldverify'
    make_link = os.path.lexists(GUEST_FILES / tool) and not os.path.lexists(GUEST_FILES / link)
    if mode != 'image':
        source = hashlib.sha256(dirs + hashlib.sha256(archive).digest() + bytes([make_link])).hexdigest()
    if mode not in ('image', 'build-base'):
        try:
            stamp = query(f'/1.0/instances/{name}?project={PROJECT}', timeout=10)['config'][OVERLAY_STAMP]
        except UNREADABLE:
            stamp = ''
        if isinstance(stamp, str) and stamp.startswith(source + ':'):
            guest = overlay_state(name, link if make_link else None)
            if guest and stamp == f'{source}:{guest}':
                return
        if strict_stamp:
            raise WarmOverlayMismatch('guest overlay changed after warm VM preparation')
    if mode in ('runner', 'vm', 'warm-pool'):
        handler = ('/usr/bin/python3', '-I', '-B', '-S', '-c', MANAGED_OVERLAY_DIRS)
    else:
        handler = ('sh', '-c', GUEST_OVERLAY_DIRS, 'sh')
    subprocess.run(ic_exec(name, *handler, '/', OVERLAY_DIRS_RECORD, user=None), input=dirs, check=True)
    subprocess.run(ic_exec(name, 'tar', '-C', '/', '-x', '--no-overwrite-dir', '--keep-directory-symlink',
                           user=None), input=archive, check=True)
    if make_link:
        subprocess.run(ic_exec(name, 'ln', '-sf', f'/{tool}', f'/{link}', user=None), check=True)
    if mode in ('build-base', 'warm-pool') and (guest := overlay_state(name, link if make_link else None)):
        ic('config', 'set', name, f'{OVERLAY_STAMP}={source}:{guest}')


