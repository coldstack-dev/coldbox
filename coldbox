def write_json(path, data, *, durable=False):
    path = Path(path)
    tmp = path.with_suffix('.tmp')
    with tmp.open('w') as out:
        out.write(json.dumps(data, indent=2) + '\n')
        if durable:
            out.flush()
            os.fsync(out.fileno())
    tmp.replace(path)
    if durable:
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)


def state_folder(name):
    """A folder under STATE that STATE's owner can write, also when root's reap is the first to need it."""
    folder = STATE / name
    if not folder.is_dir():
        folder.mkdir(parents=True, exist_ok=True)
        if os.geteuid() == 0:
            owner = STATE.stat()
            os.chown(folder, owner.st_uid, owner.st_gid)
    return folder


def mark_ready(name):
    """Record that this VM is ready, replacing a marker another user made: root's reap marks a standby that the
    runner user later claims."""
    marker = state_folder('ready') / name
    marker.unlink(missing_ok=True)
    marker.touch()


def size_bytes(text):
    match = re.fullmatch(r'\s*(\d+(?:\.\d+)?)\s*([KMGT]i?B|B)?\s*', text)
    if not match:
        raise ValueError(f'cannot read size {text!r}')
    return int(float(match[1]) * UNITS[match[2] or ''])


def host_memory(field='MemTotal'):
    for line in Path('/proc/meminfo').read_text().splitlines():
        if line.startswith(f'{field}:'):
            arc = min(reclaimable_arc(), memory_floor(host_memory())) if field == 'MemAvailable' else 0
            return int(line.split()[1]) * 1024 + arc
    raise RuntimeError(f'{field} missing from /proc/meminfo')


def reclaimable_arc():
    """Clean ZFS ARC buffers above c_min, which ZFS evicts under memory pressure but MemAvailable does not count
    (OpenZFS arc_evictable_memory). A page-cache ARC minimum (zfs_arc_pc_percent) raises c_min, so none counts then."""
    try:
        if Path('/sys/module/zfs/parameters/zfs_arc_pc_percent').read_text().strip() != '0':
            return 0
        stats = dict(line.split()[::2] for line in Path('/proc/spl/kstat/zfs/arcstats').read_text().splitlines()[2:])
        clean = sum(int(stats[f'{state}_evictable_{kind}']) for state in ('mru', 'mfu') for kind in ('data', 'metadata'))
        return max(0, min(clean, int(stats['size']) - int(stats['c_min'])))
    except (OSError, KeyError, ValueError):
        return 0


def memory_floor(total):
    return max(HOST_RESERVE, total // 8)


def host_share(host):
    return memory_floor(host) + HOST_IDLE


def fits(slots, vm_memory, host):
    return slots * vm_memory <= host - host_share(host)


def large_memory(memory, host):
    return max(memory, min(2 * memory, host - host_share(host)))


def slot_limit(memory, host, reserve):
    return min(vm_bound(reserve) - 1, (host - host_share(host) - large_memory(memory, host)) // memory)


def host_cpus():
    return os.sysconf('SC_NPROCESSORS_ONLN')


def vm_bound(reserve):
    return (host_cpus() - reserve) // CORES_PER_JOB


def runner_release(release):
    version = release['tag_name'].removeprefix('v')
    name = f'actions-runner-linux-x64-{version}.tar.gz'
    asset = next((a for a in release.get('assets', []) if a['name'] == name), None)
    if not asset:
        raise RuntimeError(f'actions/runner {version} has no {name}')
    digest = (asset.get('digest') or '').removeprefix('sha256:')
    if not digest:
        match = re.search(r'BEGIN SHA linux-x64 -->\s*([0-9a-f]{64})', release.get('body') or '')
        digest = match[1] if match else ''
    if not re.fullmatch(r'[0-9a-f]{64}', digest):
        raise RuntimeError(f'actions/runner {version}: no sha256 for {name}')
    return version, asset['browser_download_url'], digest


def has_ts_references(path):
    quoted_string = r'"(?:\\.|[^"\\])*"'
    try:
        config = path.read_text(encoding='utf-8-sig')
        config = re.sub(rf'({quoted_string})|//[^\r\n]*|/\*[\s\S]*?\*/',
                        lambda match: match[1] or ' ', config)
        config = re.sub(rf'({quoted_string})' + r'|,(?=\s*[\]}])',
                        lambda match: match[1] or '', config)
        config = json.loads(config)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return False
    references = config.get('references') if isinstance(config, dict) else None
    return isinstance(references, list) and bool(references)


def may_have_pytest_tests(path):
    try:
        module = ast.parse(path.read_bytes(), filename=str(path))
    except (OSError, SyntaxError, ValueError):
        return True
    if any(isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Call) for stmt in module.body):
        return True
    for node in ast.walk(module):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name.startswith('test'):
            return True
        if isinstance(node, ast.ClassDef) and node.bases:
            return True
        if isinstance(node, ast.ImportFrom) and any(
            alias.name == '*' or (alias.asname or alias.name).startswith(('test', 'Test')) for alias in node.names
        ):
            return True
    return False


def npm_test_is_noop(script):
    if not isinstance(script, str) or not script.strip():
        return True
    script = script.strip()
    if any(char in script for char in ('\n', '\r', '`', '$')):
        return False
    try:
        lexer = shlex.shlex(script, punctuation_chars=True)
        lexer.commenters = ''
        words = list(lexer)
    except ValueError:
        return False
    if words[0] == 'echo' and words[-3:-1] in (['&&', 'exit'], [';', 'exit']) and words[-1] in ('0', '1'):
        words = words[:-3]
    return words[0] in ('echo', 'printf', 'true', ':', 'exit') and not any(
        word and all(char in lexer.punctuation_chars for char in word) for word in words[1:]
    )


def detect(root):
    root = Path(root)

    def has(*names):
        return any((root / name).exists() for name in names)

    def files(pattern):
        return [p for p in root.rglob(pattern)
                if not any(part.startswith('.') or part in SKIP_DIRS for part in p.relative_to(root).parts)]

    found = {}

    def add(check, command):
        found.setdefault(check, []).append(command)

    if has('pyproject.toml', 'setup.py', 'setup.cfg', 'requirements.txt', 'ruff.toml', '.ruff.toml', 'mypy.ini',
           '.mypy.ini') or files('*.py'):
        requirements = has('requirements.txt')
        if requirements:
            add('setup', PY_REQUIREMENTS_SETUP)
        add('lint', "python3 -m compileall -q -x '/[.]|node_modules' .")
        try:
            pyproject = tomllib.loads((root / 'pyproject.toml').read_text())
        except (OSError, tomllib.TOMLDecodeError):
            pyproject = {}
        tool = pyproject.get('tool') if isinstance(pyproject.get('tool'), dict) else {}
        if isinstance(tool.get('ruff'), dict) or has('ruff.toml', '.ruff.toml'):
            add('lint', PY_VENV + 'pip install -q ruff && ruff check .')
        mypy = tool.get('mypy') if isinstance(tool.get('mypy'), dict) else None
        ini_file = next((root / name for name in ('mypy.ini', '.mypy.ini') if has(name)), None)
        if ini_file:
            ini = configparser.ConfigParser(interpolation=None)
            try:
                ini.read(ini_file)
            except (configparser.Error, UnicodeDecodeError):
                pass
            listed = ini.get('mypy', 'files', fallback=None)
        else:
            listed = mypy and mypy.get('files')
        if mypy is not None or ini_file:
            install = 'mypy' + (' .' if 'project' in pyproject else '') + (' -r requirements.txt' if requirements else '')
            add('lint', PY_VENV + f"pip install -q {install} && mypy{'' if listed else ' .'}")
        if any(path.is_file() and may_have_pytest_tests(path) for path in files('test_*.py') + files('*_test.py')):
            add('test', 'python3 -m pytest -q')
    if has('package.json'):
        package = json.loads((root / 'package.json').read_text())
        scripts = package.get('scripts', {})
        deps = package.get('dependencies', {}) | package.get('devDependencies', {})

        def configured(tool, *patterns):
            return tool in deps or tool in package or any(next(root.glob(p), None) for p in patterns)

        pinned = package.get('packageManager')
        pinned = pinned.split('+')[0] if isinstance(pinned, str) else ''
        lock = 'pnpm' if has('pnpm-lock.yaml') else 'yarn' if has('yarn.lock') else None
        version = pinned.removeprefix(f'{lock}@') if lock and re.fullmatch(rf'{lock}@[0-9][0-9A-Za-z.-]*', pinned) else ''
        berry = lock == 'yarn' and version and version.split('.')[0] != '1' and not has('package-lock.json')
        run = f'npx --yes -p @yarnpkg/cli-dist@{version} yarn' if berry else 'npx --yes'
        if has('package-lock.json'):
            add('setup', 'npm ci')
        elif lock:
            if berry:
                add('setup', f'{run} install --immutable')
            else:
                add('setup', f"npx --yes {lock}{'@' + version if version else ''} install --frozen-lockfile")
        else:
            add('setup', 'npm install')
        if 'lint' in scripts:
            add('lint', 'npm run lint')
        elif configured('eslint', 'eslint.config.*', '.eslintrc*') or 'eslintConfig' in package:
            add('lint', f'{run} eslint .')
        if has('tsconfig.json'):
            tsc = f'{run} tsc' if berry else 'npx --yes -p typescript tsc'
            mode = '--build' if has_ts_references(root / 'tsconfig.json') else '--noEmit'
            add('lint', f'{tsc} {mode}')
        if 'test' in scripts and any(not npm_test_is_noop(scripts.get(name)) for name in ('pretest', 'test', 'posttest')):
            add('test', 'npm test')
        elif configured('vitest', 'vitest.config.*'):
            add('test', f'{run} vitest run')
        elif configured('jest', 'jest.config.*'):
            add('test', f'{run} jest')
    if has('go.mod'):
        add('lint', 'test -z "$(gofmt -l .)" && go vet ./...')
        if files('*_test.go'):
            add('test', GO_TEST)
    if has('Cargo.toml'):
        add('lint', 'cargo fmt --check && cargo clippy --all-targets -- -D warnings')
        if any(RUST_TEST.search(p.read_text(errors='replace')) for p in files('*.rs')):
            add('test', CARGO_TEST)
    if files('*.sh'):
        add('lint', "find . -name '*.sh' -not -path '*/.*' -not -path '*/node_modules/*' -print0 | xargs -0 shellcheck")
    return found


def load_config(path, label='coldbox.toml'):
    if not path.exists():
        return {}, {}, None, {}
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ConfigError(f'{label}: {error}')
    unknown = set(data) - {'checks', 'commands', 'vm', 'profiles'}
    if unknown:
        raise ConfigError(f'{label}: unknown section {sorted(unknown)[0]!r}; use [checks], [commands], [vm] and [profiles]')
    vm = data.get('vm', {})
    if not isinstance(vm, dict) or set(vm) - {'size'} or 'vm' in data and vm.get('size') not in SIZES:
        raise ConfigError(f'{label}: [vm] holds only size = {" | ".join(map(repr, SIZES))}')
    switches, commands = data.get('checks', {}), data.get('commands', {})
    for section, table, kind in (('checks', switches, bool), ('commands', commands, str)):
        if not isinstance(table, dict):
            raise ConfigError(f'{label}: [{section}] must be a table')
        for name, value in table.items():
            if not NAME.fullmatch(name):
                raise ConfigError(f'{label}: bad check name {name!r} in [{section}]')
            if type(value) is not kind or (kind is str and not value.strip()):
                raise ConfigError(f'{label}: [{section}] {name} must be {"true or false" if kind is bool else "a command string"}')
    profiles = data.get('profiles', {})
    if not isinstance(profiles, dict):
        raise ConfigError(f'{label}: [profiles] must be a table')
    for name, checks in profiles.items():
        if not NAME.fullmatch(name):
            raise ConfigError(f'{label}: bad profile name {name!r} in [profiles]')
        if (not isinstance(checks, list) or not checks or
                not all(isinstance(check, str) and NAME.fullmatch(check) for check in checks)
                or len(set(checks)) != len(checks)):
            raise ConfigError(f'{label}: [profiles] {name} must list distinct check names')
    return switches, commands, vm.get('size'), profiles


def host_switches():
    switches, commands, size, profiles = load_config(HOST_CHECKS, str(HOST_CHECKS))
    if commands or size or profiles:
        raise ConfigError(f'{HOST_CHECKS}: only [checks] belongs here; put other sections in the repo coldbox.toml')
    return switches


class ProfileRefusal(ConfigError):
    def __init__(self, cause, message):
        super().__init__(message)
        self.cause = cause


def plan(root, label='coldbox.toml', profile=None):
    host = host_switches()
    switches, overrides, _, profiles = load_config(Path(root) / 'coldbox.toml', label)
    if profile is not None and profile not in profiles:
        raise ProfileRefusal('unknown_profile', f'{label}: profile {profile!r} is not declared')
    found = detect(root)
    found.update({name: [command] for name, command in overrides.items()})
    missing = [name for name, on in switches.items() if on and name not in found]
    if missing:
        raise ConfigError(f'{label}: check {missing[0]!r} is on but nothing was detected; add it under [commands]')
    if 'verify' not in found and switches.get('verify', host.get('verify', True)) and (Path(root) / '.fleet/verify.sh').exists():
        raise ConfigError(f'{label}: Coldbox no longer runs .fleet/verify.sh by itself; add verify = "coldverify --ci" '
                          'under [commands], or verify = false under [checks]')
    names = [n for n in CHECK_ORDER if n in found] + [n for n in found if n not in CHECK_ORDER]
    enabled = {name: found[name] for name in names if switches.get(name, host.get(name, True))}
    if profile is not None:
        selected = set(profiles[profile])
        if unavailable := sorted(selected - enabled.keys()):
            raise ProfileRefusal('unauthorized_profile',
                                 f'{label}: profile {profile!r} includes unavailable checks: {", ".join(unavailable)}')
        return [(name, commands) for name, commands in enabled.items() if name in selected]
    return list(enabled.items())


def base_plan(root):
    try:
        sha = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())['pull_request']['base']['sha']
    except (KeyError, TypeError, OSError, ValueError):
        raise ConfigError('pull_request event: GITHUB_EVENT_PATH has no readable pull_request.base.sha')
    if not isinstance(sha, str) or not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', sha):
        raise ConfigError(f'pull_request event: base sha {sha!r} is not a commit id')
    with tempfile.TemporaryDirectory() as tmp:
        tree = Path(tmp) / 'tree'
        tree.mkdir()
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(tmp) / 'index'), GIT_LFS_SKIP_SMUDGE='1')
        for command in (['read-tree', sha], ['--work-tree', str(tree), 'checkout-index', '-a']):
            if subprocess.run(['git', '-C', str(root), *command], env=env, capture_output=True).returncode:
                raise ConfigError(f'base commit {sha} is not in this checkout; check out with fetch-depth: 0')
        return plan(tree, f'base coldbox.toml ({sha})')


def checks_plan(root, profile=None):
    if profile is not None and os.environ.get('GITHUB_EVENT_NAME') == 'pull_request':
        raise ConfigError('--profile is only for direct verification')
    head = plan(root, profile=profile)
    if os.environ.get('GITHUB_EVENT_NAME') != 'pull_request':
        return head
    base = base_plan(root)
    in_base, in_head = ({(name, c) for name, commands in steps for c in commands} for steps in (base, head))
    for name, command in sorted(in_base - in_head):
        workflow_command('notice', 'coldbox runs the base check', f'the base coldbox.toml still runs {name}: '
                         f'{command}; a change to it takes effect after merge')
    added = [(name, [c for c in commands if (name, c) not in in_base]) for name, commands in head]
    return base + [(name, commands) for name, commands in added if commands]


def workflow_command(kind, title, message):
    message = message.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')
    print(f'::{kind} title={title}::{message}', flush=True)


def run_checks(root, out=None, profile=None):
    try:
        steps = checks_plan(root, profile)
    except ProfileRefusal as error:
        if out:
            write_json(out, dict(verdict='refused', cause=error.cause, error=str(error)))
        raise
    results, failed = [], False
    activate_python = ''
    junit_dir = out and Path(out).parent / 'junit' / str(os.getpid())
    for name, commands in steps:
        for command in commands:
            if failed:
                results.append(dict(check=name, command=command, status='not_run', exit=None, seconds=0))
                continue
            print(f'== coldbox {name}: {command}', flush=True)
            started = time.monotonic()
            env = dict(os.environ)
            if out and not sets_junitxml(root, command):
                junit_dir.mkdir(parents=True, exist_ok=True)
                env['COLDBOX_JUNIT'] = str(junit_dir / f'{len(results)}-count.xml')
                junit = f"--junitxml={junit_dir / f'{len(results)}.xml'}"
                env['PYTEST_ADDOPTS'] = ' '.join(filter(None, [os.environ.get('PYTEST_ADDOPTS'), junit]))
            code = subprocess.run(['bash', '-eo', 'pipefail', '-c', activate_python + command], cwd=root, env=env).returncode
            results.append(dict(check=name, command=command, status='pass' if code == 0 else 'fail',
                                exit=code, seconds=round(time.monotonic() - started, 3)))
            failed = code != 0
            if name == 'setup' and command == PY_REQUIREMENTS_SETUP and not failed:
                activate_python = PY_ACTIVATE + '\n'
    verdict = 'pass' if results and all(r['status'] == 'pass' for r in results) else 'fail'
    summary = dict(verdict=verdict, checks=results)
    if not results:
        summary['error'] = 'no checks to run'
    if out:
        write_json(out, summary)
    for r in results:
        print(f"{r['status'].upper():8} {r['check']:8} {r['seconds']:8.1f}s  {r['command']}")
    print(f'coldbox checks (commands only): {verdict.upper()}' + (' (nothing to run)' if not results else ''))
    if os.environ.get('GITHUB_ACTIONS') == 'true':
        annotate(results, junit_dir)
    return 0 if verdict == 'pass' else 1


def annotate(results, junit_dir):
    def error(title, message):
        workflow_command('error', title, message)

    tests = junit_summary([junit_dir]) if junit_dir else dict(failed=0, error=0, results=[])
    count = tests['failed'] + tests['error']
    names = ['.'.join(filter(None, (t['classname'], t['name'])))
             for t in tests['results'] if t['status'] in ('failed', 'error')][:10]
    if count:
        error(f'coldbox {count} test(s) failed', ', '.join(names + ['...'] * (count > len(names))))
    for r in results:
        if r['status'] == 'fail':
            error(f"coldbox {r['check']} failed", f"{r['command']} exited {r['exit']}")
    if not results:
        error('coldbox found nothing to run', 'switch a check on or add one under [commands] in coldbox.toml')


def sets_junitxml(root, command):
    configs = [Path(root) / name for name in PYTEST_CONFIGS]
    texts = [command, os.environ.get('PYTEST_ADDOPTS', '')]
    texts += [path.read_text(errors='replace') for path in configs if path.is_file()]
    return any('junitxml' in text for text in texts)


def tracked(path):
    return subprocess.run(['git', '-C', str(path.parent), 'ls-files', '--error-unmatch', '--', path.name],
                          capture_output=True).returncode == 0


def junit_files(dirs, since=0, archived=frozenset()):
    for top in dirs:
        for root, subdirs, names in os.walk(top):
            subdirs[:] = sorted(d for d in subdirs if not d.startswith('.') and d not in ('node_modules', 'vendor'))
            for name in sorted(names):
                path = Path(root) / name
                try:
                    if not name.endswith('.xml') or path.stat().st_mtime < since:
                        continue
                    with path.open('rb') as report:
                        if b'<testsuite' in report.read(4096) and str(path) not in archived and not tracked(path):
                            yield path
                except OSError:
                    pass


def junit_seconds(text):
    try:
        seconds = float(text)
        if 0 <= seconds < math.inf:
            return seconds
    except (TypeError, ValueError):
        pass


def testcase_seconds(results, executed):
    values = [case.get('seconds') for case in results if isinstance(case, dict)
              and case.get('status') in ('passed', 'failed', 'error')]
    return measured_seconds(values) if len(values) == executed else None


def junit_summary(dirs, newer=None, archived=None):
    files, results = [], []
    skip = frozenset(Path(archived).read_text().splitlines()) if archived else frozenset()
    for path in junit_files(dirs, os.stat(newer).st_mtime if newer else 0, skip):
        try:
            report = ET.parse(path).getroot()
        except (ET.ParseError, OSError):
            continue
        files.append(str(path))
        suites = {case: suite.get('name', '') for suite in report.iter('testsuite') for case in suite.findall('testcase')}
        for case in report.iter('testcase'):
            status = next((s for tag, s in JUNIT_STATUS if case.find(tag) is not None), 'passed')
            results.append(dict(suite=suites.get(case, ''), classname=case.get('classname', ''),
                                name=case.get('name', ''), status=status, seconds=junit_seconds(case.get('time'))))
    counts = {status: sum(r['status'] == status for r in results) for status in ('passed', 'failed', 'error', 'skipped')}
    elapsed = testcase_seconds(results, len(results) - counts['skipped'])
    for case in results[:MAX_TEST_RESULTS]:
        if case['seconds'] is not None:
            case['seconds'] = round(case['seconds'], 3)
    return dict(files=files, total=len(results), **counts, truncated=len(results) > MAX_TEST_RESULTS,
                elapsed_test_seconds=elapsed, results=results[:MAX_TEST_RESULTS])


def cold_verify_counts(dirs, newer=None, archived=None):
    since = os.stat(newer).st_mtime if newer else 0
    skip = frozenset(Path(archived).read_text().splitlines()) if archived else frozenset()
    counts = []
    for top in dirs:
        for root, subdirs, names in os.walk(top):
            subdirs[:] = sorted(d for d in subdirs if d == '.cold' or not d.startswith('.') and d not in ('node_modules', 'vendor'))
            path = Path(root) / 'verify-result.json'
            try:
                if Path(root).name != '.cold' or 'verify-result.json' not in names or path.stat().st_mtime < since \
                        or str(path) in skip or tracked(path):
                    continue
            except OSError:
                continue
            try:
                count = json.loads(path.read_text()).get('tests_ran')
            except (OSError, ValueError, AttributeError):
                count = None
            counts.append(count if type(count) is int and count >= 0 else None)
    return counts


def tests_ran(junit, cold_verify):
    if junit['files']:
        return junit['total'] - junit['skipped'], 'junit'
    if None in cold_verify:
        return None, 'cold-verify'
    if cold_verify:
        return sum(cold_verify), 'cold-verify'
    return 0, None


def strict_test_count(report):
    run = report.get('run') if isinstance(report, dict) else None
    count = run.get('tests_ran') if isinstance(run, dict) else None
    return count if type(count) is int and count >= 0 else None


def missing_test_reason(tests, source):
    if source == 'junit' and tests.get('total', 0) > 0 and tests['total'] == tests.get('skipped'):
        return 'all_tests_skipped'
    return 'no_usable_tests'


def require_tests(root, job_dir):
    marker = job_dir / 'started'
    if not marker.is_file():
        raise ConfigError('require-tests needs the Coldbox job start marker')
    strict = root / STRICT_REPORT
    count, tests, source = None, {}, None
    with contextlib.suppress(OSError, ValueError):
        if strict.is_file() and strict.stat().st_mtime_ns > marker.stat().st_mtime_ns and not tracked(strict):
            count = strict_test_count(json.loads(strict.read_text()))
    if count is None:
        dirs = [job_dir / 'junit', root]
        tests = junit_summary(dirs, newer=marker)
        count, source = tests_ran(tests, cold_verify_counts(dirs, newer=marker))
    if count:
        print(f'coldbox verification: PASS ({count} test(s) ran) [pass]')
        return 0
    reason = 'the test count could not be read' if count is None else NO_TESTS
    reason = f'{reason} [{missing_test_reason(tests, source)}]'
    if os.environ.get('GITHUB_ACTIONS') == 'true':
        workflow_command('error', 'coldbox verification incomplete', reason)
    else:
        print(f'coldbox verification: INCOMPLETE ({reason})', file=sys.stderr)
    return 1


ORG_JOB_GATE = Path('/etc/coldbox/org-job')


def org_job_approved():
    try:
        ORG_JOB_GATE.stat()
    except FileNotFoundError:
        return True
    deadline = time.monotonic() + 120
    while not (ORG_JOB_GATE / 'deny').exists() and time.monotonic() < deadline:
        if (ORG_JOB_GATE / 'allow').exists():
            return True
        time.sleep(0.1)
    return False


def job_started(env=None):
    if not org_job_approved():
        raise Unsafe('host refused the public organization job')
    env = os.environ if env is None else env
    if env.get('COLDBOX_CI_PRIMARY'):
        admission_check(argparse.Namespace(expected_primary=env['COLDBOX_CI_PRIMARY']), env=env)
    event = {}
    if env.get('GITHUB_EVENT_PATH'):
        event = json.loads(Path(env['GITHUB_EVENT_PATH']).read_text())
    name = env.get('GITHUB_EVENT_NAME') or ''
    writers, refused = env.get('COLDBOX_PUBLIC_WRITERS'), None
    private_dynamic = name == 'dynamic' and writers is None and not (env.get('GITHUB_REF') or '').startswith('refs/pull/')
    fork = False if name in SAME_REPO_EVENTS or private_dynamic else None
    pr = event.get('pull_request')
    if pr:
        repos = (pr.get('head') or {}).get('repo'), (pr.get('base') or {}).get('repo')
    elif name == 'workflow_run':
        repos = (event.get('workflow_run') or {}).get('head_repository'), event.get('repository')
    if pr or name == 'workflow_run':
        head, base = ((repo or {}).get('full_name') for repo in repos)
        fork = head is None or head != base
    actor = env.get('GITHUB_TRIGGERING_ACTOR') or env.get('GITHUB_ACTOR')
    refused = outsider(name, fork, actor, None if writers is None else writers.split(','))
    if writers is None and fork is None:
        refused = f'{name or "unknown"} event: cannot tell whether the code is from a fork'
    job = dict(repo=env.get('GITHUB_REPOSITORY'), sha=env.get('GITHUB_SHA'), ref=env.get('GITHUB_REF'),
               event=name, workflow=env.get('GITHUB_WORKFLOW'), job=env.get('GITHUB_JOB'),
               run_id=env.get('GITHUB_RUN_ID'), run_attempt=env.get('GITHUB_RUN_ATTEMPT'),
               actor=env.get('GITHUB_ACTOR'), fork_pr=fork, refused=refused, started_at=now_iso())
    if env.get('COLDBOX_JOB_DIR'):
        write_json(Path(env['COLDBOX_JOB_DIR']) / 'job.json', job)
    if refused:
        print(f'coldbox: refusing this job ({refused})', file=sys.stderr)
        return 1
    return 0


def attempt_jobs(repo, run_id, attempt):
    path = f"repos/{repo}/actions/runs/{run_id}/attempts/{attempt}/jobs?"
    jobs, page = [], 1
    while True:
        batch = gh(f'{path}per_page=100&page={page}')['jobs']
        jobs.extend(batch)
        if len(batch) < 100:
            return jobs
        page += 1


def record_queue_wait(metadata, runner):
    try:
        jobs = attempt_jobs(metadata['repo'], metadata['run_id'], metadata['run_attempt'])
        matched = next(job for job in jobs if job.get('runner_name') == runner)
        metadata['job_id'] = matched['id']
        if matched.get('completed_at'):
            metadata['completed_at'] = matched['completed_at']
        if steps := job_steps(matched.get('steps')):
            metadata['steps'] = steps
        queued = datetime.fromisoformat(matched['created_at'])
        metadata['queued_at'] = matched['created_at']
        seconds = (datetime.fromisoformat(matched['started_at']) - queued).total_seconds()
        if seconds < 0:
            del metadata['queued_at']
            raise ValueError('job started before it was queued')
        metadata.update(runner_started_at=matched['started_at'], queue_wait_seconds=round(seconds, 3))
        print(f'coldbox: {runner} queue waited {seconds:g} s', file=sys.stderr, flush=True)
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, StopIteration) as error:
        print(f'coldbox: queue wait unavailable for {runner}: {error}', file=sys.stderr, flush=True)


def job_steps(steps):
    found = []
    for step in steps or []:
        try:
            seconds = (datetime.fromisoformat(step['completed_at']) -
                       datetime.fromisoformat(step['started_at'])).total_seconds()
        except (KeyError, TypeError, ValueError):
            seconds = None
        found.append(dict(name=step.get('name'), conclusion=step.get('conclusion'),
                          seconds=round(seconds, 3) if seconds is not None and seconds >= 0 else None))
    return found


def outsider(event, fork, actor, writers):
    """Why a job must not run, or None. Fork code never runs, whoever triggered or approved it. On an opted-in public
    repo (writers is a list), only users with write access run anything else."""
    if fork:
        return FORK_REFUSED
    if writers is None or actor and actor.casefold() in {writer.casefold() for writer in writers}:
        return None
    return f'{event or "unknown"} event triggered by {actor or "an unknown user"}, who has no write access'


def acl_document(addresses):
    blocked = ['0.0.0.0/8', '10.0.0.0/8', '100.64.0.0/10', '127.0.0.0/8', '169.254.0.0/16', '172.16.0.0/12',
               '192.0.0.0/24', '192.0.2.0/24', '192.168.0.0/16', '198.18.0.0/15', '198.51.100.0/24',
               '203.0.113.0/24', '224.0.0.0/4', '240.0.0.0/4']
    public = [ipaddress.ip_network('0.0.0.0/0')]
    for cidr in blocked:
        net = ipaddress.ip_network(cidr)
        public = [part for old in public for part in (old.address_exclude(net) if net.subnet_of(old) else [old])]
    egress = [dict(action='allow', state='enabled', destination=str(net)) for net in public]
    for protocol, ports in (('udp', '53,67'), ('tcp', '53')):
        egress.append(dict(action='allow', state='enabled', destination=GATEWAY, protocol=protocol,
                           destination_port=ports))
    egress.append(dict(action='allow', state='enabled', destination='255.255.255.255', protocol='udp',
                       destination_port='67'))
    for interface in addresses:
        for addr in interface.get('addr_info', []):
            if addr['family'] == 'inet' and ipaddress.ip_address(addr['local']).is_global:
                egress.insert(0, dict(action='reject', state='enabled', destination=addr['local']))
    ingress = [dict(action='allow', state='enabled', source=GATEWAY, protocol='udp', source_port='67',
                    destination_port='68')]
    return dict(description='Coldbox: public internet only; no LAN, tailnet or host',
                config={MANAGED: 'true', EXPIRES: 'never'},
                ingress=ingress, egress=egress)


