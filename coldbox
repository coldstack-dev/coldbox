    receipt = job('adhoc', name, args.ttl, args.command, repo='adhoc', offline=args.offline, cwd=f'/home/{RUNNER}',
                  extra=dict(command=args.command), receipts=args.receipts, config=config, pooled=pooled,
                  **({'warm_claimed': True} if claimed else {}))
