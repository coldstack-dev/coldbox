    check(not held, f"{len(held)} receipt(s) past their VM TTL with vm.destroyed false"
          f"{': ' if held else ''}{' '.join(held[:10])}{' ...' if len(held) > 10 else ''}",
          f"coldbox reap; if it stays, stop the worker still holding it ({STATE / 'workers'}/<pid>)")
    smoke = STATE / 'base-smoke-failed.json'
