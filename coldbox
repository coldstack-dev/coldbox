def vcpus(text):
    if not re.fullmatch(r'[1-9]\d*', text) or int(text) > host_cpus():
        raise argparse.ArgumentTypeError(f'use a vCPU count from 1 to {host_cpus()}, not {text!r}')
    return int(text)


def vm_size(text):
    if not re.fullmatch(r'[1-9]\d{0,6}(MiB|GiB)', text):
        raise argparse.ArgumentTypeError(f'use a size such as 8GiB or 512MiB, not {text!r}')
    return text


def window(text):
    match = re.fullmatch(r'([1-9]\d*)([smhd])', text)
    if not match:
        raise argparse.ArgumentTypeError(f'use a duration such as 30m, 1h or 7d, not {text!r}')
    return int(match[1]) * dict(s=1, m=60, h=3600, d=86400)[match[2]]


def at(text):
    return datetime.fromisoformat(text).timestamp()


def spread(values):
    values = sorted(values)
    rank = lambda share: values[max(0, math.ceil(share * len(values)) - 1)]
    return dict(n=len(values), p50=rank(.5), p90=rank(.9), max=values[-1]) if values else dict(n=0)


def ran_job(receipt):
    if receipt.get('mode') == 'runner':
        return bool(receipt.get('github')) and not receipt['github'].get('refused')
    return 'exit' in receipt


def job_span(receipt, now=None):
    github = receipt.get('github') or {}
    try:
        if now is not None and running(receipt):
            if receipt['mode'] == 'runner':
                found = re.findall(rb'^(\d{4}-\d\d-\d\d) (\d\d:\d\d:\d\d)Z: Running job', Path(receipt['log']).read_bytes(),
                                   re.M)
                return (at(f'{found[-1][0].decode()}T{found[-1][1].decode()}+00:00'), now) if found else None
            return at(receipt['job_started_at']), now
        if receipt['mode'] == 'runner':
            return at(github['runner_started_at']), at(github.get('completed_at') or receipt['job_ended_at'])
        return at(receipt['job_started_at']), at(receipt['job_ended_at'])
    except (KeyError, TypeError, ValueError, OSError):
        return None


def job_wall(receipt):
    span = job_span(receipt)
    if span:
        return round(span[1] - span[0], 3)
    return receipt.get('job_seconds') if receipt.get('mode') != 'runner' else None


STAT_METRICS = dict(queue_wait=lambda r: (r.get('github') or {}).get('queue_wait_seconds'),
                    boot_to_ready=lambda r: (r.get('vm') or {}).get('ready_seconds'),
                    job_wall=job_wall)


def job_stats(jobs):
    found = dict(jobs=len(jobs))
    for metric, read in STAT_METRICS.items():
        values = [value for value in map(read, jobs) if type(value) in (int, float)]
        found[metric] = dict(spread(values), missing=len(jobs) - len(values))
    return found


def step_times(receipt):
    steps = (receipt.get('github') or {}).get('steps') or []
    return ([(step.get('name'), step.get('seconds')) for step in steps] +
            [(f"checks/{check.get('check')}", check.get('seconds')) for check in receipt.get('checks') or []])


def most_at_once(spans):
    edges = sorted([(start, 1) for start, _ in spans] + [(end, -1) for _, end in spans])
    now = best = 0
    for _, change in edges:
        now += change
        best = max(best, now)
    return best


def running(receipt):
    return 'seconds' not in receipt and not (receipt.get('vm') or {}).get('destroyed')


def vm_span(receipt, now):
    start, vm = at(receipt['started_at']), receipt.get('vm') or {}
    if not vm.get('destroyed'):
        return start, now
    return start, at(vm['destroyed_at']) if vm.get('destroyed_at') else start + receipt['seconds']


def job_start(receipt, now):
    """When the job started, or None for a VM that never got one."""
    try:
        if receipt['mode'] == 'runner' and (receipt.get('github') or {}).get('runner_started_at'):
            return at(receipt['github']['runner_started_at'])
    except ValueError:
        return None
    span = job_span(receipt, now)
    if span:
        return span[0]
    return at(receipt['started_at']) if ran_job(receipt) else None


def busy_span(receipt, now):
    """A job's busy time. A runner receipt from before job end times were recorded ends when its VM did."""
    span = job_span(receipt, now)
    if span or not ran_job(receipt) or (start := job_start(receipt, now)) is None:
        return span
    return start, vm_span(receipt, now)[1]


def saturation(receipts, cutoff, now):
    def in_window(spans):
        return [(max(start, cutoff), end) for start, end in spans if end >= cutoff]

    ceilings = [r['vm']['host_ceiling'] for r in receipts if type((r.get('vm') or {}).get('host_ceiling')) is int]
    busy = filter(None, (busy_span(r, now) for r in receipts))
    return dict(vms_peak=most_at_once(in_window(vm_span(r, now) for r in receipts)),
                busy_peak=most_at_once(in_window(busy)), ceiling=max(ceilings, default=None),
                overflow_jobs=sum(1 for r in receipts if (job_start(r, now) or 0) >= cutoff
                                  and r.get('admission') and r['admission'].get('host') != r['admission'].get('primary')))


def orchestration_split(jobs):
    pairs = [(vm['ready_seconds'] + vm['destroy_seconds'], wall) for vm, wall in
             ((r.get('vm') or {}, job_wall(r)) for r in jobs)
             if all(type(value) in (int, float) for value in (vm.get('ready_seconds'), vm.get('destroy_seconds'), wall))]
    orchestration, wall = sum(pair[0] for pair in pairs), sum(pair[1] for pair in pairs)
    return dict(jobs=len(pairs), missing=len(jobs) - len(pairs), orchestration_seconds=round(orchestration, 3),
                test_seconds=round(wall, 3), job_wall_seconds=round(wall, 3),
                orchestration_pct=round(100 * orchestration / (orchestration + wall), 1) if orchestration + wall else None)


def measured_seconds(rows):
    if rows and all(type(v) in (int, float) and 0 <= v <= sys.float_info.max for v in rows):
        seconds = sum(rows)
        if seconds <= sys.float_info.max:
            return round(seconds, 3)


def receipt_test_seconds(receipt):
    tests = receipt.get('tests') or {}
    if not isinstance(tests, dict):
        return None
    if 'elapsed_test_seconds' in tests:
        return tests['elapsed_test_seconds']
    total, skipped, rows = tests.get('total'), tests.get('skipped'), tests.get('results')
    if not tests.get('truncated') and isinstance(rows, list) and all(type(n) is int for n in (total, skipped)):
        return testcase_seconds(rows, total - skipped)


def runner_events(receipt):
    try:
        log = Path(receipt['log']).read_bytes()
        events = re.findall(rb'^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)Z: (Listening for Jobs|Running job:|Job [^\n]+ completed with result:)',
                            log, re.M)
        return [(at(stamp.decode() + '+00:00'), event) for stamp, event in events]
    except (OSError, KeyError, TypeError, ValueError):
        return []


def listener_span(receipt, events, now):
    if not events or events[0][1] != b'Listening for Jobs':
        return None
    start = events[0][0]
    assigned = next((stamp for stamp, event in events if event == b'Running job:'), None)
    if assigned is not None:
        return start, assigned
    if any(event != b'Listening for Jobs' for _, event in events) or receipt.get('github') or receipt.get('job_name'):
        return None
    if running(receipt) and not past_ttl(receipt, now):
        return start, now
    if receipt.get('verdict') == 'idle' and receipt.get('job_ended_at'):
        with contextlib.suppress(TypeError, ValueError):
            return start, at(receipt['job_ended_at'])


def cache_hit(receipt):
    npm = receipt.get('cache')
    if not isinstance(npm, dict) or not npm:
        return None
    restored = [npm, *(npm[tool] for tool in CACHES if tool != 'npm' and tool in npm)]
    outcomes = []
    for row in restored:
        size = row.get('in_bytes') if isinstance(row, dict) else None
        status = row.get('in_exit') if isinstance(row, dict) else None
        if type(size) is int and size > 0 and type(status) is int:
            outcomes.append(status == 0)
        elif type(size) is int and size == 0 and 'in_error' not in row:
            outcomes.append(False)
        else:
            outcomes.append(None)
    return True if True in outcomes else None if None in outcomes else False


ACTIONS_USD_PER_MINUTE = 0.006


def actions_savings(receipts, cutoff, now, vm_hours):
    walls = [job_wall(r) for r in receipts if r.get('mode') == 'runner' and r.get('verdict') not in ('idle', 'refused')
             and not (github := r.get('github') or {}).get('refused') and (github or r.get('job_name') or job_span(r, now))
             and (job_start(r, now) or at(r['started_at'])) >= cutoff]
    measured = [wall for wall in walls if type(wall) in (int, float) and wall >= 0]
    billable = sum(math.ceil(wall / 60) for wall in measured)
    return dict(vm_minutes=round(vm_hours * 60, 3), billable_minutes=billable, usd_per_minute=ACTIONS_USD_PER_MINUTE,
                estimated_usd=round(billable * ACTIONS_USD_PER_MINUTE, 2), unmeasured_jobs=len(walls) - len(measured))


def cost_rate():
    try:
        data = tomllib.loads(STATS_CONFIG.read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        print('coldbox: could not read the stats config', file=sys.stderr)
        return None
    if 'cost' in data:
        table = data['cost']
        rate = table.get('per_vm_hour') if isinstance(table, dict) else None
        if type(rate) in (int, float) and 0 <= rate <= sys.float_info.max:
            return rate
        if rate is not None or not isinstance(table, dict):
            print('coldbox: [cost] per_vm_hour must be a finite, non-negative number', file=sys.stderr)


def resource_stats(receipts, jobs, settled, listeners, cutoff, now, rate, unreadable):
    def seconds_in_window(span):
        start, end = span
        return max(0, min(end, now) - max(start, cutoff))

    junit = [s for r in jobs if type(s := receipt_test_seconds(r)) in (int, float) and 0 <= s < math.inf]
    cache = [hit for r in jobs if (hit := cache_hit(r)) is not None]
    listener_seconds = [seconds_in_window(span) for span in listeners.values()]
    runner_count = sum(r.get('mode') == 'runner' for r in receipts)
    finished = [r for r in settled if ran_job(r)]
    reclaimed = [size for r in finished if (r.get('vm') or {}).get('destroyed') is True
                 and type(size := r['vm'].get('reclaimed_bytes')) is int and size >= 0]
    completed = sum(r.get('verdict') == 'pass' for r in finished)
    vm_hours = sum(seconds_in_window(vm_span(r, now)) for r in receipts) / 3600
    cost = vm_hours * rate / completed if completed and rate is not None and not unreadable else math.nan
    return dict(junit_test_seconds=round(sum(junit), 3) if junit else 'unknown',
                junit_jobs=len(junit),
                idle_vm_hours=round(sum(listener_seconds) / 3600, 6) if listener_seconds else 'unknown',
                idle_vms=len(listener_seconds), idle_vms_unknown=runner_count - len(listener_seconds),
                reclaimed_bytes_per_job=round(sum(reclaimed) / len(reclaimed)) if reclaimed else 'unknown',
                reclaimed_jobs=len(reclaimed), reclaimed_jobs_unknown=len(finished) - len(reclaimed),
                cache_hit_share=round(sum(cache) / len(cache), 6) if cache else 'unknown',
                cache_jobs=len(cache),
                vm_hours=round(vm_hours, 6), passing_jobs=completed,
                cost_per_pass=round(cost, 6) if math.isfinite(cost) else 'unknown')


def check_seconds(receipt, phase):
    return measured_seconds([check.get('seconds') for check in receipt.get('checks') or []
                             if check.get('check') == phase and check.get('status') in ('pass', 'fail')])


def runner_setup_seconds(receipt):
    steps = (receipt.get('github') or {}).get('steps') or []
    setup = [step.get('seconds') for step in steps if step.get('name') == 'Set up job']
    if len(setup) == 1 and steps[0].get('name') == 'Set up job':
        return setup[0]


def phase_stats(jobs):
    phases = dict(
        vm_ready=lambda r: (r.get('vm') or {}).get('ready_seconds'),
        runner_setup=runner_setup_seconds,
        check_setup=lambda r: check_seconds(r, 'setup'),
        test=lambda r: r.get('job_seconds') if (r.get('suite_observation') or {}).get('tests_ran') else check_seconds(r, 'test'),
        teardown=lambda r: (r.get('vm') or {}).get('destroy_seconds'),
    )
    result = {}
    for phase, read in phases.items():
        values = [v for v in map(read, jobs) if type(v) in (int, float) and 0 <= v < math.inf]
        result[phase] = dict(n=len(values), missing=len(jobs) - len(values), seconds=measured_seconds(values))
    return result


def request_stats(receipts, folders, cutoff, now, local=False, waiting=()):
    records, snapshots = {}, {}
    reasons = {}
    unreadable = 0
    unlinked, unassigned = set(), set()
    log_only = set()

    def submission_time(name):
        match = re.fullmatch(r'cbx-(\d+)-[0-9a-f]{6}-[a-z0-9-]+', name)
        return int(match[1]) if match else None

    folders = tuple(map(Path, folders))
    for folder in folders:
        for path in (folder.parent / 'queues').glob('*/*.json'):
            try:
                snapshot = json.loads(path.read_text())
                observed = at(snapshot['observed_at'])
                jobs = snapshot.get('accepted_jobs', [])
                unknown = snapshot.get('unidentified_queued', snapshot['queued'])
                if type(unknown) is not int or not isinstance(jobs, list):
                    raise ValueError('invalid queue observation')
                repo = f'{path.parent.name}/{path.stem}'.lower()
                if cutoff <= observed <= now:
                    if observed > snapshots.get(repo, (0, 0))[0]:
                        snapshots[repo] = observed, unknown
                    for job, accepted in queue_job_times(jobs):
                        records['github', repo, job['id']] = accepted, False, None
            except (OSError, ValueError, KeyError, TypeError):
                unreadable += 1
        directory = folder / 'submissions'
        try:
            for request in json.loads((directory / 'queue.json').read_text()):
                name = request['id']
                if (accepted := submission_time(name)) is not None:
                    records.setdefault(('vm', name), (accepted, False, None))
        except FileNotFoundError:
            pass
        except (OSError, ValueError, KeyError, TypeError):
            unreadable += 1
        for path in directory.glob('cbx-*.json'):
            if (accepted := submission_time(path.stem)) is not None and cutoff <= accepted <= now:
                try:
                    result = json.loads(path.read_text())
                    if not isinstance(result.get('cause'), str):
                        raise ValueError('missing submission outcome')
                    records['vm', path.stem] = accepted, False, 'incomplete'
                    reasons['vm', path.stem] = result['cause']
                except (OSError, ValueError, AttributeError):
                    unreadable += 1
        for path in folder.glob('cbx-*.submit.log'):
            name = path.name.removesuffix('.submit.log')
            key = 'vm', name
            accepted = submission_time(name)
            if accepted is None or not cutoff <= accepted <= now or key in records or (folder / f'{name}.json').exists():
                continue
            try:
                terminal = 'incomplete' if local and submission_worker(path) is False else None
            except OSError:
                unreadable += 1
                terminal = None
            if terminal:
                reasons[key] = 'receipt_not_observed'
            log_only.add(key)
            records[key] = accepted, False, terminal

    for r in receipts:
        github, name = r.get('github') or {}, r['id']
        verdict = r.get('verdict')
        if verdict in ('idle', 'refused') or github.get('refused'):
            continue
        started = at(r['started_at'])
        key = 'vm', name
        if r['mode'] == 'runner':
            if not (github or r.get('job_name') or job_span(r, now)):
                if cutoff <= started <= now and name not in waiting:
                    unassigned.add(name)
                continue
            if type(github.get('job_id')) is int and isinstance(github.get('repo'), str) and github['repo']:
                key = 'github', github['repo'].lower(), github['job_id']
            else:
                if cutoff <= (job_start(r, now) or started) <= now:
                    unlinked.add(name)
                continue
            try:
                accepted = at(github['queued_at'])
            except (KeyError, ValueError, TypeError):
                accepted = records[key][0] if key in records else job_start(r, now) or started
        else:
            log_only.discard(key)
            accepted = started
            if key in records:
                accepted = records[key][0]
            elif any((folder / f'{name}.submit.log').exists() for folder in folders):
                accepted = submission_time(name) or started
        terminal = verdict if not running(r) and verdict in ('pass', 'fail', 'incomplete', 'canceled') else None
        previous = records.get(key)
        if not previous or not previous[1] or not previous[2] or terminal:
            records[key] = accepted, True, terminal
            reasons[key] = r.get('reason_code') or r.get('cause')

    cohort = {key: (assigned, verdict) for key, (accepted, assigned, verdict) in records.items()
              if accepted is not None and cutoff <= accepted <= now}
    missing = []
    for key, (assigned, verdict) in sorted(cohort.items()):
        if verdict in ('pass', 'fail'):
            continue
        reason = reasons.get(key) or verdict or ('terminal_not_observed' if assigned else 'assignment_not_observed')
        entry = dict(source=key[0], id=key[-1], verdict=verdict, reason=reason)
        if key[0] == 'github':
            entry['repo'] = key[1]
        missing.append(entry)
    definitive = len(cohort) - len(missing)
    return dict(accepted=len(cohort), assigned=sum(assigned for assigned, _ in cohort.values()),
                terminal=sum(verdict is not None for _, verdict in cohort.values()), definitive=definitive,
                missing_observations=missing,
                definitive_pct=round(100 * definitive / len(cohort), 1) if cohort else None,
                unidentified_queued=sum(unknown for _, unknown in snapshots.values()), unlinked_runner_jobs=len(unlinked),
                assignment_unknown=len(unassigned), log_only_submissions=len(log_only), unreadable_queue_sources=unreadable,
                github_queue_snapshots=len(snapshots), unobserved_requests=None)


def outcomes(settled):
    verdicts = collections.Counter(r.get('verdict') or 'unknown' for r in settled)
    definitive = verdicts['pass'] + verdicts['fail']
    return dict(settled=len(settled), definitive=definitive,
                definitive_pct=round(100 * definitive / len(settled), 1) if settled else None,
                verdicts=dict(sorted(verdicts.items())),
                incomplete_causes=dict(collections.Counter(r.get('cause') or 'unknown' for r in settled
                                                           if r.get('verdict') == 'incomplete').most_common()))


def read_receipts(folders, cutoff, now, local=False):
    found, unreadable = {}, 0
    for folder in folders:
        try:
            paths = sorted(Path(folder).iterdir())
        except FileNotFoundError:
            unreadable += not local
            continue
        except OSError:
            unreadable += 1
            continue
        for path in paths:
            if not path.match('cbx-*.json'):
                continue
            try:
                receipt = json.loads(path.read_text())
                if not isinstance(receipt, dict) or (receipt.get('vm') is not None and not isinstance(receipt['vm'], dict)):
                    raise ValueError('invalid receipt VM record')
                rank = not running(receipt), vm_span(receipt, now)[1]
                if not local:
                    receipt['log'] = str(path.with_suffix('.log'))
                key = receipt['id'] if isinstance(receipt.get('id'), str) and receipt['id'] else path.resolve()
                if key not in found or rank > found[key][0]:
                    found[key] = rank, receipt
            except (OSError, ValueError, KeyError, TypeError):
                unreadable += 1
    return [receipt for (_, end), receipt in found.values() if end >= cutoff], unreadable


def stats_report(receipts, since, now, folders=(), local=False, rate=None, unreadable=0):
    """Times cover jobs that started in the window, even on an older warm VM; saturation covers every VM alive in it."""
    cutoff = now - since
    active = receipts
    receipts = [r for r in receipts if at(r['started_at']) >= cutoff]
    jobs = [r for r in active if ran_job(r) and (job_start(r, now) or 0) >= cutoff]
    listeners, waiting = {}, set()
    for r in active:
        if r.get('mode') != 'runner':
            continue
        events = runner_events(r)
        if (span := listener_span(r, events, now)) is not None:
            listeners[id(r)] = span
            if running(r) and all(event == b'Listening for Jobs' for _, event in events):
                waiting.add(r['id'])
    job_ids = set(map(id, jobs))
    group = collections.defaultdict(list)
    for r in jobs:
        group['repo', (r.get('github') or {}).get('repo') or r.get('repo') or 'unknown'].append(r)
    hosts = collections.defaultdict(list)
    for r in active:
        hosts[r.get('host') or 'unknown'].append(r)
    steps = collections.defaultdict(list)
    missing_steps = 0
    for r in jobs:
        times = step_times(r)
        missing_steps += not times
        for name, seconds in times:
            if type(seconds) in (int, float):
                steps[(r.get('github') or {}).get('repo') or r.get('repo') or 'unknown', name].append(seconds)
    settled_at = lambda r: at(r['started_at']) + r['seconds'] if 'seconds' in r else vm_span(r, now)[1]
    settled = [r for r in active if not running(r) and r.get('verdict') not in ('idle', 'refused')
               and settled_at(r) >= cutoff]
    job_end = lambda r: (job_span(r) or (0, at(r['job_ended_at']) if r.get('job_ended_at') else 0))[1]
    finished = sum(1 for r in active if ran_job(r) and not running(r) and job_end(r) >= cutoff)
    orphans = sum((r.get('vm') or {}).get('destroyed') is False and ('seconds' in r or past_ttl(r, now)) for r in active)
    slowest = sorted((dict(repo=repo, step=name, **spread(values)) for (repo, name), values in steps.items()),
                     key=lambda step: step['p90'], reverse=True)[:10]
    resources = resource_stats(active, jobs, settled, listeners, cutoff, now, rate, unreadable)
    return dict(since_seconds=since, since=datetime.fromtimestamp(now - since, timezone.utc).isoformat(timespec='seconds'),
                vms=len(receipts), **job_stats(jobs), jobs_per_hour=round(finished * 3600 / since, 2),
                outcomes=outcomes(settled), requests=request_stats(active, folders, cutoff, now, local, waiting),
                resources=resources, savings=actions_savings(active, cutoff, now, resources['vm_hours']),
                split=orchestration_split(jobs), phases=phase_stats(jobs), orphans=orphans,
                jobs_without_steps=missing_steps,
                repos={name: job_stats(rows) for (_, name), rows in sorted(group.items())},
                hosts={name: dict(job_stats([r for r in rows if id(r) in job_ids]),
                                  vms=sum(at(r['started_at']) >= cutoff for r in rows), **saturation(rows, cutoff, now))
                       for name, rows in sorted(hosts.items())},
                slowest_steps=slowest)


def stats_text(report):
    def cell(metric):
        if not metric['n']:
            return '-'
        return '/'.join(f'{metric[key]:.0f}' for key in ('p50', 'p90', 'max'))

    def missing(row):
        gaps = [f'{metric} {row[metric]["missing"]}' for metric in STAT_METRICS if row[metric]['missing']]
        return ', '.join(gaps) or '-'

    def table(rows):
        widths = [max(len(str(row[i])) for row in rows) for i in range(len(rows[0]))]
        return [' '.join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip() for row in rows]

    def pct(value):
        return '-' if value is None else f'{value:g}%'

    def p50_p90(metric):
        return f"{metric['p50']:.0f}/{metric['p90']:.0f} s" if metric['n'] else '-'

    found, split, requests = report['outcomes'], report['split'], report['requests']
    resources = report['resources']
    causes = ', '.join(f'{name} {count}' for name, count in found['incomplete_causes'].items()) or '-'
    phases = []
    for label, key in [('VM ready', 'vm_ready'), ('runner setup', 'runner_setup'), ('check setup', 'check_setup'),
                       ('test execution', 'test'), ('VM teardown', 'teardown')]:
        phase = report['phases'][key]
        seconds = '-' if phase['seconds'] is None else f"{phase['seconds']:g} s"
        phases.append(f"{label}: {seconds} ({phase['n']}/{phase['n'] + phase['missing']} jobs measured)")
    lines = [f"coldbox stats: {report['jobs']} finished jobs on {report['vms']} VMs since {report['since']}",
             f"observed requests: {requests['accepted']} accepted, {requests['assigned']} assigned, "
             f"{requests['terminal']} terminal, {requests['definitive']} definitive ({pct(requests['definitive_pct'])})",
             f"request coverage: unobserved requests unknown; {requests['github_queue_snapshots']} GitHub queue snapshot(s); "
             f"{requests['unidentified_queued']} queued without identity; {requests['unlinked_runner_jobs']} runner jobs "
             f"without GitHub job ID; {requests['assignment_unknown']} runner VMs with unknown assignment; "
             f"{requests['log_only_submissions']} direct submissions with only a log; "
             f"{requests['unreadable_queue_sources']} unreadable queue source(s)",
             f"definitive (pass or fail): {found['definitive']} of {found['settled']} settled, {pct(found['definitive_pct'])}",
             f'incomplete causes: {causes}',
             f"ready p50/p90: {p50_p90(report['boot_to_ready'])}; queue p50/p90: {p50_p90(report['queue_wait'])}; "
             f"jobs/hour: {report['jobs_per_hour']:g}",
             f"orchestration (VM ready + destroy) vs job wall: {split['orchestration_seconds']:.0f} s vs "
             f"{split['job_wall_seconds']:.0f} s, {pct(split['orchestration_pct'])} orchestration over {split['jobs']} jobs",
             *phases,
             f"JUnit test seconds: {resources['junit_test_seconds']} ({resources['junit_jobs']}/{report['jobs']} jobs)",
             f"idle VM-hours: {resources['idle_vm_hours']} ({resources['idle_vms']} measured, "
             f"{resources['idle_vms_unknown']} unknown)",
             f"reclaimed bytes per job: {resources['reclaimed_bytes_per_job']} ({resources['reclaimed_jobs']} measured, "
             f"{resources['reclaimed_jobs_unknown']} unknown)",
             f"cache-hit share: {resources['cache_hit_share']} ({resources['cache_jobs']}/{report['jobs']} jobs)",
             f"cost per pass: {resources['cost_per_pass']} ({resources['vm_hours']} VM-hours, "
             f"{resources['passing_jobs']} passes)",
             f"orphans (vm.destroyed false after the job or its TTL): {report['orphans']}", '',
             'seconds as p50/p90/max; MISSING counts jobs whose receipt lacks the field', '']
    head = ['JOBS', 'QUEUE WAIT', 'BOOT TO READY', 'JOB WALL', 'MISSING']
    for title, key in (('REPO', 'repos'), ('HOST', 'hosts')):
        rows = [[title] + head] + [[name, row['jobs'], *(cell(row[m]) for m in STAT_METRICS), missing(row)]
                                   for name, row in report[key].items()]
        lines += table(rows) + ['']
    lines += table([['HOST', 'VMS PEAK', 'BUSY PEAK', 'CEILING', 'OVERFLOW JOBS']] +
                   [[name, row['vms_peak'], row['busy_peak'], row['ceiling'] or '-', row['overflow_jobs']]
                    for name, row in report['hosts'].items()]) + ['']
    lines += table([['SLOWEST STEPS', 'REPO', 'N', 'P50/P90/MAX']] +
                   [[step['step'], step['repo'], step['n'], cell(step)] for step in report['slowest_steps']])
    if report['jobs_without_steps']:
        lines.append(f"{report['jobs_without_steps']} job(s) recorded no step timing")
    return '\n'.join(lines)


def stats(args):
    now = time.time()
    folders = args.receipts or [STATE / 'receipts']
    local = args.receipts is None
    receipts, unreadable = read_receipts(folders, now - args.since, now, local=local)
    report = stats_report(receipts, args.since, now, folders, local=local, rate=cost_rate(), unreadable=unreadable)
    report['unreadable_receipts'] = unreadable
    if args.json:
        report['schema_version'] = 1
        print(json.dumps(report, indent=2, allow_nan=False))
        incomplete = unreadable or report['requests']['unreadable_queue_sources']
        return 1 if report['orphans'] else 2 if incomplete else 0
    print(stats_text(report))
    if unreadable:
        print(f'coldbox: skipped {unreadable} unreadable receipt(s)', file=sys.stderr)
    return 0


def detect_cmd(args):
    if args.workflow:
        return detect_workflow(args.path)
    found, host = detect(args.path), host_switches()
    if not found:
        print('coldbox: no checks detected; write [commands] in coldbox.toml yourself', file=sys.stderr)
        return 1
    print('# coldbox.toml: set a check to false to switch it off; replace a command under [commands].')
    print('[checks]')
    for name in [n for n in CHECK_ORDER if n in found] + [n for n in found if n not in CHECK_ORDER]:
        print(f"{name} = {'true' if host.get(name, True) else 'false'}  # " + ' ; '.join(found[name]))
    return 0


def detect_workflow(root):
    for path in sorted((Path(root) / '.github' / 'workflows').glob('*.y*ml')):
        lines = path.read_text(errors='replace').splitlines()
        if any(re.search(r'\bcoldbox\s+checks\b', line.split(' #')[0]) for line in lines
               if not re.match(r'\s*(#|-?\s*name:)', line)):
            print(f'coldbox: {path.relative_to(root)} already runs coldbox checks', file=sys.stderr)
            return 1
    steps = plan(root)
    if not steps:
        print('coldbox: no checks would run; write [commands] in coldbox.toml yourself', file=sys.stderr)
        return 1
    print(WORKFLOW + '# coldbox checks runs these here (coldbox.toml switches them):',
          *[f'#   {name}: ' + ' ; '.join(commands).replace('\n', '\n#     ') for name, commands in steps], sep='\n')
    return 0


def incus_group_exec(argv):
    if os.geteuid() == 0:
        return
    try:
        group = grp.getgrnam('incus-admin')
    except KeyError:
        return
    if group.gr_gid in (os.getegid(), *os.getgroups()) or pwd.getpwuid(os.getuid()).pw_name not in group.gr_mem:
        return
    os.execvp('sg', ['sg', 'incus-admin', '-c', shlex.join([sys.executable, str(Path(__file__).resolve()), *argv])])


def json_incomplete(error):
    print(json.dumps(dict(schema_version=1, verdict='INCOMPLETE', error=str(error))))
    return 2


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    words, command = argv, []
    if argv[:1] == ['run'] and '--' in argv:
        words, command = argv[:argv.index('--')], argv[argv.index('--') + 1:]
    json_flags = ('--j', '--js', '--jso', '--json') if words[:1] in (['stats'], ['status'], ['pool']) else ('--json',)
    json_requested = any(word.partition('=')[0] in json_flags
                         for word in itertools.takewhile(lambda word: word != '--', words))

    class Parser(argparse.ArgumentParser):
        def error(self, message):
            if json_requested:
                self.exit(json_incomplete(message))
            super().error(message)

    parser = Parser(prog='coldbox', description=__doc__)
    parser.add_argument('--version', action='version', version=f'%(prog)s {VERSION} (build {build_id()})')
    sub = parser.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('detect', help='print a suggested coldbox.toml for a repo')
    p.add_argument('path', nargs='?', default='.')
    p.add_argument('--workflow', action='store_true',
                   help='print a GitHub Actions workflow that runs the checks, unless one already does')
    p = sub.add_parser('checks', help='run the enabled checks here and report their command exit status')
    p.add_argument('path', nargs='?', default='.')
    p.add_argument('--profile', help=argparse.SUPPRESS)
    sub.add_parser('require-tests', help='require at least one executed test in the current Coldbox runner job')
    p = sub.add_parser('run', help="run a local repo's or a GitHub commit's checks, or -- COMMAND, in a throwaway VM "
                                   'and write a receipt',
                       usage='coldbox run [-h] [--offline] [--ttl TTL] [--cpus N] [--memory SIZE] [--receipts DIR] '
                             '[[--trusted-suite FILE [--verify-job ID]] [path] | '
                             '--repo OWNER/REPO --sha SHA [--profile NAME] | -- COMMAND [ARG ...]]')
    p.add_argument('path', nargs='?')
    p.add_argument('--repo', type=repo_name, help='clone this GitHub repo in the VM, with a read-only token for it alone')
    p.add_argument('--sha', type=commit_sha, help='the full commit SHA to clone with --repo')
    p.add_argument('--profile', help='select a named verification profile from the requested commit')
    p.add_argument('--trusted-suite', type=Path, metavar='FILE',
                   help='observe a host-selected JSON suite on a local checkout or a PR base and head')
    p.add_argument('--verify-job', type=int, metavar='ID',
                   help=f'publish {HOST_SUITE_CHECK} for this GitHub Actions verify job')
    p.add_argument('--offline', action='store_true', help='give the VM no network at all')
    p.add_argument('--ttl', type=int, default=3600, help='VM lifetime limit in seconds (default 3600)')
    p.add_argument('--cpus', type=vcpus, help="this VM's vCPU count instead of the coldbox profile's")
    p.add_argument('--memory', type=vm_size, help="this VM's memory, e.g. 8GiB, up to the coldbox profile's")
    p.add_argument('--receipts', metavar='DIR',
                   help=f"write the receipt to DIR instead of {STATE / 'receipts'}; for stress and test runs")
    p.add_argument('--name', type=submission_id, help=argparse.SUPPRESS)
    p = sub.add_parser('shell', help="open an offline throwaway VM with a local repo's HEAD in ~/repo; "
                       'it is destroyed when the shell exits')
    p.add_argument('--repo', required=True, metavar='PATH', help='the local git checkout to copy in')
    p.add_argument('--ttl', type=int, default=3600, help='VM lifetime limit in seconds (default 3600)')
    p.add_argument('--receipts', metavar='DIR', help=argparse.SUPPRESS)
    p.set_defaults(offline=True, cpus=None, memory=None)
    api = sub.add_parser('api', help='submit a GitHub commit to run in the background, then read its status and receipt'
                         ).add_subparsers(dest='action', required=True)
    api.add_parser('version', help='print the execution interface and backend as JSON')
    p = api.add_parser('submit', help='start run --repo --sha in the background; print {"id", "state", "receipt"} as JSON')
    p.add_argument('--repo', type=repo_name, required=True)
    p.add_argument('--sha', type=commit_sha, required=True)
    p.add_argument('--profile', help='select a named verification profile from the requested commit')
    for action, text in (('status', 'print {"id", "state", "receipt"} as JSON; state is queued, running, done or failed'),
                         ('receipt', 'print the receipt once done and exit as run would; 75 while queued or running'),
                         ('evidence', 'print the versioned terminal evidence record with the receipt exit code')):
        api.add_parser(action, help=text).add_argument('id', type=submission_id)
    for name, text in (('serve', 'run ephemeral runners for a repo or org in a loop'),
                       ('register', 'start a coldbox runner service for a repo or org')):
        p = sub.add_parser(name, help=text)
        p.add_argument('target', help='OWNER/REPO or ORG')
        p.add_argument('--allow-public', action='store_true',
                       default=name == 'serve' and os.environ.get('COLDBOX_ALLOW_PUBLIC') == '1',
                       help='serve a public repo you own: write users run at once, fork pull requests never')
        if name == 'register':
            p.add_argument('--slots', type=int, default=None,
                           help='job VMs that may run at once (default 1, or 0 when the host cannot admit one)')
            p.add_argument('--allow-personal-login', action='store_true',
                           help='without a GitHub App, use your gh login, which can do anything its account can')
        else:
            p.add_argument('--slots', type=int, default=int(os.environ.get('COLDBOX_SLOTS', '1')),
                           help='job VMs that may run at once (default 1)')
        if name == 'serve':
            p.add_argument('--once', action='store_true', help='stop after one VM')
            p.add_argument('--ttl', type=int, default=21600, help='VM lifetime limit in seconds (default 21600)')
            p.add_argument('--worker', action='store_true', help=argparse.SUPPRESS)
            p.add_argument('--idle', type=int, default=0, help=argparse.SUPPRESS)
            p.add_argument('--name', help=argparse.SUPPRESS)
            p.add_argument('--standby', action='store_true', help=argparse.SUPPRESS)
            p.add_argument('--size', choices=SIZES, default='default', help=argparse.SUPPRESS)
    p = sub.add_parser('unregister', help="stop the runner service and delete this host's coldbox runners on GitHub")
    p.add_argument('target')
    p = sub.add_parser('reap', help='delete job VMs past their TTL or without a live worker, finalize their receipts, and delete old receipts')
    p.add_argument('--keep-days', type=int, default=KEEP_DAYS, help='delete receipts older than this; 0 keeps all')
    vm = sub.add_parser('vm', help='a disposable VM to use by hand: up, exec, down, list').add_subparsers(
        dest='action', required=True)
    p = vm.add_parser('up', help='start a VM from base-dev/warm and print its name')
    p.add_argument('--ttl', type=int, default=7200, help='seconds before the reaper deletes it (default 7200)')
    net = p.add_mutually_exclusive_group()
    net.add_argument('--offline', action='store_true', help='give the VM no network at all')
    net.add_argument('--network', metavar='NAME', help=f'put eth0 on this Incus network instead of {BRIDGE}; '
                     f'it must be listed in {VM_ALLOW} as "network NAME"')
    p.add_argument('--here', action='store_true', help='start it on this host only, never on another CI host')
    p.add_argument('--image', metavar='INSTANCE/SNAPSHOT', help=f'start from this snapshot in the {PROJECT} project '
                   f'instead of {BASE}; it must be listed in {VM_ALLOW} as "image INSTANCE/SNAPSHOT"')
    p.add_argument('--cpus', type=vcpus, help="this VM's vCPU count instead of the coldbox profile's")
    p.add_argument('--memory', type=vm_size, help="this VM's memory, e.g. 8GiB, up to the coldbox profile's")
    p.add_argument('--disk', type=vm_size, help="this VM's root disk, e.g. 40GiB, up to the coldbox profile's")
    p = vm.add_parser('exec', help='run a command in the VM as runner; stdin and stdout pass through')
    p.add_argument('name')
    p.add_argument('command', nargs='+')
    vm.add_parser('down', help='delete the VM').add_argument('name')
    vm.add_parser('list', help='list ad-hoc VMs')
    p = sub.add_parser('status', help='health checks, merge enforcement, runners, job VMs and recent receipts')
    p.add_argument('--json', action='store_true', help='print the health report as JSON')
    p.add_argument('--hosts', action='store_true', help=f'one row per host in {CI_HOSTS}: build, verdict, orphans, '
                   'last receipt and jobs in the last 24 h, with build, queue and merge enforcement findings '
                   '(check only this host without that file)')
    p = sub.add_parser('pool', help='the warm pool of standby VMs for CI jobs: status').add_subparsers(
        dest='action', required=True).add_parser(
        'status', help='configured and ready standby VMs, their stamp and age, pending teardowns and hit, miss and '
        'reap counts; reads only')
    p.add_argument('--json', action='store_true', help='print the report as JSON')
    p = sub.add_parser('setup-app', help='set up least-privilege GitHub App auth: print the steps, then install its key (sudo)')
    p.add_argument('--org', help='create the App under this organization (for org-wide runners)')
    p.add_argument('--sole-member', help='expected sole member for public repos served by this organization App')
    p.add_argument('--app-id', help='the numeric App ID shown after creating the App')
    p.add_argument('--key', help='the private key .pem downloaded from the App settings')
    p = sub.add_parser('stats', help='outcomes, queue wait, boot, job time, slowest steps and host load from recent receipts')
    p.add_argument('--since', type=window, default=window('1h'), help='how far back to look, e.g. 30m, 1h, 7d (default 1h)')
    p.add_argument('--receipts', metavar='DIR', action='append',
                   help=f"read receipts from DIR instead of {STATE / 'receipts'}; repeat to combine hosts")
    p.add_argument('--json', action='store_true', help='print the summary as JSON')
    p = sub.add_parser('selftest', help='prove in a job VM that isolation and the profile limits hold; writes a receipt')
    p.add_argument('suite', choices=['isolation'])
    p.add_argument('--ttl', type=int, default=3600, help='VM lifetime limit in seconds (default 3600)')
    p.add_argument('--receipts', metavar='DIR',
                   help=f"write the receipt to DIR instead of {STATE / 'receipts'}")
    p = sub.add_parser('build-base', help='rebuild base-dev/warm with current packages and actions-runner (sudo)')
    p.add_argument('--rollback', action='store_true', help='restore the previous base without rebuilding')
    sub.add_parser('acl', help='print the network ACL that install.sh applies')
    p = sub.add_parser('admission-check', help='validate this guest CI admission record')
    p.add_argument('--expected-primary', required=True)
    p.add_argument('--overflow-host', nargs='?', action='append', help=argparse.SUPPRESS)
    sub.add_parser('job-started', help="runner hook: refuse fork PRs and outside users' jobs, and record the job")
    p = sub.add_parser('junit', help='print per-test results from JUnit XML reports, and ColdVerify test counts, under DIRs as JSON')
    p.add_argument('--newer', help='only reports modified after this file; git-tracked reports are always skipped')
    p.add_argument('--archived', help='file listing paths copied in from git archive; those are skipped too')
    p.add_argument('dirs', nargs='+')
    args = parser.parse_args(words)
    if args.cmd == 'run':
        args.command = command
        if args.profile is not None and not (args.repo and args.sha):
            parser.error('--profile needs --repo and --sha')
        if args.trusted_suite and (args.repo or args.sha or command):
            parser.error('--trusted-suite needs a local checkout')
        if args.verify_job is not None and (not args.trusted_suite or not 0 < args.verify_job < 2**63):
            parser.error('--verify-job needs --trusted-suite and a positive GitHub Actions job ID')
    if words is not argv and not command:
        parser.error('run --: give a command to run')
    if args.cmd in INCUS_COMMANDS:
        incus_group_exec(argv)
    try:
        if args.cmd == 'checks':
            out = os.environ.get('COLDBOX_JOB_DIR')
            return run_checks(args.path, out and Path(out) / 'checks.json', args.profile)
        if args.cmd == 'require-tests':
            return require_tests(Path.cwd(), Path(os.environ.get('COLDBOX_JOB_DIR', GUEST_JOB_DIR)))
        if args.cmd == 'acl':
            print(json.dumps(acl_document(host_addresses()), indent=2))
            return 0
        if args.cmd == 'admission-check':
            return admission_check(args)
        if args.cmd == 'job-started':
            code = 1
            try:
                code = job_started()
            finally:
                if code:
                    subprocess.run(['pkill', '-KILL', '-x', 'Runner.Worker'], check=False)
            return code
        if args.cmd == 'build-base':
            signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
        if args.cmd == 'junit':
            print(json.dumps(dict(junit_summary(args.dirs, args.newer, args.archived),
                                  cold_verify=cold_verify_counts(args.dirs, args.newer, args.archived))))
            return 0
        if args.cmd in ('status', 'stats', 'pool') and args.json:
            try:
                return dict(status=status, stats=stats, pool=pool_cmd)[args.cmd](args)
            except (OSError, ValueError, LookupError, TypeError, AttributeError, OverflowError, ConfigError,
                    RuntimeError, subprocess.SubprocessError) as error:
                return json_incomplete(error)
        return dict(api=api_cmd, detect=detect_cmd, run=run_repo if args.cmd == 'run' and (args.repo or args.sha) else run_adhoc if command else run_local, serve=serve, register=register, unregister=unregister,
                    reap=reap, status=status, stats=stats, shell=shell, selftest=selftest, **{'setup-app': setup_app}, vm=vm_cmd, **{'build-base': build_base}, pool=pool_cmd)[args.cmd](args)
    except ConfigError as error:
        print(f'coldbox: {error}', file=sys.stderr)
        return 2
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f'coldbox: {error}', file=sys.stderr)
        return 125


if __name__ == '__main__':
    sys.exit(main())
