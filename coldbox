    os.setxattr(folder, EXPIRES, str(expires).encode())


def ic(*args, **kwargs):
    return subprocess.run(['incus', '--force-local', '--project', PROJECT, *args], check=True, text=True,
                          stdin=subprocess.DEVNULL, capture_output=True, **kwargs).stdout


def ic_exec(name, *command, user=RUNNER, cwd=None, env=(), timeout=None):
    prefix = ['timeout', '--signal=KILL', str(max(1, int(timeout)))] if timeout else []
    args = ['incus', '--force-local', '--project', PROJECT, 'exec', name, '--mode', 'non-interactive']
    if user:
        args += ['--env', f'HOME=/home/{user}']
        command = ('runuser', '-u', user, '--', *command)
    if cwd:
        args += ['--cwd', cwd]
    for item in env:
        args += ['--env', item]
    return prefix + args + ['--', *command]


class ConsoleLog:
    def __init__(self, file, observe=None):
        self.file = file
        self.observe = observe
        self.stdout = None
        self.total = 0
        self.head = (CONSOLE_BYTES - len(CONSOLE_MARKER)) // 2
        self.tail_size = CONSOLE_BYTES - self.head - len(CONSOLE_MARKER)
        self.tail = None

    def write(self, data):
        if self.observe:
            self.observe(data)
        if self.stdout is not None and self.total < self.head:
            self.stdout.write(data[:self.head - self.total])
            self.stdout.flush()
        room = max(0, CONSOLE_BYTES - self.total)
        self.total += len(data)
        if room:
            self.file.write(data[:room])
        if len(data) > room:
            if self.tail is None:
                self.file.seek(-self.tail_size, os.SEEK_END)
                self.tail = collections.deque(self.file.read(self.tail_size), maxlen=self.tail_size)
                self.file.seek(self.head)
                self.file.write(CONSOLE_MARKER)
                self.file.truncate()
            self.tail.extend(data[room:][-self.tail_size:])
        self.flush()

    def flush(self):
        self.file.flush()

    def finish(self):
        if self.tail is not None:
            self.file.write(bytes(self.tail))
        self.flush()
        if self.stdout is not None and self.total > self.head:
            self.file.seek(self.head)
            shutil.copyfileobj(self.file, self.stdout)
            self.stdout.flush()


def tee(command, log, data=None):
    proc = subprocess.Popen(command, stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if data is not None:
        proc.stdin.write(data)
        proc.stdin.close()
    output = sys.stdout.buffer
    if log.observe is not None and not output.isatty():
        log.stdout = output
    with proc.stdout:
        for chunk in iter(lambda: proc.stdout.read1(CONSOLE_CHUNK), b''):
            log.write(chunk)
            if log.stdout is None:
                output.write(chunk)
                output.flush()
    return proc.wait()


def isolated(name, offline, bridge=BRIDGE):
    vm = query(f'/1.0/instances/{name}?project={PROJECT}')
    devices, config = vm.get('expanded_devices', {}), vm.get('expanded_config', {})
    root, nic = devices.get('root', {}), devices.get('eth0', {})
    problems = []
    if vm.get('type') != 'virtual-machine':
        problems.append('not a VM')
    if set(devices) != {'root', 'eth0'}:
        problems.append(f'unexpected devices {sorted(devices)}')
    if root.get('type') != 'disk' or root.get('path') != '/' or root.get('source'):
        problems.append('root disk is not a plain pool volume')
    if offline and nic.get('type') != 'none':
        problems.append('offline VM still has a NIC')
    if not offline and (nic.get('type') != 'nic' or nic.get('network') != bridge
                        or nic.get('security.port_isolation') != 'true'):
        problems.append(f'NIC is not on the isolated {bridge} bridge')
    if any(key.startswith('raw.') for key in config):
        problems.append('raw.* config present')
    if problems:
        raise RuntimeError('Refusing unsafe VM: ' + '; '.join(problems))


BOOT_SECONDS = 300
STOPPED_SECONDS = 30
FAST_POLL_SECONDS = 30


def wait_ready(name, expires, network, restarts=3):
    fast_until = time.time() + FAST_POLL_SECONDS
    boot_deadline = time.time() + BOOT_SECONDS
    stopped_since = None
    while subprocess.run(ic_exec(name, 'true', user=None, timeout=10), capture_output=True).returncode:
        if time.time() > expires:
            raise RuntimeError('VM agent not ready before TTL')
        if query(f'/1.0/instances/{name}?project={PROJECT}')['status'] != 'Stopped':
            stopped_since = None
        elif stopped_since is None:
            stopped_since = time.time()
        if (stopped_since is not None and time.time() - stopped_since > STOPPED_SECONDS) or time.time() > boot_deadline:
            stopped_since = None
            if not restarts:
                raise RuntimeError('VM agent not ready after restarts')
            restarts -= 1
            subprocess.run(['incus', '--force-local', '--project', PROJECT, 'stop', name, '--force'],
                           capture_output=True)
            subprocess.run(['incus', '--force-local', '--project', PROJECT, 'start', name], capture_output=True)
            boot_deadline = time.time() + BOOT_SECONDS
        time.sleep(0.15 if time.time() < fast_until else 1)
    if network:
        code = subprocess.run(ic_exec(name, 'cloud-init', 'status', '--wait', user=None,
                                      timeout=expires - time.time()), capture_output=True).returncode
        if code not in (0, 2):
            raise RuntimeError(f'cloud-init failed in VM (exit {code})')


def pull(name, path):
    result = subprocess.run(['incus', '--force-local', '--project', PROJECT, 'file', 'pull', f'{name}{path}', '-'],
                            capture_output=True, text=True, timeout=10)
    return json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None


def destroy(name, attempts=3, stop_sampling=None):
    def run(*args):
        command = ['incus', '--force-local', '--project', PROJECT, *args]
        if stop_sampling is None:
            return subprocess.run(command, capture_output=True)
        with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE) as process:
            try:
                stdout, stderr = process.communicate(timeout=2)
            except subprocess.TimeoutExpired:
                stop_sampling()
                stdout, stderr = process.communicate()
            return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)

    for attempt in range(attempts):
        if attempt:
            time.sleep(5)
        run('delete', name, '--force')
        info = run('info', name)
        if info.returncode != 0 and b'Instance not found' in info.stderr:
            return True
    return False


def pool_sample():
    endpoint = f'/1.0/storage-pools/{POOL}'
    pool = query(endpoint, timeout=1)
    if pool['driver'] != 'zfs':
        return None
    users = frozenset(pool['used_by'])
    used = query(f'{endpoint}/resources', timeout=1)['space']['used']
    if type(used) is int and used >= 0:
        return users, used


def destroy_job(name):
    target = f'/1.0/instances/{name}?project={PROJECT}'
    bases = {f'/1.0/instances/{base}?project={PROJECT}' for base in ('base-dev', 'base-prev')}
    elapsed = 0
    attempts = 3
    with contextlib.ExitStack() as locks:
        before = None
        try:
            for lockname in ('build-base.lock', 'autoscale.lock'):
                lock = locks.enter_context((STATE / lockname).open('rb'))
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            workers = STATE / 'workers'
            if not unreadable_live_workers(workers) and all(w.name == name for w in live_workers(workers, prune=False)):
                sample = pool_sample()
                if sample is not None:
                    users, used = sample
                    if target in users and all(user in bases or user == target or
                                               user.startswith(('/1.0/profiles/', '/1.0/images/')) for user in users):
                        before = users - {target}, used
        except UNREADABLE:
            pass
        if before is not None:
            def stop_sampling():
                nonlocal before
                before = None
                locks.close()

            started = time.monotonic()
            attempts -= 1
            gone = destroy(name, attempts=1, stop_sampling=stop_sampling)
            elapsed = time.monotonic() - started
            if gone:
                reclaimed = None
                with contextlib.suppress(*UNREADABLE):
                    if before is not None and (after := pool_sample()) is not None \
                            and before[0] == after[0] and before[1] > after[1]:
                        reclaimed = before[1] - after[1]
                return gone, reclaimed, elapsed
    started = time.monotonic()
    if attempts < 3:
        time.sleep(5)
        gone = destroy(name, attempts=attempts)
    else:
        gone = destroy(name)
    return gone, None, elapsed + time.monotonic() - started


def note_teardown(name, pid=None):
    pid = os.getpid() if pid is None else pid
    folder = STATE / 'teardown'
    folder.mkdir(parents=True, exist_ok=True)
    staged = folder / f'.{name}.{pid}.{threading.get_ident()}'
    staged.write_text(json.dumps([pid, process_start(pid), name]))
    os.replace(staged, folder / name)


def clear_teardown(name):
    (STATE / 'teardown' / name).unlink(missing_ok=True)


def tearing_down(folder=None, prune=True):
    folder = STATE / 'teardown' if folder is None else folder
    if not folder.is_dir():
        return set()
    active = set()
    for record in folder.glob('cbx-*'):
        try:
            fields = json.loads(record.read_text())
            pid, start, name = fields if isinstance(fields, list) and len(fields) == 3 else (None, None, None)
        except (OSError, ValueError, TypeError):
            pid = start = name = None
        if type(pid) is int and pid > 0 and isinstance(start, str) and start and name == record.name \
                and process_start(pid) == start:
            active.add(name)
        elif prune:
            record.unlink(missing_ok=True)
    return active


class TeardownReaper:
    def __init__(self, max_workers=TEARDOWN_MAX_WORKERS, max_pending=TEARDOWN_MAX_PENDING):
        if max_workers < 1 or max_pending < max_workers:
            raise ValueError('max_workers must be >= 1 and max_pending >= max_workers')
        self._max_workers = max_workers
        self._max_pending = max_pending
        self._lock = threading.Lock()
        self._cond = threading.Condition(self._lock)
        self._queue = collections.deque()
        self._active = 0
        self._workers = 0
        self._threads = []
        self._closed = False
        self.failures = 0

    def pending(self):
        with self._lock:
            return self._active + len(self._queue)

    def submit(self, name, task):
        note_teardown(name)
        run_sync = False
        with self._cond:
            while not self._closed and self._active + len(self._queue) >= self._max_pending:
                self._cond.wait()
            if self._closed:
                run_sync = True
            else:
                self._queue.append((name, task))
                self._threads = [thread for thread in self._threads if thread.is_alive()]
                if self._workers < self._max_workers:
                    self._workers += 1
                    thread = threading.Thread(target=self._run, daemon=True)
                    self._threads.append(thread)
                    thread.start()
                self._cond.notify()
        if run_sync:
            try:
                task()
            finally:
                clear_teardown(name)

    def _run(self):
        while True:
            with self._cond:
                if not self._queue:
                    self._workers -= 1
                    self._cond.notify_all()
                    return
                name, task = self._queue.popleft()
                self._active += 1
            try:
                task()
            except Exception as error:
                with self._lock:
                    self.failures += 1
                print(f'coldbox: async teardown failed for {name}: {error}', file=sys.stderr, flush=True)
            finally:
                clear_teardown(name)
                with self._cond:
                    self._active -= 1
                    self._cond.notify_all()

    def drain(self, timeout=None, *, close=False):
        deadline = None if timeout is None else time.monotonic() + timeout
        with self._cond:
            if close:
                self._closed = True
                self._cond.notify_all()
            while self._active or self._queue:
                if deadline is not None:
                    left = deadline - time.monotonic()
                    if left <= 0:
                        return False
                    self._cond.wait(left)
                else:
                    self._cond.wait()
            threads = list(self._threads)
        for thread in threads:
            left = None if deadline is None else max(0.0, deadline - time.monotonic())
            thread.join(left)
        with self._lock:
            self._threads = [thread for thread in self._threads if thread.is_alive()]
            return not self._active and not self._queue


def get_teardown_reaper():
    global TEARDOWN_REAPER
    if TEARDOWN_REAPER is None or TEARDOWN_REAPER._closed:
        TEARDOWN_REAPER = TeardownReaper()
    return TEARDOWN_REAPER


def wait_for_teardowns(close=False):
    global TEARDOWN_REAPER
    if TEARDOWN_REAPER is not None:
        TEARDOWN_REAPER.drain(close=close)
        if close:
            TEARDOWN_REAPER = None


def lifecycle(expires):
    return '--config', f'{MANAGED}=true', '--config', f'{EXPIRES}={expires}'


def managed(vm):
    config = vm.get('config') or {}
    expires = config.get(EXPIRES, '')
    readable = expires == 'never' or expires.isdigit()
    return readable and (config.get(MANAGED) == 'true' or vm['name'].startswith('cbx-'))


def boot(name, expires, offline, *config, base=BASE, bridge=BRIDGE, disk=None):
    sync_acl()
    copy_started = time.time()
    ic('copy', base, name, *lifecycle(expires), *config)
    clone_seconds = round(time.time() - copy_started, 3)
    if offline:
        ic('config', 'device', 'add', name, 'eth0', 'none')
    if not offline and (bridge != BRIDGE or base != BASE):
        ic('config', 'device', 'override', name, 'eth0', f'network={bridge}')
    if disk:
        vm = query(f'/1.0/instances/{name}?project={PROJECT}')
        if vm['expanded_devices'].get('root', {}).get('pool') != POOL:
            raise RuntimeError(f'Refusing unsafe VM: root disk is not on the {POOL} pool')
        ic('config', 'device', 'set' if 'root' in vm.get('devices', {}) else 'override', name, 'root', f'size={disk}')
    isolated(name, offline, bridge)
    start = time.time()
    ic('start', name)
    wait_ready(name, expires, network=not offline)
    return dict(clone_seconds=clone_seconds, boot_seconds=round(time.time() - start, 3))


UNREADABLE = (OSError, ValueError, KeyError, TypeError, IndexError, ArithmeticError, subprocess.SubprocessError)
RESOURCE_FIELDS = ('cpus', 'memory_bytes', 'peak_rss_bytes', 'cpu_seconds', 'disk_read_bytes', 'disk_write_bytes')


def cpu_count(limit):
    """`limits.cpu` is a count such as 8 or a pinned set such as 0-3,8."""
    if limit.isdigit():
        return int(limit)
    cpus = set()
    for part in limit.split(','):
        first, _, last = part.partition('-')
        cpus.update(range(int(first), int(last or first) + 1))
    return len(cpus)


def vm_resources(name):
    """What the VM was given and used, read just before it is destroyed. A value that can't be read is null."""
    def read(path):
        return subprocess.run(['incus', '--force-local', 'query', path], check=True, capture_output=True, text=True,
                              timeout=10).stdout

    found = dict.fromkeys(RESOURCE_FIELDS)
    try:
        config = json.loads(read(f'/1.0/instances/{name}?project={PROJECT}'))['expanded_config']
    except UNREADABLE:
        config = {}
    try:
        found['cpus'] = cpu_count(config['limits.cpu'])
    except UNREADABLE:
        pass
    try:
        found['memory_bytes'] = size_bytes(config['limits.memory'])
    except UNREADABLE:
        pass
    try:
        state = json.loads(read(f'/1.0/instances/{name}/state?project={PROJECT}'))
        found['cpu_seconds'] = round(state['cpu']['usage'] / 1e9, 3)
        peak = re.search(r'^VmHWM:\s+(\d+) kB$', Path(f"/proc/{int(state['pid'])}/status").read_text(), re.M)
        found['peak_rss_bytes'] = int(peak[1]) * 1024
    except UNREADABLE:
        pass
    try:
        metrics = read(f'/1.0/metrics?project={PROJECT}')
        disk = collections.defaultdict(dict)
        for kind, device, value in re.findall(
                r'^incus_disk_(read|written)_bytes_total\{device="([^"]+)",name="' + re.escape(name) + r'",[^}]*\} (\S+)$',
                metrics, re.M):
            if re.fullmatch(r'(?!loop)[a-z]+', device):
                disk[device][kind] = int(float(value))
        if disk and all(kinds.keys() == {'read', 'written'} for kinds in disk.values()):
            found['disk_read_bytes'] = sum(kinds['read'] for kinds in disk.values())
            found['disk_write_bytes'] = sum(kinds['written'] for kinds in disk.values())
    except UNREADABLE:
        pass
    return found


def extract_artifacts(folder, max_bytes, max_files):
    folder, max_bytes, max_files, files, total = Path(folder), int(max_bytes), int(max_files), 0, 0
    with tarfile.open(fileobj=sys.stdin.buffer, mode='r|') as tar:
        for member in tar:
            inside = PurePosixPath(member.name)
            parts = [part for part in inside.parts if part != '.']
            if not member.isfile() or not parts or inside.is_absolute() or '..' in parts:
                continue
            if files == max_files or total + member.size > max_bytes:
                return
            target = folder.joinpath(*parts)
            try:
                target.parent.mkdir(parents=True, exist_ok=True)
                with tar.extractfile(member) as source, target.open('wb') as out:
                    shutil.copyfileobj(source, out)
            except BaseException:
                target.unlink(missing_ok=True)
                raise
            files, total = files + 1, total + member.size
            print(json.dumps(dict(path=str(target), bytes=member.size)), flush=True)
    print('complete', flush=True)


def copy_artifacts(name, folder):
    """Copies the regular files the job left in ARTIFACTS to folder. Returns them and whether every file was copied."""
    try:
        reader = subprocess.Popen(
            ic_exec(name, 'sh', '-c', f'mkdir -p {ARTIFACTS} && cd {ARTIFACTS} && exec tar --hard-dereference -c .'),
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return [], False
    timer = threading.Timer(ARTIFACT_SECONDS, reader.kill)
    timer.start()
    parser, lines = None, []
    try:
        parser = subprocess.run(
            ['prlimit', f'--as={ARTIFACT_MEMORY}', sys.executable, '-c',
             'import runpy, sys; runpy.run_path(sys.argv[1])["extract_artifacts"](*sys.argv[2:])',
             str(Path(__file__).resolve()), str(folder), str(ARTIFACT_BYTES), str(ARTIFACT_FILES)],
            stdin=reader.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            timeout=ARTIFACT_SECONDS)
        lines = parser.stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        pass
    finally:
        complete = parser is not None and parser.returncode == 0 and lines[-1:] == ['complete']
        if not complete:
            reader.kill()
        complete = reader.wait() == 0 and complete
        timer.cancel()
        reader.stdout.close()
    try:
        if Path(folder).is_dir():
            mark_folder(folder, int(time.time()) + KEEP_DAYS * 86400)
    except OSError:
        pass
    return [json.loads(line) for line in lines if line.startswith('{')], complete


def observe_suite(name, suite, cwd, expires, receipt, log):
    observation = receipt['suite_observation']
    tests = observation.get('tests')
    exit_key = 'head_exit' if 'base_receipt' in observation else 'base_exit'
    suite_passed = True
    for index, (argv, expected) in enumerate(suite, 1):
        left = expires - time.time()
        if left <= 0:
            receipt['error'] = 'TTL reached'
            return 125
        stdout = subprocess.DEVNULL if expected is None else subprocess.PIPE
        with subprocess.Popen(ic_exec(name, *argv, cwd=cwd, timeout=left), stdin=subprocess.DEVNULL,
                              stdout=stdout, stderr=subprocess.DEVNULL) as process:
            actual = None
            if process.stdout is not None:
                actual = process.stdout.read(len(expected) + 1)
                process.stdout.close()
            code = process.wait()
        if (tests is not None or len(actual) <= len(expected)) and (
                code < 0 or code in (124, 137, 255) or time.time() >= expires):
            receipt['error'] = 'TTL reached' if time.time() >= expires - 1 else f'suite case {index} ended with {code}'
            return 125
        observation['tests_ran'] = receipt['tests_ran'] = index
        passed = code == 0 and actual == expected
        log.write(f"Suite case {index}: {'PASS' if passed else 'FAIL'}\n".encode())
        if tests is not None:
            tests[index - 1][exit_key] = code
        elif not passed:
            observation['result'] = 'FAIL'
            return 1
        suite_passed = suite_passed and passed
    observation['result'] = 'PASS' if suite_passed else 'FAIL'
    return int(not suite_passed)


def job(mode, name, ttl, command, repo, sha=None, stdin=None, archive=None, offline=False, cwd=None, env=(),
        extra=None, receipts=None, on_ready=None, config=(), judge=None, clone=None, cache=None, suite=None,
        recheck_org=None, teardown=None, on_teardown=None, warm_claimed=False, pooled=False):
    global ACTIVE_LOG
    CLEANUP.clear()
    receipts = Path(receipts or STATE / 'receipts')
    receipts.mkdir(parents=True, exist_ok=True)
    path, log_path = receipts / f'{name}.json', receipts / f'{name}.log'
    started = time.time()
    expires = int(started + ttl)
    receipt = dict(schema='coldbox.receipt/v1', id=name, mode=mode, repo=repo, sha=sha, verdict='incomplete',
                   host=os.uname().nodename, checks=[], started_at=now_iso(), log=str(log_path), **(extra or {}),
                   vm=dict(name=name, image=BASE, ttl_seconds=ttl, offline=offline, destroyed=False))
    publishes_check = mode == 'runner' or bool(receipt.get('verify_job'))
    if mode == 'runner':
        receipt['job_result'] = None
    if publishes_check:
        receipt['verification'] = dict(state='pending')
    write_json(path, receipt, durable=publishes_check)
    guest_env = [f'COLDBOX_JOB_DIR={GUEST_JOB_DIR}', 'PIP_BREAK_SYSTEM_PACKAGES=1', *env]
    pending = b''
    interrupted = False

    def observe_runner(chunk):
        nonlocal pending
        lines, _, rest = (pending + chunk).rpartition(b'\n')
        pending = rest[-CONSOLE_CHUNK:]
        if b' completed with result: ' in lines:
            completed, result = job_outcome(lines)
            if result:
                receipt.update(job_name=completed, job_result=result)
                write_json(path, receipt)
                return
        if not receipt['job_result'] and b'Running job: ' in lines and (assigned := running_job(lines)):
            if recheck_org and not receipt.get('job_name'):
                decision = 'allow' if recheck_org() else 'deny'
                subprocess.run(ic_exec(name, 'touch', str(ORG_JOB_GATE / decision), user=None),
                               check=True, capture_output=True)
            receipt['job_name'] = assigned
            write_json(path, receipt)

    def finish_teardown(target_receipt):
        gone, reclaimed, destroy_seconds = destroy_job(name)
        (STATE / 'ready' / name).unlink(missing_ok=True)
        ended = time.time()
        target_receipt['vm'].update(destroyed=gone, destroyed_at=now_iso(), lifetime_seconds=round(ended - started, 3),
                                    destroy_seconds=round(destroy_seconds, 3))
        if reclaimed is not None:
            target_receipt['vm']['reclaimed_bytes'] = reclaimed
        target_receipt['seconds'] = round(ended - started, 3)
        collect_job_log_tests(target_receipt)
        settle(target_receipt)
        write_json(path, target_receipt, durable=publishes_check)
        if mode == 'runner' and 'exit' not in target_receipt and target_receipt.get('github'):
            record_queue_wait(target_receipt['github'], name)
            collect_job_log_tests(target_receipt)
            settle(target_receipt)
            write_json(path, target_receipt, durable=True)
        print(f"coldbox: outcome [{target_receipt['reason_code']}]", file=sys.stderr)
        print(f"coldbox: {target_receipt['verdict'].upper()} receipt {path}", file=sys.stderr)
        if on_teardown:
            on_teardown(target_receipt)

    with log_path.open('w+b') as file:
        log = ConsoleLog(file, observe_runner if mode == 'runner' else None)
        ACTIVE_LOG = log_path if mode == 'runner' else None
        try:
            if warm_claimed:
                timing = dict(clone_seconds=0.0, boot_seconds=0.0, warm_claimed=True)
            else:
                if pooled and warm_pool_on():
                    note_pool('miss', vm=name)
                timing = boot(name, expires, offline, *config)
            receipt['vm']['ready_seconds'] = round(time.time() - started, 3)
            if isinstance(timing, dict):
                receipt['vm'].update(timing)
            receipt['vm']['host_ceiling'] = host_cpus()
            write_json(path, receipt, durable=publishes_check)
            mark_ready(name)
            ic('file', 'push', str(Path(__file__).resolve()), f'{name}/usr/local/bin/coldbox', '--mode', '0755')
            if warm_claimed:
                try:
                    push_guest_files(name, mode=mode, strict_stamp=True)
                    note_pool('hit', vm=name)
                except WarmOverlayMismatch:
                    note_pool('reaped', vm=name, reason='unhealthy')
                    note_pool('miss', vm=name)
                    if not destroy(name):
                        raise RuntimeError(f'could not destroy stale warm VM {name}')
                    (STATE / 'ready' / name).unlink(missing_ok=True)
                    warm_claimed = False
                    timing = boot(name, expires, offline, *config)
                    receipt['vm']['ready_seconds'] = round(time.time() - started, 3)
                    receipt['vm'].pop('warm_claimed', None)
                    if isinstance(timing, dict):
                        receipt['vm'].update(timing)
                    write_json(path, receipt, durable=publishes_check)
                    mark_ready(name)
                    ic('file', 'push', str(Path(__file__).resolve()), f'{name}/usr/local/bin/coldbox', '--mode', '0755')
                    push_guest_files(name, mode=mode)
            else:
                push_guest_files(name, mode=mode)
            if cache:
                receipt['cache'] = cache_in(name, cache, 'npm')
                receipt['cache'].update({tool: cache_in(name, cache, tool) for tool in CACHES if tool != 'npm'})
                write_json(path, receipt, durable=publishes_check)
            if HOST_CHECKS.exists():
                ic('file', 'push', str(HOST_CHECKS), f'{name}{HOST_CHECKS}', '--create-dirs', '--mode', '0644')
            if archive is not None:
                extract = f'mkdir -p ~/repo && tar -x -v -C ~/repo | sed "s|^|$HOME/repo/|" > {ARCHIVED}'
                subprocess.run(ic_exec(name, 'bash', '-o', 'pipefail', '-c', extract), input=archive,
                               check=True, capture_output=True)
            if clone:
                subprocess.run(ic_exec(name, 'bash', '-o', 'pipefail', '-c', CLONE, 'clone',
                                       f'https://github.com/{clone[0]}', clone[1]),
                               input=clone[2].encode(), check=True, capture_output=True)
            subprocess.run(ic_exec(name, 'touch', JOB_STARTED), check=True, capture_output=True)
            if mode == 'runner':
                admission_path = receipts / f'{name}.admission'
                receipt['admission'] = runner_admission(repo, name, expires)
                write_json(path, receipt, durable=publishes_check)
                write_json(admission_path, receipt['admission'])
                ic('file', 'push', str(admission_path), f'{name}/etc/coldbox/admission.json',
                   '--create-dirs', '--mode', '0644')
                subprocess.run(ic_exec(name, 'sh', '-c', 'printf "%s\\n" "$1" > /etc/coldbox/host',
                                       'sh', receipt['admission']['host'], user=None), check=True, capture_output=True)
            if recheck_org:
                subprocess.run(ic_exec(name, 'mkdir', str(ORG_JOB_GATE), user=None), check=True, capture_output=True)
            if on_ready:
                on_ready()
            command_started = time.time()
            receipt['job_started_at'] = now_iso()
            write_json(path, receipt, durable=publishes_check)
            try:
                if mode == 'shell':
                    run = ic_exec(name, *command, cwd=cwd, env=guest_env)
                    run[run.index('non-interactive')] = 'auto'
                    code = subprocess.run(['timeout', '--foreground', '--signal=KILL',
                                           str(max(1, int(expires - time.time()))), *run], stdin=stdin).returncode
                    signal.signal(signal.SIGHUP, signal.SIG_IGN)
                    signal.signal(signal.SIGTERM, signal.SIG_IGN)
                elif suite is None:
                    code = tee(ic_exec(name, *command, cwd=cwd, env=guest_env, timeout=expires - time.time()), log, stdin)
                else:
                    code = observe_suite(name, suite, cwd, expires, receipt, log)
                receipt['job_seconds'] = round(time.time() - command_started, 3)
                receipt['job_ended_at'] = now_iso()
                receipt['exit'] = code
                if code in (124, 137) and time.time() >= expires - 1:
                    receipt['error'] = 'TTL reached'
            finally:
                if pending:
                    observe_runner(b'\n')
                if log.tail is not None:
                    receipt['console_truncated_bytes'] = log.total - CONSOLE_BYTES + len(CONSOLE_MARKER)
                log.finish()
                if suite is None:
                    try:
                        collect_tests(name, receipt, archive is not None or clone is not None)
                    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
                        receipt.setdefault('error', str(error) or type(error).__name__)
            if judge:
                judge(receipt, log_path)
            if mode == 'runner':
                receipt.setdefault('job_name', None)
                if github := receipt.get('github'):
                    record_queue_wait(github, name)
            if suite is None:
                result = pull(name, f'{GUEST_JOB_DIR}/checks.json')
                if ('profile' in receipt and code == 2 and result and result.get('verdict') == 'refused'
                        and result.get('cause') in ('unknown_profile', 'unauthorized_profile')):
                    receipt['profile_refusal'] = dict(cause=result['cause'], error=result['error'])
                elif result:
                    receipt.update(checks=result['checks'], checks_verdict=result['verdict'])
        except subprocess.CalledProcessError as error:
            stderr = error.stderr.decode() if isinstance(error.stderr, bytes) else error.stderr or ''
            receipt['error'] = f"{' '.join(map(str, error.cmd[:7]))} failed: {stderr.strip()[-500:]}"
        except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
            receipt['error'] = str(error) or type(error).__name__
        except (SystemExit, KeyboardInterrupt):
            interrupted = True
            receipt['error'] = 'stopped'
            raise
        finally:
            ACTIVE_LOG = None
            CLEANUP.set()
            receipt['resources'] = vm_resources(name)
            if suite is None and 'job_started_at' in receipt:
                folder = receipts / f'{name}.artifacts'
                artifacts, complete = copy_artifacts(name, folder)
                if artifacts or not complete:
                    receipt.update(artifacts=artifacts, artifacts_truncated=not complete)
                if folder.is_dir():
                    github = receipt.get('github') or {}
                    provenance = dict(owner='coldbox', job_id=name, repo=github.get('repo') or receipt['repo'],
                                      sha=github.get('sha') or receipt['sha'])
                    with contextlib.suppress(OSError):
                        os.setxattr(folder, PROVENANCE, json.dumps(provenance).encode())
            if mode == 'runner' and cache and 'job_started_at' in receipt and not receipt.get('error') \
                    and fills_cache(repo, name, receipt.get('runner_id'), receipt.get('github') or {}):
                for tool in CACHES:
                    fields = receipt['cache'] if tool == 'npm' else receipt['cache'][tool]
                    try:
                        fields.update(cache_out(name, cache, tool))
                    except (OSError, subprocess.SubprocessError) as error:
                        fields.update(out_bytes=0, out_refused=str(error))
            if publishes_check:
                try:
                    write_json(path, receipt, durable=True)
                except OSError as error:
                    print(f'coldbox: could not save evidence before destroying {name}: {error}', file=sys.stderr)
            if teardown is not None and not interrupted:
                file.flush()
                file.close()
                receipt['vm']['teardown'] = 'async'
                if not publishes_check:
                    with contextlib.suppress(OSError):
                        write_json(path, receipt)
                background = copy.deepcopy(receipt)
                teardown.submit(name, lambda: finish_teardown(background))
            else:
                finish_teardown(receipt)
    return receipt


def collect_tests(name, receipt, archived):
    timeout = 120 if 'exit' in receipt else 10
    try:
        github = None if 'profile' in receipt else pull(name, f'{GUEST_JOB_DIR}/job.json')
        if github:
            receipt.update(github=github, repo=github['repo'] or receipt['repo'], sha=github['sha'])
            if receipt['mode'] == 'runner':
                receipt['coldverify'] = strict_receipt(name, receipt['repo'], timeout)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
        receipt.setdefault('error', str(error) or type(error).__name__)
    strict = receipt.get('coldverify') or {}
    strict_count = strict.pop('tests_ran', None)
    if receipt.get('job_name') != 'verify':
        strict_count = None
    if strict_count is not None:
        receipt.update(tests_ran=strict_count, tests_source='cold-verify')
    tests = subprocess.run(ic_exec(name, 'coldbox', 'junit', '--newer', JOB_STARTED,
                                   *(['--archived', ARCHIVED] if archived else []),
                                   *JUNIT_DIRS[receipt['mode']], timeout=timeout),
                           capture_output=True, text=True)
    if tests.returncode == 0:
        summary = json.loads(tests.stdout)
        if not isinstance(summary, dict):
            raise ValueError('invalid test evidence summary')
        cold_verify = summary.pop('cold_verify', [])
        if strict_count is None:
            ran, source = tests_ran(summary, cold_verify)
            receipt['tests_source'] = source
            if ran is not None:
                receipt['tests_ran'] = ran
        if summary['files']:
            receipt['tests'] = summary


class LogRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlparse(newurl).scheme != 'https':
            raise urllib.error.HTTPError(newurl, code, 'refusing non-https redirect', headers, fp)
        moved = super().redirect_request(req, fp, code, msg, headers, newurl)
        if moved is not None:
            for header in list(moved.headers) + list(moved.unredirected_hdrs):
                if header.lower() in ('authorization', 'x-github-api-version', 'accept'):
                    moved.remove_header(header)
        return moved


def fetch_job_log(repo, job_id, retries=(1, 2)):
    path = f'repos/{repo}/actions/jobs/{int(job_id)}/logs'
    opener = urllib.request.build_opener(LogRedirect())
    for attempt in range(len(retries) + 1):
        token = app_token(path) or personal_login() or subprocess.run(
            ['gh', 'auth', 'token'], env=dict(os.environ, GH_HOST='github.com'),
            capture_output=True, text=True, check=True, timeout=60).stdout.strip()
        request = urllib.request.Request(
            f'https://api.github.com/{path}',
            headers={'Authorization': f'Bearer {token}', 'Accept': 'application/vnd.github+json',
                     'X-GitHub-Api-Version': '2022-11-28', 'User-Agent': 'coldbox'})
        try:
            with opener.open(request, timeout=30) as response:
                return response.read(JOB_LOG_BYTES).decode('utf-8', 'replace')
        except urllib.error.HTTPError as error:
            code = error.code
            error.close()
            if attempt < len(retries) and (code == 404 or 500 <= code < 600):
                time.sleep(retries[attempt])
                continue
            raise RuntimeError(f'GET {path}: HTTP {code}') from None


def clean_job_log_lines(text):
    lines, in_command = [], False
    for raw in text.splitlines():
        line = ANSI_ESCAPE.sub('', ACTIONS_TIMESTAMP.sub('', raw, count=1)).rstrip()
        if line.startswith('##[group]Run '):
            in_command = True
            continue
        if in_command:
            if line.startswith('##[endgroup'):
                in_command = False
            continue
        lines.append(line)
    return lines


def job_log_tests_ran(text):
    lines = clean_job_log_lines(text)
    found, total, index = False, 0, 0
    while index < len(lines):
        line = lines[index]
        if UNITTEST_RULE.fullmatch(line) and index + 1 < len(lines) and (ran := UNITTEST_RAN.fullmatch(lines[index + 1])):
            after = index + 2
            while after < len(lines) and (not lines[after] or lines[after].startswith('FAIL: ')):
                after += 1
            if after < len(lines):
                if lines[after] == 'NO TESTS RAN':
                    found = True
                    index = after + 1
                    continue
                if outcome := UNITTEST_RESULT.fullmatch(lines[after]):
                    skipped = int(skip[1]) if outcome[2] and (skip := UNITTEST_SKIPPED.search(outcome[2])) else 0
                    found = True
                    total += max(0, int(ran[1]) - skipped)
                    index = after + 1
                    continue
        if pytest := PYTEST_SUMMARY.fullmatch(line):
            items = [(int(count), kind) for count, kind in PYTEST_ITEM.findall(pytest[1])]
            if any(kind in PYTEST_EXECUTED or kind == 'skipped' for _, kind in items):
                found = True
                total += sum(count for count, kind in items if kind in PYTEST_EXECUTED)
        elif cargo := CARGO_SUMMARY.match(line):
            found = True
            total += int(cargo[1]) + int(cargo[2])
        elif GO_TEST_CASE.fullmatch(line):
            found = True
            total += 1
        index += 1
    return total if found else None


def collect_job_log_tests(receipt):
    if receipt.get('mode') != 'runner' or receipt.get('tests_source') is not None or receipt.get('tests_ran') != 0:
        return
    github = receipt.get('github') or {}
    repo, job_id = github.get('repo') or receipt.get('repo'), github.get('job_id')
    if not repo or '/' not in repo or type(job_id) is not int or job_id <= 0:
        return
    try:
        ran = job_log_tests_ran(fetch_job_log(repo, job_id))
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(f"coldbox: job log tests unavailable for {receipt.get('id')}: {error}", file=sys.stderr, flush=True)
        return
    if ran is not None:
        receipt.update(tests_ran=ran, tests_source='job-log')


def strict_receipt(name, repo, timeout=120):
    folder = repo.split('/')[-1]
    if not re.fullmatch(r'[A-Za-z0-9_.-]+', folder) or folder in ('.', '..'):
        return None
    checkout = f'/opt/actions-runner/_work/{folder}/{folder}'
    report = STRICT_REPORT
    try:
        found = pull(name, f'{checkout}/{report}')
    except ValueError:
        return None
    if not isinstance(found, dict):
        return None
    strict = {key: found.get(key) for key in STRICT_FIELDS}
    count = strict_test_count(found)
    if count is not None:
        fresh = subprocess.run(ic_exec(name, 'bash', '-c',
                                       'test -f "$3" && test "$1/$2" -nt "$3" && '
                                       'tracked=$(git -C "$1" ls-files -- "$2") && test -z "$tracked"',
                                       'bash', checkout, report, JOB_STARTED, timeout=timeout), capture_output=True)
        if fresh.returncode == 0:
            strict['tests_ran'] = count
    return strict


def tree_entry(tree, path):
    return next(((item['mode'], item['sha']) for item in tree['tree'] if item['path'] == path), None)


def runner_job(repo, name, since):
    runs = gh(f'repos/{repo}/actions/runs?event=pull_request&per_page=100')['workflow_runs']
    for run in runs:
        if datetime.fromisoformat(run['updated_at']) >= datetime.fromisoformat(since):
            for job in attempt_jobs(repo, run['id'], run.get('run_attempt') or 1):
                if job.get('runner_name') == name:
                    return job
    raise RuntimeError(f'GitHub lists no pull request job that ran on {name}')


def verify_revision(repo, job):
    run = gh(f"repos/{repo}/actions/runs/{int(job['run_id'])}")
    if run.get('event') != 'pull_request' or (run.get('path') or '').split('@')[0] != VERIFY_WORKFLOW:
        return None
    head = run['head_sha']
    tree_sha = gh(f'repos/{repo}/git/commits/{head}')['tree']['sha']
    head_tree, problems = gh(f'repos/{repo}/git/trees/{tree_sha}'), []
    pulls = run.get('pull_requests') or []
    if pulls:
        base_tree = gh(f"repos/{repo}/git/trees/{pulls[0]['base']['sha']}")
        changed = [path for path in CI_CONFIG if tree_entry(base_tree, path) != tree_entry(head_tree, path)]
        if changed:
            problems.append(f"the PR changes {' and '.join(changed)}, so this job did not run the base branch's CI "
                            'config; Coldbox vouches only for a job that did')
    else:
        problems.append("GitHub lists no pull request for this run, so the base branch's CI config could not be "
                        'compared')
    return run, head, tree_sha, problems


def verify_job_result(job, head, problems):
    if not job.get('head_sha'):
        problems.append('GitHub did not report the head of this verify job')
    elif job['head_sha'] != head:
        problems.append('the GitHub verify job head does not match the workflow run head')
    status, conclusion = job.get('status'), job.get('conclusion')
    if (status, conclusion) != ('completed', 'success'):
        problems.append(f'GitHub did not report a successful verify job ({status}, {conclusion})')


def post_verify_check(check_name, repo, head, tree, problems, success, evidence, receipt=None, path=None):
    summary = '; '.join(problems) or success
    if receipt and (code := receipt.get('reason_code')):
        ran = receipt.get('tests_ran', 'unknown')
        skipped = (receipt.get('tests') or {}).get('skipped', 0)
        summary = f'Coldbox receipt [{code}]. Tests run: {ran}, skipped: {skipped}.\n\n{summary}'
        evidence['reason_code'] = code
    text = json.dumps(evidence, indent=2)
    body = dict(name=check_name, head_sha=head, external_id=tree, status='completed',
                conclusion='failure' if problems else 'success',
                output=dict(title='FAIL' if problems else 'PASS', summary=summary[:CHECK_TEXT_LIMIT],
                            text=text[:CHECK_TEXT_LIMIT]))
    post_check_run(repo, body, receipt, path)
    return body


def post_check_run(repo, body, receipt=None, path=None, *, app_only=False):
    endpoint = f'repos/{repo}/check-runs'
    if app_only:
        return gh('-X', 'POST', endpoint, body=body, _retries=[0], _app_only=True)
    if path is None:
        return gh('-X', 'POST', endpoint, body=body)
    save_verification(path, receipt, state='sending', repo=repo, head=body['head_sha'], name=body['name'],
                      tree=body['external_id'], app_id=app_credentials(endpoint)[1])
    posted = gh('-X', 'POST', endpoint, body=body, _retries=[0])
    save_verification(path, receipt, state='posted', check_id=posted['id'])
    return posted


def verify_check(target, name, receipt, path=None, *, coldverify=None):
    github = receipt.get('github') or {}
    recovering = path is not None and 'reconciled_by' in receipt
    repo = receipt.get('repo') or ''
    if recovering and repo == target and '/' not in repo:
        try:
            repo = repo_name(github.get('repo') or '')
        except argparse.ArgumentTypeError:
            return None
    job_id = github.get('job_id')
    served = repo.casefold() == target.casefold() if '/' in target else \
        repo.split('/')[0].casefold() == target.casefold()
    recover_assignment = recovering and receipt.get('job_started_at') and not receipt.get('job_name')
    if not served or '/' not in repo or not (job_id or receipt.get('job_name') == 'verify' or recover_assignment):
        if receipt.get('job_name') == 'verify':
            raise RuntimeError(f'could not tell which repository verify job {name} ran for')
        return None
    job = gh(f'repos/{repo}/actions/jobs/{int(job_id)}') if job_id else runner_job(repo, name, receipt['started_at'])
    if job.get('runner_name') != name or job.get('name') != 'verify':
        return None
    if recovering and (type(receipt.get('runner_id')) is not int or receipt['runner_id'] <= 0
                       or type(job.get('runner_id')) is not int or job['runner_id'] != receipt['runner_id']):
        raise RuntimeError('the GitHub job could not be matched to the registered runner ID')
    revision = verify_revision(repo, job)
    if revision is None:
        return None
    run, head, tree_sha, problems = revision
    runner_id = receipt.get('runner_id')
    github_runner_id = job.get('runner_id')
    if type(github_runner_id) is not int or github_runner_id <= 0:
        problems.append('GitHub did not report the runner ID for this verify job')
    elif type(runner_id) is not int or runner_id <= 0:
        problems.append('the host receipt did not record a registered runner ID')
    elif github_runner_id != runner_id:
        problems.append('the GitHub verify job ran on a different runner ID')
    verify_job_result(job, head, problems)
    if receipt.get('verdict') != 'pass':
        why = receipt.get('reason') or receipt.get('cause') or receipt.get('error')
        problems.append(f"the Coldbox job ended {receipt.get('verdict')}" + (f' ({why})' if why else ''))
    strict = receipt.get('coldverify')
    if not strict:
        problems.append('the verify job left no ColdVerify receipt at .cold/verify-receipt.json in its checkout '
                        '(strict ColdVerify must run inside the verify job)')
    else:
        if strict.get('result') != 'PASS':
            problems.append(f"ColdVerify {strict.get('result')}: {strict.get('reason')}")
        commit = strict.get('commit')
        commit_tree = tree_sha
        if commit != head:
            try:
                merge = gh(f'repos/{repo}/git/commits/{commit}') \
                    if isinstance(commit, str) and re.fullmatch(r'[0-9a-f]{40}', commit) else {}
            except RuntimeError:
                merge = {}
            parents = [parent['sha'] for parent in merge.get('parents', [])]
            commit_tree = (merge.get('tree') or {}).get('sha')
            if len(parents) != 2 or head not in parents:
                problems.append(f'the ColdVerify receipt is for commit {commit}, not the head {head} or its '
                                'merge commit')
        if strict.get('result') == 'PASS':
            if not commit_tree or not strict.get('tree'):
                problems.append('the ColdVerify receipt tree could not be verified against its commit')
            elif strict['tree'] != commit_tree:
                problems.append('the ColdVerify receipt tree does not match its commit')
    posted = post_verify_check(VERIFY_CHECK, repo, head, tree_sha, problems, f'ColdVerify PASS for head tree {tree_sha}',
                               dict(coldbox_receipt=receipt.get('id'), job=job.get('html_url'), coldverify=strict),
                               receipt, path)
    if (coldverify and repo.casefold() == target.casefold() and receipt['vm']['destroyed'] is True
            and type(runner_id) is int and runner_id > 0 and type(github_runner_id) is int
            and github_runner_id == runner_id
            and job.get('status') == 'completed' and job.get('head_sha') == head):
        start_coldverify(coldverify, repo, job, run, head, tree_sha)
    return posted


def publish_verify(target, name, receipt):
    if 'verification' in receipt:
        if receipt['vm']['destroyed']:
            finish_receipt_check(STATE / 'receipts' / f'{name}.json', receipt, target,
                                 coldverify=os.environ.get('COLDBOX_COLDVERIFY_HOST'))
        return
    try:
        posted = verify_check(target, name, receipt)
    except (OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
        print(f'coldbox: {VERIFY_CHECK} not posted for {name}: {error}', file=sys.stderr, flush=True)
        return
    if posted:
        print(f"coldbox: {VERIFY_CHECK} {posted['conclusion']} on {posted['head_sha']}: "
              f"{posted['output']['summary']}", file=sys.stderr, flush=True)


def coldverify_environment():
    try:
        build = build_id(loaded=True)
        instance, name = BASE.split('/')
        snapshot = query(f'/1.0/instances/{instance}/snapshots/{name}?project={PROJECT}', timeout=10)
        config = snapshot['config']
        if (not build or not re.fullmatch(r'[0-9a-f]{64}', config['volatile.base_image'])
                or not config['volatile.uuid'] or not snapshot['created_at']):
            return None
        image = {field: snapshot[field] for field in ('created_at', 'architecture', 'expanded_config', 'expanded_devices')}
        overlay = [hashlib.sha256(part).hexdigest() for part in pack_guest_files()] if GUEST_FILES.is_dir() else []
        checks = hashlib.sha256(HOST_CHECKS.read_bytes()).hexdigest() if HOST_CHECKS.exists() else None
        inputs = (build, BASE, config['volatile.base_image'], config['volatile.uuid'], image, overlay, checks)
        return hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest()
    except (*UNREADABLE, RuntimeError, SyntaxError):
        return None


def reusable_coldverify_check(repo, number, base, head, fingerprint, claim):
    claim_sha = claim.get('sha256') if isinstance(claim, dict) else None
    builders = claim.get('builders') if isinstance(claim, dict) else None
    if (not isinstance(claim_sha, str) or not re.fullmatch(r'[0-9a-f]{64}', claim_sha)
            or not isinstance(builders, list)
            or not all(isinstance(builder, str) and builder.strip() for builder in builders)):
        print('coldbox: coldverify receipt fresh: no trusted claim source', file=sys.stderr, flush=True)
        return None
    if not fingerprint['environment']:
        return None
    tree = fingerprint['tree']
    try:
        if app_credentials(f'repos/{repo}')[1] != str(COLDVERIFY_APP):
            return None
        parameters = urllib.parse.urlencode(dict(check_name=COLDVERIFY_CHECK, app_id=COLDVERIFY_APP,
                                                  filter='all', per_page=100))
        for page in itertools.count(1):
            checks = gh(f'repos/{repo}/commits/{head}/check-runs?{parameters}&page={page}',
                        _app_only=True, _retries=[0])['check_runs']
            for check in checks:
                try:
                    if (check['app']['id'], check['name'], check['head_sha'], check['external_id'],
                            check['status'], check['conclusion']) != (
                            COLDVERIFY_APP, COLDVERIFY_CHECK, head, tree, 'completed', 'success'):
                        continue
                    output = check['output']
                    if (type(check['id']) is not int or check['id'] < 1
                            or output['summary'].startswith(COLDVERIFY_REUSED)):
                        continue
                    prior = json.loads(output['text'])
                    if (prior['result'], prior['pull_request'], prior['commit'], prior['tree'],
                            prior['repro']['base'], prior['repro']['head'], prior['repro']['backend'],
                            prior['risk']['tier'], prior['fingerprint']) != (
                            'PASS', number, head, tree, base, head, 'coldbox', 'normal', fingerprint):
                        continue
                    if prior['command'] != ['coldverify', '--host-receipt', str(number), base, head]:
                        continue
                    prior_claim = prior['claim']
                    if (not isinstance(prior_claim, str) or not prior_claim.strip()
                            or hashlib.sha256(prior_claim.encode()).hexdigest() != claim_sha
                            or prior['builders'] != builders):
                        continue
                except (AttributeError, KeyError, TypeError, ValueError):
                    continue
                source = f"https://github.com/{repo}/runs/{check['id']}"
                summary = f'{COLDVERIFY_REUSED}[{source}]({source}). This delivery booted no host suite VMs.\n\n'
                return dict(name=COLDVERIFY_CHECK, head_sha=head, external_id=tree, status='completed',
                            conclusion='success', details_url=source,
                            output=dict(title=f'PASS for tree {tree}', text=output['text'],
                                        summary=(summary + output['summary'])[:CHECK_TEXT_LIMIT]))
            if len(checks) < 100:
                return None
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return None


def stamp_coldverify_environment(result, fingerprint):
    if result.returncode != 0:
        return result
    try:
        check = json.loads(result.stdout)
        output = check['output']
        receipt = json.loads(output['text'])
        if receipt['fingerprint'] != dict(fingerprint, environment=None):
            return result
    except (KeyError, TypeError, ValueError):
        return result
    receipt['fingerprint'] = fingerprint
    text = json.dumps(receipt, indent=2)
    if len(text) <= CHECK_TEXT_LIMIT:
        output['text'] = text
        result.stdout = json.dumps(check).encode()
    return result


def run_coldverify(host, repo, number, base, head, tree):
    command = ['ssh', '-T', '-a', '-x', '-S', 'none', '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes',
               '-o', 'IdentityAgent=none',
               '-o', 'ClearAllForwardings=yes', '-o', 'StrictHostKeyChecking=yes', '--', host,
               'host-receipt', repo, str(number), base, head]
    manifest = subprocess.run([*command, 'manifest'], stdin=subprocess.DEVNULL, capture_output=True, timeout=300)
    if manifest.returncode == 2:
        return manifest
    if manifest.returncode:
        raise RuntimeError(f'Coldverify manifest exited {manifest.returncode}')
    if len(manifest.stdout) > CHECK_TEXT_LIMIT:
        raise RuntimeError('Coldverify manifest exceeds the size limit')
    with tempfile.TemporaryDirectory(prefix='coldbox-coldverify-') as directory:
        folder = Path(directory)
        checkout = folder / 'repo.git'
        suite_path = folder / 'suite.json'
        suite_path.write_bytes(manifest.stdout)
        suite, digest, suite_base, tests = load_trusted_suite(suite_path)
        if suite_base != base:
            raise RuntimeError('the Coldverify manifest does not match the verify job base')
        environment = coldverify_environment()
        fingerprint = dict(tree=tree, recipe=digest, environment=environment)
        reused = reusable_coldverify_check(repo, number, base, head, fingerprint, json.loads(manifest.stdout).get('claim'))
        if reused and coldverify_environment() == environment:
            return subprocess.CompletedProcess(command, 0, json.dumps(reused).encode())
        token = repo_token(repo)
        if not token:
            raise RuntimeError(NO_APP)
        auth = base64.b64encode(f'x-access-token:{token}'.encode()).decode()
        fetch_env = dict(os.environ, GIT_TERMINAL_PROMPT='0', GIT_CONFIG_COUNT='1', GIT_CONFIG_KEY_0='http.extraHeader',
                         GIT_CONFIG_VALUE_0=f'Authorization: Basic {auth}')
        git(folder, 'init', '--bare', '--quiet', '--template=', str(checkout))
        git(checkout, 'remote', 'add', 'origin', f'https://github.com/{repo}.git')
        subprocess.run(['git', '-C', str(checkout), 'fetch', '--no-tags', 'origin', base, head],
                       env=fetch_env, capture_output=True, check=True, timeout=300)
        if git(checkout, 'rev-parse', f'{head}^{{tree}}').decode().strip() != tree:
            raise RuntimeError('the fetched head does not match the verify job tree')
        args = argparse.Namespace(ttl=3600, offline=True, receipts=None, cpus=None, memory=None)
        observation = suite_observation(head, tree, digest)
        before, after = run_paired_trusted_suite(args, checkout, repo, observation, suite, base, tests)
        if after is None or not (before['vm']['destroyed'] and after['vm']['destroyed']):
            raise RuntimeError('the host suite did not finish and destroy both VMs')
        stable_environment = environment and coldverify_environment() == environment
        pair = json.dumps(dict(base=before, head=after)).encode()
        result = subprocess.run([*command, 'receipt'], input=pair, capture_output=True, timeout=600)
        return stamp_coldverify_environment(result, fingerprint) if stable_environment else result


def start_coldverify(host, repo, job, run, head, tree):
    try:
        repo_name(repo)
        pulls = run.get('pull_requests') or []
        if len(pulls) != 1 or (run.get('head_repository') or {}).get('full_name', '').casefold() != repo.casefold():
            return
        pull = pulls[0]
        number, base, attempt = pull['number'], pull['base']['sha'], run.get('run_attempt')
        if (type(number) is not int or number < 1 or type(attempt) is not int or attempt < 1
                or type(job.get('run_attempt')) is not int or job['run_attempt'] != attempt or pull['head']['sha'] != head
                or not all(isinstance(sha, str) and re.fullmatch(r'[0-9a-f]{40}', sha) for sha in (base, head, tree))):
            raise RuntimeError('the verify job did not identify a current PR attempt and its revisions')
        arguments = json.dumps([host, repo, int(job['run_id']), attempt, number, base, head, tree])
        child = ('import json, runpy, sys\n'
                 'coldbox = runpy.run_path(sys.argv[1])\n'
                 'coldbox["stop_on_signals"]()\n'
                 'coldbox["publish_coldverify"](*json.loads(sys.argv[2]))\n')
        on_main = threading.current_thread() is threading.main_thread()
        previous = signal.signal(signal.SIGTERM, lambda *_: DRAINING.set()) if on_main else None
        try:
            child_proc = subprocess.Popen(
                [sys.executable, '-I', '-c', child, str(Path(__file__).resolve()), arguments],
                stdin=subprocess.DEVNULL, start_new_session=True)
            with COLDVERIFY_LOCK:
                COLDVERIFY_CHILDREN.append(child_proc)
        finally:
            if on_main:
                signal.signal(signal.SIGTERM, previous)
    except (OSError, ValueError, KeyError, TypeError, argparse.ArgumentTypeError, RuntimeError) as error:
        print(f'coldbox: {COLDVERIFY_CHECK} not started on {head}: {error}', file=sys.stderr, flush=True)


def publish_coldverify(host, repo, run_id, attempt, number, base, head, tree):
    try:
        result = run_coldverify(host, repo, number, base, head, tree)
        if len(result.stdout) > 18 * CHECK_TEXT_LIMIT + 1024:
            raise RuntimeError('Coldverify check payload exceeds the size limit')
        body = json.loads(result.stdout)
        verdict = {0: 'PASS', 1: 'FAIL', 2: 'INCOMPLETE'}.get(result.returncode)
        output = body['output']
        if (verdict is None or
                (body['name'], body['head_sha'], body['external_id'], body['status'], body['conclusion']) !=
                (COLDVERIFY_CHECK, head, tree, 'completed', 'success' if verdict == 'PASS' else 'failure')
                or not all(isinstance(output[key], str) and output[key] for key in ('title', 'summary', 'text'))
                or json.loads(output['text'])['result'] != verdict):
            raise RuntimeError('Coldverify returned an inconsistent check payload')
        active = gh(f'repos/{repo}/actions/runs/{run_id}', _app_only=True)
        if (active.get('head_sha'), active.get('run_attempt')) != (head, attempt):
            raise RuntimeError('the verify job attempt or head changed before publication')
        check = post_check_run(repo, body, app_only=True)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        print(f'coldbox: {COLDVERIFY_CHECK} not posted on {head}: could not obtain a valid host receipt',
              file=sys.stderr, flush=True)
    except SystemExit as error:
        if error.code != RUN_WAIT_ERROR:
            raise
        print(f'coldbox: {COLDVERIFY_CHECK} not posted on {head}: {error}', file=sys.stderr, flush=True)
    except (ConfigError, RuntimeError) as error:
        print(f'coldbox: {COLDVERIFY_CHECK} not posted on {head}: {error}', file=sys.stderr, flush=True)
    else:
        print(f"coldbox: {COLDVERIFY_CHECK} {verdict} on {head}: {check.get('html_url', '')}",
              file=sys.stderr, flush=True)


def job_outcome(log):
    found = re.findall(rb'Job (.+) completed with result: (\w+)', log)
    return tuple(part.decode(errors='replace') for part in found[-1]) if found else (None, None)


def running_job(log):
    found = re.findall(rb'Running job: (.+)', log)
    return found[-1].decode(errors='replace').strip() if found else None


def failed_test_gate(receipt):
    if receipt.get('job_result') != 'Failed' or receipt.get('tests_ran') or receipt.get('error'):
        return False
    tests = receipt.get('tests') or {}
    if tests.get('failed') or tests.get('error'):
        return False
    steps = (receipt.get('github') or {}).get('steps', [])
    return [step.get('name') for step in steps if step.get('conclusion') == 'failure'] == ['Run coldbox require-tests']


def verdict(receipt):
    if not receipt['vm']['destroyed']:
        return 'incomplete'
    if observation := receipt.get('suite_observation'):
        return 'incomplete' if receipt.get('error') else observation['result'].lower()
    if receipt.get('profile_refusal') or (receipt.get('github') or {}).get('refused'):
        return 'refused'
    if receipt.get('checks_verdict') == 'fail' or (receipt.get('isolation') or {}).get('problems'):
        return 'fail'
    if receipt.get('job_result') == 'Failed':
        return 'incomplete' if failed_test_gate(receipt) else 'fail'
    if receipt.get('error'):
        idle = (receipt['mode'] == 'runner' and 'github' not in receipt and not receipt.get('job_name')
                and receipt['error'] in ('TTL reached', IDLE_RELEASED, 'stopped'))
        return 'idle' if idle else 'incomplete'
    if receipt['mode'] == 'runner' and receipt.get('github'):
        if receipt.get('job_result') == 'Succeeded':
            return 'pass' if receipt.get('tests_ran') else 'incomplete'
        if receipt.get('job_result') == 'Canceled':
            return 'canceled'
    if receipt['mode'] == 'local' and receipt.get('checks_verdict') == 'pass' and receipt.get('exit') == 0:
        return 'pass' if receipt.get('tests_ran') else 'incomplete'
    if receipt['mode'] in ('adhoc', 'shell') and 'exit' in receipt:
        return 'pass' if receipt['exit'] == 0 else 'fail'
    return 'incomplete'


def cause(receipt):
    if receipt['verdict'] == 'refused' and 'profile_refusal' in receipt:
        return receipt['profile_refusal']['cause']
    if receipt['verdict'] == 'fail':
        failed = next((check['check'] for check in receipt.get('checks', []) if check['status'] == 'fail'), None)
        return failed or ('checks' if receipt.get('checks_verdict') == 'fail' else 'job')
    if receipt['verdict'] != 'incomplete':
        return None
    error = receipt.get('error')
    if error in ('stopped', 'worker_interrupted'):
        return error
    if 'ready_seconds' not in receipt['vm']:
        return 'vm_not_ready'
    if error:
        return 'ttl' if error == 'TTL reached' else 'infra_error'
    if not receipt['vm']['destroyed']:
        return 'vm_not_destroyed'
    return 'no_tests' if failed_test_gate(receipt) or verdict(dict(receipt, tests_ran=1)) == 'pass' else 'no_result'


def reason_code(receipt):
    result, error = receipt['verdict'], receipt.get('error')
    if result in ('pass', 'canceled', 'refused', 'idle'):
        return result
    if not receipt['vm']['destroyed']:
        return 'infra_error'
    tests, source = receipt.get('tests') or {}, receipt.get('tests_source')
    failed_tests = source == 'junit' and (tests.get('failed', 0) or tests.get('error', 0))
    failed_suite = (receipt.get('suite_observation') or {}).get('result') == 'FAIL'
    if result == 'fail' and (failed_tests or failed_suite):
        return 'test_failed'
    if error:
        return 'canceled' if error == 'stopped' and result == 'incomplete' else 'infra_error'
    no_checks = receipt.get('checks_verdict') == 'fail' and not receipt.get('checks')
    if (result == 'incomplete' and receipt.get('cause') == 'no_tests') or (
            result == 'fail' and not receipt.get('tests_ran') and no_checks):
        return missing_test_reason(tests, source)
    if result == 'fail':
        return 'check_failed'
    return 'unfinished'


def settle(receipt):
    receipt['verdict'] = verdict(receipt)
    receipt.pop('cause', None)
    receipt.pop('reason', None)
    if found := cause(receipt):
        receipt['cause'] = found
    if found == 'no_tests':
        receipt['reason'] = NO_TESTS if receipt.get('tests_ran') == 0 else 'the test count could not be read'
    receipt['reason_code'] = reason_code(receipt)
    receipt.pop('tests_missing_reason', None)
    if receipt['verdict'] == 'incomplete' and not receipt.get('tests_ran') and not receipt.get('tests'):
        if receipt.get('tests_ran') is None:
            receipt['tests_missing_reason'] = 'test_count_unavailable'
        elif not receipt.get('tests_source'):
            receipt['tests_missing_reason'] = 'no_test_report'


def git(path, *args):
    return subprocess.run(['git', '-C', str(path), *args], check=True, capture_output=True).stdout


def admit_or_wait(target, name, memory, submissions=None):
    deadline = time.monotonic() + RUN_WAIT_SECONDS
    while not admit(target, name, 'once', memory=memory, submissions=submissions, sample_cpu=True):
        if yield_warm_job() and admit(target, name, 'once', memory=memory, submissions=submissions, sample_cpu=True):
            return
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            if submissions is not None:
                with host_lock():
                    waiting_submissions(submissions, timed_out=name)
            raise SystemExit(RUN_WAIT_ERROR)
        print('coldbox: the host is at its job VM ceiling; waiting', file=sys.stderr, flush=True)
        time.sleep(min(AUTOSCALE_SECONDS, remaining))


def load_trusted_suite(path):
    try:
        raw = path.read_bytes()
        cases = json.loads(raw)
        base, tests = None, None
        if isinstance(cases, dict):
            base = cases.get('base')
            if not isinstance(base, str) or not re.fullmatch(r'[0-9a-f]{40}', base):
                raise ValueError('base must be a full commit SHA')
            tests, grouped, names = [], [], set()
            for group in ('proof', 'suite'):
                entries = cases.get(group)
                if not isinstance(entries, list) or not entries:
                    raise ValueError(f'{group} must be a nonempty array of cases')
                for case in entries:
                    name = case.get('name') if isinstance(case, dict) else None
                    if not isinstance(name, str) or not name.strip() or name in names:
                        raise ValueError('each named case needs a unique nonempty name')
                    names.add(name)
                    tests.append(dict(name=name, group=group))
                    grouped.append(case)
            cases = grouped
        elif not isinstance(cases, list) or not cases:
            raise ValueError('expected a nonempty array of cases')
        suite = []
        for index, case in enumerate(cases, 1):
            argv = case.get('argv') if isinstance(case, dict) else None
            if not isinstance(argv, list) or not argv or not argv[0] or not all(
                    isinstance(arg, str) and '\0' not in arg for arg in argv):
                raise ValueError(f'case {index} needs a nonempty argv array of strings')
            expected = case.get('stdout')
            if (tests is None or 'stdout' in case) and not isinstance(expected, str):
                raise ValueError(f'case {index} needs expected stdout as a string')
            suite.append((argv, None if expected is None else expected.encode()))
    except (OSError, ValueError) as error:
        raise ConfigError(f'trusted suite {path}: {error}') from error
    return suite, hashlib.sha256(raw).hexdigest(), base, tests


def selected_verify_job(repo, job_id, suite_sha256):
    if not app_token(f'repos/{repo}'):
        raise ConfigError('--verify-job needs a GitHub App installation on the host')
    guard(repo, False)
    actions_job = gh(f'repos/{repo}/actions/jobs/{job_id}')
    if actions_job.get('id') != job_id or actions_job.get('name') != 'verify':
        raise ConfigError('--verify-job must identify a verify job in the checkout repository')
    revision = verify_revision(repo, actions_job)
    if revision is None:
        raise ConfigError('--verify-job must identify a pull request job in the verify workflow')
    run, head, tree, problems = revision
    if ((run.get('head_repository') or {}).get('full_name') or '').casefold() != repo.casefold():
        raise ConfigError('--verify-job needs a pull request from the same repository')
    attempt = actions_job.get('run_attempt')
    if type(attempt) is not int or attempt < 1 or attempt != run.get('run_attempt'):
        problems.append('the GitHub verify job does not match the current run attempt')
    runner_id = actions_job.get('runner_id')
    if type(runner_id) is not int or runner_id < 1 or not (actions_job.get('runner_name') or '').startswith('cbx-'):
        problems.append('GitHub did not identify a Coldbox runner for the selected verify job')
    verify_job_result(actions_job, head, problems)
    return dict(repo=repo, id=job_id, run_id=actions_job['run_id'], run_attempt=attempt, runner_id=runner_id,
                url=actions_job.get('html_url'), commit=head, tree=tree, suite_sha256=suite_sha256), problems


def publish_suite_check(verify_job, problems, name=None, receipt=None, path=None):
    observation = None
    if receipt is None:
        if not problems:
            problems.append('the host suite observation has unknown provenance')
    else:
        observation = receipt.get('suite_observation')
        if receipt.get('id') != name or receipt.get('verify_job') != verify_job or (
                not isinstance(observation, dict) or observation.get('schema') != 'coldbox.suite-observation/v1'):
            problems.append('the host suite observation has unknown provenance')
        elif receipt.get('repo') != verify_job['repo'] or receipt.get('sha') != verify_job['commit'] or any(
                observation.get(key) != verify_job[key] for key in ('commit', 'tree')):
            problems.append('the host suite observation does not match the selected revision')
        elif observation.get('suite_sha256') != verify_job['suite_sha256']:
            problems.append('the host suite observation does not match the selected suite')
        elif receipt.get('verdict') != 'pass' or observation.get('result') != 'PASS':
            why = receipt.get('error') or receipt.get('cause') or observation.get('result')
            problems.append(f"the host suite ended {receipt.get('verdict')} ({why})")
        elif type(observation.get('tests_ran')) is not int or observation['tests_ran'] < 1:
            problems.append('the host suite observation recorded no executed tests')
    repo, head, tree = verify_job['repo'], verify_job['commit'], verify_job['tree']
    if not problems:
        try:
            run = gh(f"repos/{repo}/actions/runs/{verify_job['run_id']}")
        except (OSError, RuntimeError, ValueError):
            problems.append('the GitHub verify job attempt could not be rechecked before publication')
        else:
            if (run.get('run_attempt'), run.get('head_sha')) != (verify_job['run_attempt'], head):
                problems.append('the GitHub verify job attempt or head changed before publication')
    check = post_verify_check(HOST_SUITE_CHECK, repo, head, tree, problems,
                              f'Strict host suite PASS for head tree {tree}',
                              dict(coldbox_receipt=name, verify_job=verify_job, suite_observation=observation),
                              receipt, path)
    print(f"coldbox: {HOST_SUITE_CHECK} {check['conclusion']} on {check['head_sha']}: "
          f"{check['output']['summary']}", file=sys.stderr, flush=True)
    return 1 if problems else 0


def save_verification(path, receipt, **verification):
    write_json(path, dict(receipt, verification=verification), durable=True)
    receipt['verification'] = verification


def find_sent_check(receipt):
    sent = receipt['verification']
    if not sent['app_id']:
        return None
    repo, head = sent['repo'], sent['head']
    query = urllib.parse.urlencode(dict(check_name=sent['name'], app_id=sent['app_id'], filter='all', per_page=100))
    page = 1
    while True:
        checks = gh(f'repos/{repo}/commits/{head}/check-runs?{query}&page={page}')['check_runs']
        for check in checks:
            if check.get('external_id') != sent['tree'] or str((check.get('app') or {}).get('id')) != sent['app_id']:
                continue
            try:
                evidence = json.loads((check.get('output') or {}).get('text') or '')
            except ValueError:
                continue
            if isinstance(evidence, dict) and evidence.get('coldbox_receipt') == receipt['id']:
                return check
        if len(checks) < 100:
            return None
        page += 1


def finish_receipt_check(path, receipt, target=None, *, coldverify=None):
    name = receipt['id']
    error_types = (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError)
    reason = 'no GitHub check applies to this run'
    if receipt['verification']['state'] == 'pending':
        try:
            if verify_job := receipt.get('verify_job'):
                return publish_suite_check(verify_job, [], name, receipt, path)
            if receipt['mode'] == 'runner':
                target = target or (receipt.get('admission') or {}).get('target') or receipt['repo']
                if target and (posted := verify_check(target, name, receipt, path, coldverify=coldverify)):
                    print(f"coldbox: {VERIFY_CHECK} {posted['conclusion']} on {posted['head_sha']}: "
                          f"{posted['output']['summary']}", file=sys.stderr, flush=True)
                    return 0
                reason = 'no matching GitHub pull request verify job could be identified'
        except error_types as error:
            print(f'coldbox: check not confirmed for {name}: {error}', file=sys.stderr, flush=True)
            reason = 'GitHub check publication failed before sending'
    if receipt['verification']['state'] == 'sending':
        try:
            check = find_sent_check(receipt)
        except error_types as error:
            print(f'coldbox: check lookup failed for {name}: {error}', file=sys.stderr, flush=True)
        else:
            if check is not None:
                save_verification(path, receipt, state='posted', check_id=check['id'])
                return int(check['conclusion'] != 'success')
        reason = 'GitHub check delivery could not be confirmed and retrying could create a duplicate'
    save_verification(path, receipt, state='not_posted', reason=reason)
    return 1


def run_local_revision(args, path, repo, sha, size, command, mode='local', **options):
    memory, config = sizing(args, size)
    pooled = not (config or args.offline or mode != 'local')
    claimed = claim_warm_job(repo, 'once', args.ttl, offline=False, memory=memory) if pooled else None
    if claimed:
        name = claimed
        fill_warm_pool_later()
    else:
        name = new_id()
        admit_or_wait(repo, name, memory)
    return job(mode, name, args.ttl, command, repo=repo, sha=sha,
               archive=git(path, 'archive', '--format=tar', sha), offline=args.offline,
               cwd='/home/runner/repo', receipts=args.receipts, config=config, pooled=pooled,
               **({'warm_claimed': True} if claimed else {}), **options)


def shell_stopped(signum, _):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    sys.exit(128 + signum)


def shell(args):
    path = Path(args.repo).resolve()
    sha = git(path, 'rev-parse', 'HEAD').decode().strip()
    terminal = os.dup(0)
    with open(os.devnull) as null:
        os.dup2(null.fileno(), 0)
    saved = termios.tcgetattr(terminal) if os.isatty(terminal) else None
    signal.signal(signal.SIGHUP, shell_stopped)
    signal.signal(signal.SIGTERM, shell_stopped)
    try:
        receipt = run_local_revision(args, path, path.name, sha, 'default', ['bash', '-l'], mode='shell',
                                     stdin=terminal)
    finally:
        if saved:
            with contextlib.suppress(termios.error):
                termios.tcsetattr(terminal, termios.TCSADRAIN, saved)
    return 125 if 'error' in receipt or 'exit' not in receipt or not receipt['vm']['destroyed'] else receipt['exit']


def run_trusted_revision(args, path, repo, observation, suite, **extra):
    return run_local_revision(args, path, repo, observation['commit'], 'default', [],
                              suite=suite, extra=dict(suite_observation=observation, tests_ran=0,
                                                      tests_source='host-suite', **extra))


def suite_observation(commit, tree, digest):
    return dict(schema='coldbox.suite-observation/v1', result='INCOMPLETE', tests_ran=0,
                commit=commit, tree=tree, suite_sha256=digest)


def run_paired_trusted_suite(args, path, repo, observation, suite, base, tests):
    try:
        base_commit, base_tree = git(path, 'rev-parse', f'{base}^{{commit}}', f'{base}^{{tree}}').decode().splitlines()
    except subprocess.CalledProcessError as error:
        raise ConfigError(f'trusted suite base {base} is missing from the checkout') from error
    if base == observation['commit'] or base_commit != base:
        raise ConfigError('trusted suite base must name a commit distinct from HEAD')
    base_observation = dict(observation, commit=base, tree=base_tree, tests=tests)
    before = run_trusted_revision(args, path, repo, base_observation, suite)
    if exit_code(before) == 125:
        return before, None
    observation.update(tests=[dict(test) for test in tests],
                       base_receipt=before['id'], base_commit=base, base_tree=base_tree)
    return before, run_trusted_revision(args, path, repo, observation, suite)


def run_local(args):
    path = Path(args.path or '.').resolve()
    sha = git(path, 'rev-parse', 'HEAD').decode().strip()
    remote = subprocess.run(['git', '-C', str(path), 'remote', 'get-url', 'origin'], capture_output=True, text=True)
    match = re.search(r'[:/]([^/:]+/[^/]+?)(\.git)?$', remote.stdout.strip())
    repo = match[1] if match else path.name
    suite_path = getattr(args, 'trusted_suite', None)
    if suite_path is None:
        if git(path, 'status', '--porcelain', '--', 'coldbox.toml').strip():
            raise SystemExit('coldbox: commit coldbox.toml first; the VM runs the committed HEAD')
        plan(path)
        size = load_config(path / 'coldbox.toml')[2] or 'default'
        return exit_code(run_local_revision(args, path, repo, sha, size, ['coldbox', 'checks']))
    suite, digest, base, tests = load_trusted_suite(suite_path)
    observation = suite_observation(sha, git(path, 'rev-parse', f'{sha}^{{tree}}').decode().strip(), digest)
    job_id = getattr(args, 'verify_job', None)
    if base is not None:
        if job_id is not None:
            raise ConfigError('--verify-job requires a single-revision suite')
        before, after = run_paired_trusted_suite(args, path, repo, observation, suite, base, tests)
        return exit_code(after if after is not None else before)
    if job_id is None:
        return exit_code(run_trusted_revision(args, path, repo, observation, suite))
    try:
        repo_name(repo)
    except argparse.ArgumentTypeError as error:
        raise ConfigError('--verify-job needs a GitHub repository as checkout origin') from error
    verify_job, problems = selected_verify_job(repo, job_id, digest)
    if (sha, observation['tree']) != (verify_job['commit'], verify_job['tree']):
        problems.append('the checkout does not match the selected verify job revision')
    if problems:
        return publish_suite_check(verify_job, problems)
    receipt = run_trusted_revision(args, path, repo, observation, suite, verify_job=verify_job)
    name = receipt['id']
    if 'verification' in receipt:
        if not receipt['vm']['destroyed']:
            return 1
        return finish_receipt_check(Path(args.receipts or STATE / 'receipts') / f'{name}.json', receipt)
    return publish_suite_check(verify_job, [], name, receipt)


def run_repo(args):
    if args.path is not None or args.command:
        raise SystemExit('coldbox: give --repo and --sha, a repo PATH, or -- COMMAND; not more than one')
    if not args.repo or not args.sha:
        raise SystemExit('coldbox: --repo and --sha go together')
    if args.offline:
        raise SystemExit('coldbox: --repo needs the network to clone; drop --offline')
    if args.name:
        stop_on_signals()
    memory, config = sizing(args)
    receipts = Path(args.receipts or STATE / 'receipts')
    pooled = not (config or args.name)
    claimed = claim_warm_job(args.repo, 'once', args.ttl, offline=False, memory=memory) if pooled else None
    if claimed:
        name = claimed
        fill_warm_pool_later()
    else:
        name = args.name or new_id()
        admit_or_wait(args.repo, name, memory, receipts / 'submissions' if args.name else None)
    command, extra = ['coldbox', 'checks'], {}
    profile = getattr(args, 'profile', None)
    if profile is not None:
        command.append(f'--profile={profile}')
        extra['profile'] = profile
    token = repo_token(args.repo)
    receipt = job('local', name, args.ttl, command, repo=args.repo, sha=args.sha, extra=extra,
                  clone=(args.repo, args.sha, token or ''), cwd='/home/runner/repo',
                  receipts=args.receipts, config=config, cache=direct_cache(args.repo, args.sha, token),
                  pooled=pooled, **({'warm_claimed': True} if claimed else {}))
    return exit_code(receipt)


def repo_name(text):
    if not re.fullmatch(r'[A-Za-z0-9-]+/[A-Za-z0-9._-]+', text) or text.split('/')[1] in ('.', '..'):
        raise argparse.ArgumentTypeError(f'{text!r} is not OWNER/REPO')
    return text


def commit_sha(text):
    if not re.fullmatch(r'[0-9a-f]{40}', text):
        raise argparse.ArgumentTypeError(f'{text!r} is not a full 40-character lowercase commit SHA')
    return text


def submission_id(text):
    if not re.fullmatch(r'cbx-[0-9]+-[0-9a-f]{6}-[a-z0-9-]+', text):
        raise argparse.ArgumentTypeError(f'{text!r} is not a cbx-... id from coldbox api submit')
    return text


def submission_stopped(signum, _):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    reason = f'coldbox: the submission worker got {signal.Signals(signum).name} and stopped'
    if CLEANUP.is_set():
        print(f'{reason} after its job; the receipt is still written', file=sys.stderr, flush=True)
        return
    sys.exit(reason)


def stop_on_signals():
    signal.signal(signal.SIGTERM, submission_stopped)
    signal.signal(signal.SIGHUP, submission_stopped)


def submission_worker(log_path):
    with contextlib.suppress(FileNotFoundError), log_path.open('rb') as log:
        try:
            fcntl.flock(log, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True
    return None


def submission_error(log_path, default):
    with contextlib.suppress(FileNotFoundError):
        lines = log_path.read_bytes()[-4000:].decode(errors='replace').strip().splitlines()
        if lines:
            return lines[-1]
    return default


def waiting_submissions(folder, timed_out=None):
    path = folder / 'queue.json'
    try:
        queue = json.loads(path.read_text())
    except FileNotFoundError:
        return []
    waiting = []
    for request in queue:
        name = request['id']
        result = folder / f'{name}.json'
        log = folder.parent / f'{name}.submit.log'
        if result.exists():
            continue
        live = submission_worker(log)
        if name == timed_out or live and time.time() >= request['deadline']:
            write_json(result, dict(cause='queue_timeout', error=RUN_WAIT_ERROR))
        elif not live:
            error = submission_error(log, 'the submission worker exited before admission')
            if error.endswith('; waiting') or error.startswith(('coldbox: no room for a job VM:',
                                                                'coldbox: storage pool ')):
                error = 'the submission worker exited before admission'
            write_json(result, dict(cause='worker_interrupted', error=error))
        else:
            waiting.append(request)
    if waiting != queue:
        write_json(path, waiting)
    return waiting


def api_submit(args, receipts):
    folder = receipts / 'submissions'
    name = new_id()
    settings = ('HOME', 'PATH', 'COLDBOX_INCUS_ENV', 'COLDBOX_STATE', 'COLDBOX_HOST_CHECKS',
                'COLDBOX_TOOLCACHE', 'COLDBOX_RESERVE', 'COLDBOX_GITHUB_APP_ENV', 'COLDBOX_GITHUB_APP_ID')
    env = {key: os.environ[key] for key in settings if key in os.environ}
    command = [sys.executable, str(Path(__file__).resolve()), 'run', '--repo', args.repo,
               '--sha', args.sha, '--name', name, '--receipts', str(receipts)]
    profile = getattr(args, 'profile', None)
    if profile is not None:
        command.append(f'--profile={profile}')
    with host_lock():
        folder.mkdir(parents=True, exist_ok=True)
        queue = waiting_submissions(folder)
        if len(queue) >= SUBMISSION_LIMIT:
            print(json.dumps(dict(state='refused', cause='queue_full', error='the submission queue is full')))
            return 75
        log_path = receipts / f'{name}.submit.log'
        with log_path.open('xb') as log:
            fcntl.flock(log, fcntl.LOCK_EX)
            request = dict(id=name, repo=args.repo, sha=args.sha, deadline=time.time() + RUN_WAIT_SECONDS)
            try:
                write_json(folder / 'queue.json', [*queue, request])
            except OSError:
                log_path.unlink(missing_ok=True)
                raise
            if os.fork() == 0:
                try:
                    os.setsid()
                    os.dup2(log.fileno(), 2)
                    with open(os.devnull, 'rb+') as devnull:
                        os.dup2(devnull.fileno(), 0)
                        os.dup2(devnull.fileno(), 1)
                    os.execve(sys.executable, command, env)
                except OSError as error:
                    print(f'coldbox: {type(error).__name__}: {error}', file=sys.stderr, flush=True)
                finally:
                    os._exit(125)
    print(json.dumps(dict(id=name, state='queued', receipt=str(receipts / f'{name}.json'))))
    return 0


def submission(receipts, name):
    path, log_path = receipts / f'{name}.json', receipts / f'{name}.submit.log'
    folder = receipts / 'submissions'
    found = dict(id=name, receipt=str(path))
    if folder.exists():
        with host_lock():
            waiting_submissions(folder)
            result = folder / f'{name}.json'
            if result.exists():
                return None, dict(found, state='failed', **json.loads(result.read_text()))
    waiting = submission_worker(log_path)
    try:
        receipt = json.loads(path.read_text())
    except FileNotFoundError:
        receipt = None
    if receipt is not None:
        done = 'destroyed_at' in receipt['vm']
        if 'profile' in receipt:
            found.update(profile=receipt['profile'], sha=receipt['sha'])
            if done and receipt['verdict'] == 'refused':
                found.update(receipt['profile_refusal'])
        return receipt, dict(found, state='done' if done else 'running', **({'verdict': receipt['verdict']} if done else {}))
    if waiting is None:
        raise SystemExit(f'coldbox: no submission {name} in {receipts}')
    if waiting:
        return None, dict(found, state='queued')
    return None, dict(found, state='failed', error=submission_error(log_path, 'the worker exited without a receipt'))


def api_cmd(args):
    if args.action == 'version':
        print(json.dumps(dict(interface=EXEC_INTERFACE, backend='coldbox')))
        return 0
    receipts = STATE / 'receipts'
    if args.action == 'submit':
        return api_submit(args, receipts)
    receipt, state = submission(receipts, args.id)
    if args.action == 'status':
        print(json.dumps(state))
        return 0
    if state['state'] == 'done':
        if args.action == 'evidence':
            print(json.dumps(dict(schema='coldbox.evidence/v1', interface=EXEC_INTERFACE, receipt=receipt)))
        else:
            print(json.dumps(receipt, indent=2))
        return exit_code(receipt)
    if state['state'] == 'failed':
        print(f"coldbox: {args.id} ended without a receipt: {state['error']}", file=sys.stderr)
        return 125
    print(f"coldbox: {args.id} is {state['state']}; ask again later", file=sys.stderr)
    return 75


def run_adhoc(args):
    if args.path is not None:
        raise SystemExit('coldbox: give a repo PATH or -- COMMAND, not both')
    memory, config = sizing(args)
    pooled = not (config or args.offline)
    claimed = claim_warm_job('adhoc', 'once', args.ttl, offline=False, memory=memory) if pooled else None
    if claimed:
