SELFTEST_CONTROL = ('api.github.com', 443)
SELFTEST_IPV6 = ('2606:4700:4700::1111', 443)
SELFTEST_MARK = 'coldbox-selftest '
SELFTEST_GUEST = r'''
import json, os, socket, sys
spec = json.load(sys.stdin)


def connect(probe):
    try:
        socket.create_connection((probe['address'], probe['port']), timeout=5).close()
        return dict(probe, error=None, errno=None)
    except OSError as error:
        return dict(probe, error=f'{type(error).__name__}: {error}', errno=error.errno)


fill, chunk, written, write_errno = os.path.expanduser('~/coldbox-selftest-fill'), bytes(64 * 2**20), 0, None
try:
    with open(fill, 'wb', buffering=0) as out:
        while written < spec['write_bytes']:
            written += out.write(chunk)
        os.fsync(out.fileno())
except OSError as error:
    write_errno = error.errno
finally:
    if os.path.exists(fill):
        os.remove(fill)
meminfo = open('/proc/meminfo').read()
root = os.stat('/').st_dev
disk = os.path.realpath(f'/sys/dev/block/{os.major(root)}:{os.minor(root)}')
if os.path.exists(f'{disk}/partition'):
    disk = os.path.dirname(disk)
found = dict(probes=[connect(probe) for probe in spec['probes']],
             cpus=len(os.sched_getaffinity(0)),
             memory_bytes=int(meminfo.split('MemTotal:')[1].split()[0]) * 1024,
             disk_bytes=int(open(f'{disk}/size').read()) * 512, written_bytes=written, write_errno=write_errno)
print('coldbox-selftest ' + json.dumps(found), flush=True)
'''


def isolation_probes(addresses, port):
    cgnat = ipaddress.ip_network('100.64.0.0/10')
    probes = [dict(kind='host', address=GATEWAY, port=port)]
    for interface in addresses:
        for addr in interface.get('addr_info', []):
            ip = ipaddress.ip_address(addr['local'].split('%')[0])
            if ip.is_loopback or (ip.version == 6 and ip.is_link_local):
                continue
            kind = 'ipv6' if ip.version == 6 else 'tailnet' if ip in cgnat else 'lan' if ip.is_private else 'host'
            probes.append(dict(kind=kind, address=str(ip), port=port))
    probes += [dict(kind='ipv6', address=SELFTEST_IPV6[0], port=SELFTEST_IPV6[1]),
               dict(kind='control', address=SELFTEST_CONTROL[0], port=SELFTEST_CONTROL[1])]
    unique = {}
    for probe in probes:
        unique.setdefault((probe['address'], probe['port']), dict(probe))
    return list(unique.values())


def isolation_problems(found, probes, expected):
    if not isinstance(found, dict):
        return ['the guest reported no results']
    if [(p['address'], p['port']) for p in found.get('probes', [])] != [(p['address'], p['port']) for p in probes]:
        return ['the guest did not report every probe']
    problems = []
    for probe in found['probes']:
        where = f"{probe['kind']} {probe['address']} port {probe['port']}"
        if probe['kind'] == 'control' and probe['error']:
            problems.append(f"{where} unreachable ({probe['error']}), so the blocked results prove nothing")
        elif probe['kind'] != 'control' and not probe['error']:
            problems.append(f'{where} was reachable')
        elif probe['kind'] == 'ipv6' and probe['errno'] != errno.ENETUNREACH:
            problems.append(f"{where} failed with {probe['error']}, not network unreachable, so the VM may route IPv6")
    if found['cpus'] != expected['cpus']:
        problems.append(f"nproc is {found['cpus']}, not the profile's {expected['cpus']}")
    if found['memory_bytes'] > expected['memory_bytes']:
        problems.append(f"MemTotal is {found['memory_bytes']} bytes, above the profile's {expected['memory_bytes']}")
    if found['disk_bytes'] > expected['disk_bytes']:
        problems.append(f"the root disk is {found['disk_bytes']} bytes, above the profile's {expected['disk_bytes']}")
    if found['write_errno'] != errno.ENOSPC:
        outcome = 'succeeded' if found['write_errno'] is None else f"failed with errno {found['write_errno']}, not ENOSPC"
        problems.append(f"a {expected['write_bytes'] / 2**30:g} GiB write {outcome}")
    return problems


def selftest_listener():
    try:
        sock = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        sock.bind(('::', 0))
    except OSError:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.bind(('0.0.0.0', 0))
    sock.listen(64)
    return sock


def selftest(args):
    expected = dict(cpus=cpu_count(ic('profile', 'get', 'coldbox', 'limits.cpu').strip()), memory_bytes=vm_memory(),
                    disk_bytes=vm_disk(), write_bytes=vm_disk() + 2**30)
    name = new_id()
    if not admit('selftest', name, 'once'):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    with selftest_listener() as listener:
        probes = isolation_probes(host_addresses(), listener.getsockname()[1])

        def judge(receipt, log_path):
            found = None
            for line in log_path.read_text(errors='replace').splitlines():
                if line.startswith(SELFTEST_MARK):
                    found = json.loads(line.removeprefix(SELFTEST_MARK))
            receipt['isolation'] = dict(expected=expected, found=found,
                                        problems=isolation_problems(found, probes, expected))

        receipt = job('adhoc', name, args.ttl, ['python3', '-c', SELFTEST_GUEST], repo='selftest',
                      stdin=json.dumps(dict(probes=probes, write_bytes=expected['write_bytes'])).encode(),
                      cwd=f'/home/{RUNNER}', extra=dict(command=['coldbox', 'selftest', 'isolation']),
                      receipts=args.receipts, judge=judge)
    for problem in (receipt.get('isolation') or {}).get('problems', []):
        print(f'coldbox selftest: FAIL {problem}', file=sys.stderr)
    return exit_code(receipt)


def sizing(args, size='default'):
    if args.memory and size_bytes(args.memory) > vm_memory():
        raise SystemExit(f"coldbox: --memory {args.memory} is above the coldbox profile's limits.memory; "
                         'it can only shrink a VM')
    memory, limits = vm_shape(size)
    limits.update({key: value for key, value in (('limits.cpu', args.cpus), ('limits.memory', args.memory)) if value})
    return size_bytes(args.memory) if args.memory else memory, incus_config(limits)


def vm_shape(size):
    """The memory admit() reserves for a VM of this size (None: the coldbox profile's) and its limits. small halves the
    profile's vCPUs and memory; large doubles them, up to this host's CPU threads and what one VM may take here."""
    if size == 'default':
        return None, {}
    memory, cpus = vm_memory(), cpu_count(ic('profile', 'get', 'coldbox', 'limits.cpu').strip())
    if size == 'small':
        cpus, memory = max(1, cpus // 2), memory // 2
    else:
        cpus, memory = max(cpus, min(2 * cpus, host_cpus())), large_memory(memory, host_memory())
    mib = memory // 2**20
    return mib * 2**20, {'limits.cpu': str(cpus), 'limits.memory': f'{mib}MiB'}


def incus_config(limits):
    return [arg for key, value in limits.items() for arg in ('--config', f'{key}={value}')]


def adhoc_vms():
    return {vm['name']: vm for vm in json.loads(ic('list', '--format', 'json')) if vm['name'].startswith('cbx-')
            and ((vm.get('config') or {}).get(ADHOC) == 'true' or (vm.get('config') or {}).get(WARM) == 'claimed')}


def require_listed(kind, value):
    try:
        lines = VM_ALLOW.read_text().split('\n')
    except FileNotFoundError:
        lines = []
    except OSError as error:
        raise SystemExit(f'coldbox: cannot read {VM_ALLOW}: {error}') from error
    if [kind, value] not in [line.split() for line in lines]:
        raise SystemExit(f'coldbox: {kind} {value} is not listed in {VM_ALLOW}; the host owner lists what vm up may use')
    path = f"instances/{value.replace('/', '/snapshots/', 1)}" if kind == 'image' else f'networks/{value}'
    try:
        query(f'/1.0/{path}?project={PROJECT}')
    except subprocess.CalledProcessError as error:
        raise SystemExit(f'coldbox: {kind} {value} is listed in {VM_ALLOW} but does not exist on this host') from error


def warm_shapes():
    try:
        words = VM_WARM.read_text().split()
    except FileNotFoundError:
        return []
    if len(words) > 2 or any(word not in ('online', 'offline') for word in words):
        raise ValueError(f'{VM_WARM} must list at most two of online and offline, not {" ".join(words)!r}')
    return words


def warm_build():
    """What a warm VM is started from: this CLI, the base snapshot, the coldbox profile and the guest overlay."""
    digest = hashlib.sha256(Path(__file__).read_bytes())
    snapshot = query(f"/1.0/instances/{BASE.replace('/', '/snapshots/', 1)}?project={PROJECT}")
    profile = query(f'/1.0/profiles/coldbox?project={PROJECT}')
    digest.update(json.dumps([snapshot['created_at'], profile.get('config'), profile.get('devices')],
                             sort_keys=True).encode())
    for top, names, files in os.walk(GUEST_FILES):
        names.sort()
        for entry in sorted(names + files):
            path = os.path.join(top, entry)
            stat = os.lstat(path)
            digest.update(f'{path}\0{stat.st_mode}\0{stat.st_size}\0{stat.st_ino}\0{stat.st_ctime_ns}\0'.encode())
    return digest.hexdigest()[:32]


def claim_warm(shape, ttl):
    """Take one ready warm VM of this shape and the current build for a vm up, or None. Under the host lock its mark
    becomes claimed, so no other vm up takes it and no refill keeps it; it becomes the caller's ad-hoc VM only after
    the ACL, isolation and agent checks pass and the mark is still claimed. vm down or its TTL deletes it."""
    with host_lock():
        try:
            build = f'{shape}:{warm_build()}'
        except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
            print(f'coldbox: not using a warm VM: {error}', file=sys.stderr)
            return None
        ready = [vm['name'] for vm in json.loads(ic('list', '--format', 'json')) if vm['name'].startswith('cbx-')
                 and vm['status'] == 'Running' and (vm.get('config') or {}).get(WARM) == build]
        if not ready or past_vm_max(ready[0], live_workers(STATE / 'workers')):
            return None
        name = ready[0]
        ic('config', 'set', name, f'{EXPIRES}={int(time.time() + ttl)}', f'{WARM}=claimed')
    try:
        sync_acl()
        isolated(name, shape == 'offline')
        if subprocess.run(ic_exec(name, 'true', user=None, timeout=10), capture_output=True).returncode:
            raise RuntimeError('its agent did not answer')
        with host_lock():
            if ic('config', 'get', name, WARM).strip() != 'claimed':
                raise RuntimeError('a refill retired it')
            ic('config', 'set', name, f'{ADHOC}=true', f'{WARM}=')
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        destroy(name)
        print(f'coldbox: deleted warm VM {name}: {error}; starting a new one', file=sys.stderr)
        return None
    return name


def yield_warm():
    """Delete one warm VM so a vm up that needs a different VM gets its place. Returns whether one was deleted."""
    with host_lock():
        warm = [vm['name'] for vm in json.loads(ic('list', '--format', 'json')) if vm['name'].startswith('cbx-')
                and (vm.get('config') or {}).get(WARM) not in (None, '', 'claimed')]
        if warm:
            ic('config', 'set', warm[0], f'{WARM}=retired')
    return bool(warm) and destroy(warm[0])


def fill_warm():
    """Keep the warm VMs that /etc/coldbox/vm-warm lists, each from the current warm_build(), and delete every other
    warm VM. Returns the number of failures."""
    STATE.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(STATE / 'vm-warm.lock', os.O_RDONLY | os.O_CREAT, 0o644)) as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        failed = 0
        try:
            policy = fleet()
            wanted = [] if policy and policy[0] == os.uname().nodename else warm_shapes()
            build = warm_build() if wanted else None
        except (RuntimeError, ValueError, OSError, KeyError, subprocess.SubprocessError) as error:
            print(f'coldbox: keeping no warm VMs: {error}', file=sys.stderr)
            wanted, build, failed = [], None, 1
        retire = []
        with host_lock():
            for vm in json.loads(ic('list', '--format', 'json')):
                value = (vm.get('config') or {}).get(WARM)
                if not value or not vm['name'].startswith('cbx-'):
                    continue
                shape, expires = value.partition(':')[0], (vm.get('config') or {}).get(EXPIRES, '')
                if value == 'claimed' and expires.isdigit() and int(expires) > time.time():
                    continue
                if (shape in wanted and value == f'{shape}:{build}' and vm['status'] == 'Running'
                        and expires.isdigit() and int(expires) > time.time() + 600):
                    wanted.remove(shape)
                else:
                    ic('config', 'set', vm['name'], f'{WARM}=retired')
                    retire.append(vm['name'])
        for name in retire:
            failed += not destroy(name)
        for shape in wanted:
            name = new_id()
            if not admit('warm', name, 'warm'):
                break
            try:
                boot(name, int(time.time() + WARM_BOOT), shape == 'offline', '--config', f'{WARM}=booting')
                push_guest_files(name, mode='vm')
                if warm_build() != build:
                    raise RuntimeError('the warm VM build changed while it started')
                with host_lock():
                    if ic('config', 'get', name, WARM).strip() != 'booting':
                        raise RuntimeError('the warm VM was retired while it started')
                    ic('config', 'set', name, f'{EXPIRES}={int(time.time() + WARM_TTL)}', f'{WARM}={shape}:{build}')
            except BaseException as error:
                failed += 1
                destroy(name)
                if not isinstance(error, Exception):
                    raise
                print(f'coldbox: could not start a warm VM: {error}', file=sys.stderr)
        return failed


def fill_warm_later():
    sys.stdout.flush()
    sys.stderr.flush()
    if os.fork():
        return
    try:
        os.setsid()
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        fill_warm()
    finally:
        os._exit(0)


def warm_pool_size(path=None):
    env_value = os.environ.get('COLDBOX_WARM_POOL_SIZE') if path is None else None
    if env_value is not None and env_value.strip() != '':
        text = env_value.strip()
        if not text.isdigit():
            raise ValueError(f'COLDBOX_WARM_POOL_SIZE must hold a whole number of VMs, not {text!r}')
        return int(text)
    target = WARM_POOL if path is None else Path(path)
    try:
        text = target.read_text().strip()
    except FileNotFoundError:
        return 0
    if not text:
        return 0
    if text.isdigit():
        return int(text)
    try:
        data = tomllib.loads(text)
    except ValueError as error:
        raise ValueError(f'{target} must hold a whole number or warm_pool_size = N, not {text!r}') from error
    if list(data.keys()) != ['warm_pool_size'] or type(data['warm_pool_size']) is not int or data['warm_pool_size'] < 0:
        raise ValueError(f'{target} must hold a whole number or warm_pool_size = N, not {text!r}')
    return data['warm_pool_size']


def warm_pool_on():
    try:
        return warm_pool_size() > 0
    except (OSError, ValueError):
        return False


def pool_counters():
    try:
        seen = json.loads((STATE / 'warm-pool.json').read_text())
        if isinstance(seen['since'], str) and all(isinstance(entry, dict) for entry in seen['last'].values()) \
                and all(type(count) is int for key in ('counts', 'reaped') for count in seen[key].values()):
            return seen
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass
    return dict(since=None, counts={}, reaped={}, last={})


def note_pool(event, **detail):
    """Count one warm pool event for coldbox pool status. A count is never worth a job, so a failed write is dropped."""
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with os.fdopen(os.open(STATE / 'warm-pool.json.lock', os.O_RDONLY | os.O_CREAT, 0o644)) as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            seen = pool_counters()
            seen['since'] = seen['since'] or now_iso()
            seen['counts'][event] = seen['counts'].get(event, 0) + 1
            if event == 'reaped':
                seen['reaped'][detail['reason']] = seen['reaped'].get(detail['reason'], 0) + 1
            seen['last'][event] = dict(at=now_iso(), **detail)
            staged = STATE / f'.warm-pool.{os.getpid()}'
            staged.write_text(json.dumps(seen))
            os.replace(staged, STATE / 'warm-pool.json')
    except (OSError, TypeError, ValueError):
        pass


def guest_overlay_content_digest():
    digest = hashlib.sha256()
    if not GUEST_FILES.is_dir():
        digest.update(b'absent')
        return digest.hexdigest()
    for top, names, files in os.walk(GUEST_FILES):
        names.sort()
        for entry in sorted(names + files):
            path = Path(top, entry)
            relative = str(path.relative_to(GUEST_FILES))
            st = path.lstat()
            digest.update(f'{relative}\0{st.st_mode}\0'.encode())
            if path.is_symlink():
                digest.update(b'L' + os.fsencode(os.readlink(path)) + b'\0')
            elif path.is_file():
                digest.update(b'F')
                with path.open('rb') as data:
                    while chunk := data.read(65536):
                        digest.update(chunk)
                digest.update(b'\0')
    return digest.hexdigest()


def warm_job_stamp(*, base=BASE, offline=False):
    digest = hashlib.sha256(Path(__file__).read_bytes())
    snapshot = query(f"/1.0/instances/{base.replace('/', '/snapshots/', 1)}?project={PROJECT}")
    profile = query(f'/1.0/profiles/coldbox?project={PROJECT}')
    snap_cfg = snapshot.get('config') or {}
    metadata = [base, 'offline' if offline else 'online', snapshot['created_at'],
                snap_cfg.get('volatile.base_image'), snap_cfg.get('volatile.uuid'),
                profile.get('config'), profile.get('devices'), guest_overlay_content_digest()]
    digest.update(json.dumps(metadata, sort_keys=True).encode())
    digest.update(HOST_CHECKS.read_bytes() if HOST_CHECKS.is_file() else b'no-checks')
    return f"{'offline' if offline else 'online'}:{digest.hexdigest()[:32]}"


def warm_claim_alive(value, expires):
    if not (expires.isdigit() and int(expires) > time.time()):
        return False
    if value == 'claimed':
        return True
    parts = value.split(':')
    if len(parts) != 3 or parts[0] != 'claimed' or not parts[1].isdigit() or not parts[2]:
        return False
    return process_start(int(parts[1])) == parts[2]


def claimable(vm, stamp, now):
    """Whether a job may take this VM now: a running standby of this stamp with over a minute left. A VM with no
    warm pool mark is never claimable, whatever the stamp."""
    config = vm.get('config') or {}
    expires = config.get(EXPIRES, '')
    return bool(stamp) and vm.get('name', '').startswith('cbx-') and vm.get('status') == 'Running' \
        and config.get(WARM_JOB) == stamp and expires.isdigit() and int(expires) > now + 60


def claim_warm_job(target, kind, ttl, *, offline=False, writers=None, memory=None, preferred=None):
    """Take one ready standby of the current stamp for a job, or None. Under the host lock its mark becomes this
    process's claim, which a refill honors only while this process lives and for WARM_CLAIM seconds, so an abandoned
    claim is deleted soon after. The VM is the caller's once its ACL, isolation and agent pass and, under the host
    lock again, the mark is still that claim, the deadline has not passed and the stamp is unchanged. The mark is then
    cleared for good, so no VM is handed out twice."""
    try:
        if warm_pool_size() <= 0:
            return None
        stamp = warm_job_stamp(offline=offline)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'coldbox: not using warm pool: {error}', file=sys.stderr)
        return None
    pid = os.getpid()
    claim_token = f'claimed:{pid}:{process_start(pid) or "0"}'
    name = None
    try:
        with host_lock():
            reserved = {worker.name for worker in live_workers(STATE / 'workers', prune=False) if worker.pid != pid}
            now = time.time()
            ready = [vm['name'] for vm in json.loads(ic('list', '--format', 'json'))
                     if vm.get('name') not in reserved and claimable(vm, stamp, now)]
            if not ready:
                return None
            chosen = preferred if preferred in ready else ready[0]
            deadline = int(now + WARM_CLAIM)
            ic('config', 'set', chosen, f'{EXPIRES}={deadline}', f'{WARM_JOB}={claim_token}')
            name = chosen
            note_worker(pid, target, name, kind, writers, memory)
        sync_acl()
        isolated(name, offline)
        if subprocess.run(ic_exec(name, 'true', user=None, timeout=10), capture_output=True).returncode:
            raise RuntimeError('its agent did not answer')
        with host_lock():
            if ic('config', 'get', name, WARM_JOB).strip() != claim_token:
                raise RuntimeError('a refill retired it')
            if warm_job_stamp(offline=offline) != stamp:
                raise RuntimeError('the warm pool stamp changed during claim')
            if time.time() >= deadline:
                raise RuntimeError('the claim took too long')
            ic('config', 'set', name, f'{EXPIRES}={int(time.time() + ttl)}', f'{WARM_JOB}=')
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        if name is None:
            print(f'coldbox: not using warm pool: {error}', file=sys.stderr)
            return None
        destroy(name)
        (STATE / 'ready' / name).unlink(missing_ok=True)
        with host_lock():
            (STATE / 'workers' / str(pid)).unlink(missing_ok=True)
        note_pool('reaped', vm=name, reason='unhealthy')
        print(f'coldbox: deleted warm pool VM {name}: {error}; starting a new one', file=sys.stderr)
        return None
    return name


def standby_warm_vms(workers, *, stamp=None):
    if not WARM_POOL.exists() and not os.environ.get('COLDBOX_WARM_POOL_SIZE'):
        return [], []
    reserved = {worker.name for worker in workers}
    try:
        listed = json.loads(ic('list', '--format', 'json'))
    except (OSError, ValueError, subprocess.SubprocessError):
        return [], []
    now = time.time()
    ready, evictable = [], []
    for vm in listed:
        name = vm.get('name', '')
        value = (vm.get('config') or {}).get(WARM_JOB)
        if not name.startswith('cbx-') or name in reserved or not value or value.startswith('claimed') or value == 'retired':
            continue
        (ready if claimable(vm, stamp, now) else evictable).append(name)
    return ready, evictable


def yield_warm_job():
    try:
        if warm_pool_size() <= 0:
            return False
    except (OSError, ValueError):
        return False
    with host_lock():
        reserved = {worker.name for worker in live_workers(STATE / 'workers', prune=False)}
        warm = [vm['name'] for vm in json.loads(ic('list', '--format', 'json')) if vm['name'].startswith('cbx-')
                and vm['name'] not in reserved and (value := (vm.get('config') or {}).get(WARM_JOB))
                and not value.startswith('claimed') and value != 'retired']
        if warm:
            ic('config', 'set', warm[0], f'{WARM_JOB}=retired')
    if not warm:
        return False
    gone = destroy(warm[0])
    (STATE / 'ready' / warm[0]).unlink(missing_ok=True)
    note_pool('reaped', vm=warm[0], reason='yielded')
    return gone


def fill_warm_pool(count=None):
    STATE.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(STATE / 'warm-pool.lock', os.O_RDONLY | os.O_CREAT, 0o644)) as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        failed = 0
        try:
            wanted = warm_pool_size() if count is None else count
            stamp = warm_job_stamp(offline=False) if wanted else None
        except (RuntimeError, ValueError, OSError, KeyError, subprocess.SubprocessError) as error:
            print(f'coldbox: keeping no warm pool VMs: {error}', file=sys.stderr)
            note_pool('refill_failed', error=str(error))
            wanted, stamp, failed = 0, None, 1
        keep, retire = 0, []
        with host_lock():
            for vm in json.loads(ic('list', '--format', 'json')):
                value = (vm.get('config') or {}).get(WARM_JOB)
                if not value or not vm['name'].startswith('cbx-'):
                    continue
                expires = (vm.get('config') or {}).get(EXPIRES, '')
                if warm_claim_alive(value, expires):
                    continue
                fresh = vm['status'] == 'Running' and expires.isdigit() and int(expires) > time.time() + 600
                if keep < wanted and value == stamp and fresh:
                    keep += 1
                    continue
                if value == 'retired':
                    retire.append((vm['name'], None))
                    continue
                ic('config', 'set', vm['name'], f'{WARM_JOB}=retired')
                retire.append((vm['name'], 'abandoned' if value == 'booting' or value.startswith('claimed') else
                               'stale' if stamp and value != stamp else 'expired' if not fresh else 'excess'))
        for name, reason in retire:
            gone = destroy(name)
            (STATE / 'ready' / name).unlink(missing_ok=True)
            if reason:
                note_pool('reaped', vm=name, reason=reason)
            failed += not gone
        pid = os.getpid()
        for _ in range(max(0, wanted - keep)):
            name = new_id()
            if not admit('warm-pool', name, 'warm-pool'):
                break
            try:
                boot(name, int(time.time() + WARM_BOOT), False, '--config', f'{WARM_JOB}=booting')
                ic('file', 'push', str(Path(__file__).resolve()), f'{name}/usr/local/bin/coldbox', '--mode', '0755')
                push_guest_files(name, mode='warm-pool')
                if warm_job_stamp(offline=False) != stamp:
                    raise RuntimeError('the warm pool stamp changed while it started')
                with host_lock():
                    if ic('config', 'get', name, WARM_JOB).strip() != 'booting':
                        raise RuntimeError('the warm pool VM was retired while it started')
                    mark_ready(name)
                    (STATE / 'workers' / str(pid)).unlink(missing_ok=True)
                    ic('config', 'set', name, f'{EXPIRES}={int(time.time() + WARM_TTL)}', f'{WARM_JOB}={stamp}')
            except BaseException as error:
                failed += 1
                destroy(name)
                (STATE / 'ready' / name).unlink(missing_ok=True)
                with host_lock():
                    (STATE / 'workers' / str(pid)).unlink(missing_ok=True)
                if not isinstance(error, Exception):
                    raise
                note_pool('refill_failed', error=str(error))
                print(f'coldbox: could not start a warm pool VM: {error}', file=sys.stderr)
        return failed


def fill_warm_pool_later():
    child = 'import runpy, sys; runpy.run_path(sys.argv[1])["fill_warm_pool"]()'
    try:
        subprocess.Popen([sys.executable, '-I', '-c', child, str(Path(__file__).resolve())],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         close_fds=True, start_new_session=True)
    except OSError as error:
        print(f'coldbox: could not start warm pool refill: {error}', file=sys.stderr)


def vm_cmd(args):
    if args.action == 'up':
        options = ['--image', args.image] if args.image is not None else []
        options += [arg for key in ('cpus', 'memory', 'disk', 'network')
                    if getattr(args, key) for arg in (f'--{key}', str(getattr(args, key)))]
        for kind in ('image', 'network'):
            if getattr(args, kind):
                require_listed(kind, getattr(args, kind))
        if args.cpus and args.cpus > cpu_count(ic('profile', 'get', 'coldbox', 'limits.cpu').strip()):
            raise SystemExit(f"coldbox: --cpus {args.cpus} is above the coldbox profile's limits.cpu")
        if args.image:
            args.cpus = args.cpus or ic('profile', 'get', 'coldbox', 'limits.cpu').strip()
            args.memory = args.memory or ic('profile', 'get', 'coldbox', 'limits.memory').strip()
            args.disk = args.disk or ic('profile', 'device', 'get', 'coldbox', 'root', 'size').strip()
        if args.disk and size_bytes(args.disk) > vm_disk():
            raise SystemExit(f"coldbox: --disk {args.disk} is above the coldbox profile's root disk size")
        _, limits = sizing(args)
        try:
            policy = fleet()
        except RuntimeError as error:
            raise SystemExit(f'coldbox: {error}') from error
        if policy and policy[0] == os.uname().nodename:
            raise SystemExit(f'coldbox: this host is the CI primary in {CI_HOSTS}; run ad-hoc VMs on another host')
        try:
            shapes = warm_shapes()
        except ValueError as error:
            print(f'coldbox: {error}', file=sys.stderr)
            shapes = []
        shape = 'offline' if args.offline else 'online'
        if not options and shape in shapes and (name := claim_warm(shape, args.ttl)):
            print(name)
            fill_warm_later()
            return 0
        name, refusal = new_id(), 'coldbox: the host is at its job VM ceiling; try again when a job finishes'
        try:
            admitted = admit('vm', name, 'vm') or shapes and yield_warm() and admit('vm', name, 'vm')
        except SystemExit as limit:
            admitted, refusal = False, str(limit)
        if not admitted:
            command = ['coldbox', 'vm', 'up', '--here', '--ttl', str(args.ttl)] + ['--offline'] * args.offline + options
            tags = collections.Counter(map(host_tag, [os.uname().nodename, *adhoc_peers()]))
            peers = [] if args.here else [peer for peer in adhoc_peers() if tags[host_tag(peer)] == 1]
            ranked = least_loaded(peers, None)
            for host in ranked + [peer for peer in peers if peer not in ranked]:
                started = subprocess.run(ssh(host, command), stdout=subprocess.PIPE, text=True)
                if started.returncode == 0:
                    print(f'coldbox: {refusal.removeprefix("coldbox: ")}; started it on {host}', file=sys.stderr)
                    print(started.stdout.strip())
                    return 0
            raise SystemExit(refusal)
        try:
            boot(name, int(time.time() + args.ttl), args.offline, '--config', f'{ADHOC}=true', *limits,
                 *['--profile', 'coldbox'] * bool(args.image),
                 **{key: value for key, value in (('base', args.image), ('bridge', args.network), ('disk', args.disk))
                    if value})
            push_guest_files(name, mode='vm' if args.image is None else 'image')
            if args.image and subprocess.run(ic_exec(name, 'sudo', '-n', 'true', timeout=60),
                                             capture_output=True).returncode:
                raise RuntimeError(f'{args.image} has no {RUNNER} user with passwordless sudo')
        except BaseException:
            destroy(name)
            raise
        print(name)
        return 0
    vms = {name: vm for name, vm in adhoc_vms().items() if not (vm.get('config') or {}).get(WARM)}
    if args.action == 'list':
        for vm in vms.values():
            left = int(vm['config'].get('user.coldbox.expires', 0)) - time.time()
            print(f"{vm['name']}\t{vm['status']}\texpires in {max(0, left) / 60:.0f} min")
        return 0
    if args.name not in vms:
        tag = args.name.split('-', 3)[3:]
        homes = [peer for peer in adhoc_peers() if tag == [host_tag(peer)]]
        if len(homes) != 1 or tag == [host_tag(os.uname().nodename)]:
            raise SystemExit(f'coldbox: no ad-hoc VM named {args.name}; see coldbox vm list')
        home = homes[0]
        forwarded = ['coldbox', 'vm', args.action, args.name] + (['--', *args.command] if args.action == 'exec' else [])
        return subprocess.run(ssh(home, forwarded)).returncode
    if args.action == 'down':
        gone = destroy(args.name)
        print(f"coldbox: {args.name} {'deleted' if gone else 'FAILED to delete'}", file=sys.stderr)
        return 0 if gone else 1
    left = int(vms[args.name]['config']['user.coldbox.expires']) - time.time()
    if left <= 0:
        raise SystemExit(f'coldbox: {args.name} has expired; the reaper will delete it')
    return subprocess.run(ic_exec(args.name, *args.command, cwd=f'/home/{RUNNER}', timeout=left)).returncode


def app_jwt(app_id, key=None):
    encode = lambda value: base64.urlsafe_b64encode(value).rstrip(b'=')
    now = int(time.time())
    payload = {'iat': now - 60, 'exp': now + 540, 'iss': app_id}
    message = b'.'.join(encode(json.dumps(value).encode())
                        for value in ({'alg': 'RS256', 'typ': 'JWT'}, payload))
    signed = subprocess.run(['openssl', 'dgst', '-sha256', '-sign', str(key or APP_KEY)], input=message,
                            capture_output=True, timeout=30)
    if signed.returncode:
        raise RuntimeError('GitHub App: RS256 signing failed; check private key access')
    return (message + b'.' + encode(signed.stdout)).decode()


def app_request(path, token, method='GET', body=None, *, complete=False):
    request = urllib.request.Request(f'https://api.github.com/{path}', method=method,
                                    data=json.dumps(body or {}).encode() if method == 'POST' else None,
                                    headers={'Authorization': f'Bearer {token}', 'User-Agent': 'coldbox',
                                             'Accept': 'application/vnd.github+json',
                                             'X-GitHub-Api-Version': '2022-11-28'})
    with urllib.request.urlopen(request, timeout=60) as response:
        if complete and (response.status != 200 or response.headers.get('Link')):
            raise Unsafe('incomplete GitHub policy response')
        return json.load(response)


def app_settings(env):
    if not env.exists():
        return {}
    return dict(line.strip().split('=', 1) for line in env.read_text().splitlines() if '=' in line)


def github_app_id():
    return os.environ.get('COLDBOX_GITHUB_APP_ID') or app_settings(APP_ENV).get('COLDBOX_GITHUB_APP_ID')


def org_app_files(owner):
    if not ORG_LOGIN.fullmatch(owner):
        raise ConfigError('expected a GitHub organization login')
    stem = f'github-app-{owner.lower()}'
    return APP_ENV.with_name(stem + '.env'), APP_KEY.with_name(stem + '.pem')


def app_credentials(path):
    match = re.match(r'(?:repos|orgs|users)/([^/?]+)', path)
    owner = match[1].casefold() if match else ''
    if ORG_LOGIN.fullmatch(owner):
        env, key = org_app_files(owner)
        if env.exists() or key.exists() or env.is_symlink() or key.is_symlink():
            app_id = app_settings(env).get('COLDBOX_GITHUB_APP_ID')
            if not app_id or not key.is_file() or env.is_symlink() or key.is_symlink():
                raise RuntimeError('GitHub App: incomplete organization credentials')
            return owner, app_id, key
    return owner, github_app_id(), APP_KEY


def app_token(path='', scope=None):
    try:
        owner, app_id, key = app_credentials(path)
        if not app_id or not key.exists():
            return None
        if not app_id.isdecimal():
            raise RuntimeError('GitHub App: COLDBOX_GITHUB_APP_ID must be numeric')
        with APP_LOCK:
            cache_key = (app_id, owner, json.dumps(scope))
            cached = APP_TOKENS.get(cache_key)
            if cached and time.time() < cached[1] - 300:
                return cached[0]
            jwt = app_jwt(app_id, key)
            installations, page = [], 1
            while True:
                batch = app_request(f'app/installations?per_page=100&page={page}', jwt)
                installations.extend(batch)
                if len(batch) < 100:
                    break
                page += 1
            matches = [item for item in installations if not owner or item['account']['login'].casefold() == owner]
            if not matches or owner and len(matches) != 1:
                raise RuntimeError('GitHub App: no unique installation for the target owner')
            token = app_request(f"app/installations/{matches[0]['id']}/access_tokens", jwt, 'POST', scope)
            if scope and scope.get('permissions', {}).get('members') and token.get('permissions', {}).get('members') != 'read':
                raise RuntimeError('GitHub App: token does not confirm organization Members: read')
            expires = datetime.fromisoformat(token['expires_at'].replace('Z', '+00:00')).timestamp()
            if not isinstance(token['token'], str) or not token['token'] or expires <= time.time() + 300:
                raise RuntimeError('GitHub App: invalid or expired installation token')
            APP_TOKENS[cache_key] = token['token'], expires
            return token['token']
    except urllib.error.HTTPError as error:
        kind = GitHubTransient if 500 <= error.code < 600 else RuntimeError
        raise kind(f'GitHub App authentication failed: HTTP {error.code}') from None
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        raise GitHubTransient('GitHub App authentication failed: network error') from None
    except RuntimeError:
        raise
    except Exception:
        raise RuntimeError('GitHub App authentication failed; check configuration, key and connectivity') from None


def repo_token(repo):
    try:
        token = app_token(f'repos/{repo}', dict(repositories=[repo.split('/')[1]], permissions=dict(contents='read')))
    except RuntimeError as error:
        if 'HTTP 422' not in str(error) and 'no unique installation' not in str(error):
            raise
        token = None
    if token is None:
        print(f'coldbox: no GitHub App token can read {repo} (the App needs Contents: read on that repo); '
              'cloning anonymously, which works only for public repos', file=sys.stderr, flush=True)
    return token


APP_PERMISSIONS = dict(administration='write', actions='read', metadata='read', checks='write', contents='read')
ORG_APP_PERMISSIONS = dict(APP_PERMISSIONS, organization_self_hosted_runners='write')


def setup_app(args):
    member = getattr(args, 'sole_member', None)
    key_path, env_path = APP_KEY, APP_ENV
    wanted = ORG_APP_PERMISSIONS if args.org else APP_PERMISSIONS
    if member is not None:
        if not args.org or not ORG_LOGIN.fullmatch(member):
            raise ConfigError('setup-app: --sole-member requires --org and a GitHub login')
        env_path, key_path = org_app_files(args.org)
        wanted = dict(APP_PERMISSIONS, members='read')
    if args.app_id is None and args.key is None:
        query = urllib.parse.urlencode(dict(name=f'coldbox-{args.org if member else os.uname().nodename}',
                                            url=f'https://github.com/{args.org}' if member else 'https://github.com/coldstack-dev/coldbox',
                                            public='false', webhook_active='false',
                                            **wanted))
        owner = f'organizations/{urllib.parse.quote(args.org)}/settings' if args.org else 'settings'
        print(f'1. Open https://github.com/{owner}/apps/new?{query}')
        print('   The form is filled in with only the permissions Coldbox needs. Click "Create GitHub App".')
        print('2. Note the App ID, then click "Generate a private key" and copy the .pem file to this host.')
        print(f"3. sudo coldbox setup-app{f' --org {args.org}' if args.org else ''}"
              f"{' --sole-member ' + member if member else ''} --app-id <App ID> --key <path to .pem>")
        return 0
    if args.app_id is None or args.key is None:
        raise ConfigError('setup-app: give both --app-id and --key, or neither to print the setup steps')
    if not args.app_id.isdecimal():
        raise ConfigError('setup-app: --app-id must be the numeric App ID')
    if os.geteuid() != 0:
        raise SystemExit('coldbox setup-app: run with sudo')
    for path in (key_path, env_path):
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise ConfigError(f'setup-app: expected a regular file at {path}')
    has_key, has_env = key_path.exists(), env_path.exists()
    if has_key and has_env:
        raise ConfigError(f'setup-app: GitHub App auth is already configured; remove {key_path} and {env_path} to replace it')
    key = Path(args.key)
    owner = pwd.getpwnam(os.environ.get('SUDO_USER') or 'root')
    app_env = f'COLDBOX_GITHUB_APP_ID={args.app_id}\n'
    if member:
        app_env += f'COLDBOX_SOLE_MEMBER={member}\n'
    if has_key or has_env:
        present, missing_path = (key_path, env_path) if has_key else (env_path, key_path)
        diagnosis = f'setup-app: partial setup: found {present}, missing {missing_path}'
        print(diagnosis)
        if has_env and env_path.read_bytes() != app_env.encode():
            setting = 'App ID or sole member' if member else 'App ID'
            raise ConfigError(f'{diagnosis}; a different {setting} is already configured; inspect {env_path}')
    try:
        app = app_request('app', app_jwt(args.app_id, key))
    except urllib.error.HTTPError as error:
        raise RuntimeError(f'setup-app: GitHub rejected App ID {args.app_id} with this key (HTTP {error.code})') from None
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        raise RuntimeError('setup-app: could not reach api.github.com') from None
    granted = app.get('permissions', {})
    if member and (app.get('owner', {}).get('type') != 'Organization'
                   or app['owner'].get('login', '').casefold() != args.org.casefold()):
        raise ConfigError('setup-app: App owner does not match the organization')
    extra = sorted(f'{name}:{level}' for name, level in granted.items()
                   if level not in {'read': ('read',), 'write': ('read', 'write')}.get(wanted.get(name), ()))
    missing = sorted(f'{name}:{level}' for name, level in wanted.items()
                     if granted.get(name) != level)
    if extra or missing:
        raise ConfigError('setup-app: change the App\'s permissions in its settings and run this again: '
                          + '; '.join(f"{label} {', '.join(items)}" for label, items in
                                      (('remove', extra), ('add', missing)) if items))
    key_path.parent.mkdir(parents=True, exist_ok=True)
    pem = key.read_bytes()
    if has_key:
        with key_path.open('rb') as installed:
            st = os.fstat(installed.fileno())
            if (st.st_mode & 0o7777 != 0o600 or st.st_uid not in (0, owner.pw_uid) or
                    st.st_nlink != 1 or installed.read() != pem):
                raise ConfigError(f'{diagnosis}; check the existing key, its owner and mode 600 before retrying')
            if st.st_uid != owner.pw_uid:
                os.chown(installed.fileno(), owner.pw_uid, owner.pw_gid)
    else:
        descriptor = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with os.fdopen(descriptor, 'wb') as out:
                os.chown(out.fileno(), owner.pw_uid, owner.pw_gid)
                out.write(pem)
        except BaseException:
            key_path.unlink()
            raise
    if not has_env:
        with tempfile.NamedTemporaryFile(dir=env_path.parent, mode='w') as out:
            out.write(app_env)
            out.flush()
            os.fchmod(out.fileno(), 0o644)
            os.link(out.name, env_path)
    print(f"GitHub App {app['slug']} configured: {key_path} (mode 600, owner {owner.pw_name}) and {env_path}")
    print(f"Next: install it on the repos to register at https://github.com/apps/{app['slug']}/installations/new")
    return 0


NO_APP = ('no GitHub App on this host: run coldbox setup-app, or use your gh login, which can do anything its account '
          'can, with coldbox register --allow-personal-login (COLDBOX_ALLOW_PERSONAL_LOGIN=1 for other commands)')


def personal_login():
    if os.environ.get('COLDBOX_ALLOW_PERSONAL_LOGIN') != '1':
        raise RuntimeError(NO_APP)


def gh_env(path=''):
    token = app_token(path)
    if token:
        return dict(os.environ, GH_TOKEN=token, GH_HOST='github.com')
    personal_login()
    return None


def gh(*args, body=None, _retries=None, path='', _app_only=False):
    command = ['gh', 'api', *args] + (['--input', '-'] if body is not None else [])
    path = path or next((arg for arg in args if arg.startswith(('repos/', 'orgs/', 'users/'))), '')
    retries = [4] if _retries is None else _retries
    pending_jit = False
    runner_delete = '-X' in args and 'DELETE' in args and '/actions/runners/' in path
    ambiguous_delete = False
    while True:
        sent = False
        try:
            if pending_jit:
                reconcile_jit(path.removesuffix('/generate-jitconfig'), body['name'], retries)
                pending_jit = False
            env = gh_env(path)
            if _app_only and env is None:
                raise RuntimeError(NO_APP)
            try:
                sent = True
                result = subprocess.run(command, env=env or dict(os.environ, GH_HOST='github.com'), input=json.dumps(body) if body is not None else None,
                                        capture_output=True, text=True, timeout=60)
            except subprocess.TimeoutExpired:
                raise GitHubTransient('GitHub request timed out') from None
            if not result.returncode:
                return json.loads(result.stdout) if result.stdout.strip() else None
            detail = result.stderr.strip() or result.stdout.strip()
            status = re.search(r'HTTP ([0-9]{3})', detail)
            if status and status[1] == '404' and runner_delete and ambiguous_delete:
                return None
            transient = (500 <= int(status[1]) < 600) if status else bool(re.search(
                r'(?i)no server is currently available|dial tcp|timeout|timed out|connection reset|'
                r'connection refused|\bEOF\b|TLS handshake|network is unreachable|temporary failure|error connecting', detail))
            if env:
                detail = f"GitHub App request failed: {status[0] if status else 'unknown HTTP status'}"
            kind = GitHubTransient if transient else RuntimeError
            raise kind(f'gh api {" ".join(args)}: {detail}')
        except GitHubTransient:
            ambiguous_delete = ambiguous_delete or sent and runner_delete
            if sent and path.endswith('/generate-jitconfig') and body is not None:
                pending_jit = True
            if not retries[0]:
                if sent and pending_jit:
                    reconcile_jit(path.removesuffix('/generate-jitconfig'), body['name'], retries)
                raise
            delay = 2 ** (4 - retries[0])
            retries[0] -= 1
            time.sleep(delay)


def reconcile_jit(path, name, retries):
    page = 1
    while True:
        runners = gh(f'{path}?per_page=100&page={page}', _retries=retries)['runners']
        for runner in runners:
            if runner['name'] == name:
                if runner['busy']:
                    raise RuntimeError(f'cannot retry JIT registration: runner {name} is busy')
                gh('-X', 'DELETE', f"{path}/{runner['id']}", _retries=retries)
        if len(runners) < 100:
            return
        page += 1


def scope(target):
    if not TARGET.fullmatch(target):
        raise SystemExit(f'coldbox: {target!r} is not OWNER/REPO or ORG')
    return f'repos/{target}' if '/' in target else f'orgs/{target}'


def guard(target, allow_public):
    """Refuse a target Coldbox must not serve. For an opted-in public repo, return the users whose jobs run without
    approval; for a private one, None."""
    if '/' in target:
        repo = gh(scope(target))
        if str(repo.get('full_name')).casefold() != target.casefold():
            raise SystemExit(f"coldbox: refusing: {target} now resolves to {repo.get('full_name')}")
        if repo['visibility'] == 'private':
            return None
        what = f'{target} is not a private repository'
    else:
        if not gh(f'orgs/{target}/actions/runner-groups/1')['allows_public_repositories']:
            return None
        what = f"org {target}'s default runner group allows public repositories"
    if not allow_public:
        raise SystemExit(f'coldbox: refusing: {what}. On a public repository anyone can open a pull request. Pass '
                         '--allow-public to serve it: jobs from users with write access then run at once, and '
                         'pull requests from forks never run.')
    if '/' not in target:
        raise SystemExit('coldbox: refusing: --allow-public is per repository; register OWNER/REPO')
    try:
        return public_writers(gh, target, repo)
    except ValueError as error:
        raise SystemExit(f'coldbox: refusing: {error}') from None


class OrgPublicWriters(list):
    pass


def sole_org_member(target):
    org, repo = target.split('/')
    expected = app_settings(org_app_files(org)[0]).get('COLDBOX_SOLE_MEMBER')
    if not expected:
        raise Unsafe(f'{target} is owned by an organization without a configured sole member')
    token = app_token(f'repos/{target}', dict(repositories=[repo], permissions=dict(members='read', metadata='read')))
    if not token:
        raise Unsafe('organization membership requires an installation token with Members: read')
    query = """query($org: String!) { organization(login: $org) {
        membersWithRole(first: 2) { totalCount pageInfo { hasNextPage } nodes { login } }
    } }"""
    response = app_request('graphql', token, 'POST', dict(query=query, variables=dict(org=org)), complete=True)
    members = response['data']['organization']['membersWithRole']
    if (response.get('errors') or type(members['totalCount']) is not int or members['totalCount'] != 1
            or members['pageInfo']['hasNextPage'] is not False
            or len(members['nodes']) != 1 or members['nodes'][0]['login'].casefold() != expected.casefold()):
        raise Unsafe(f'{org} must have exactly the configured member')
    if app_request(f'repos/{target}/collaborators?affiliation=outside&per_page=1', token, complete=True) != []:
        raise Unsafe(f'{target} must have no outside collaborators')
    return expected


def public_writers(get, target, repo):
    owner_type = (repo.get('owner') or {}).get('type')
    if owner_type == 'User':
        return repo_writers(get, target)
    if owner_type != 'Organization' or repo.get('visibility') != 'public':
        raise Unsafe(f'{target} has an unsupported owner or visibility')
    try:
        expected = sole_org_member(target)
        writers = repo_writers(get, target)
        if len(writers) != 1 or writers[0].casefold() != expected.casefold():
            raise Unsafe(f'{target} must have only the configured member as a writer')
        return OrgPublicWriters(writers)
    except Unsafe:
        raise
    except (RuntimeError, OSError, ValueError, KeyError, TypeError, IndexError, AttributeError, subprocess.SubprocessError):
        raise Unsafe(f'could not verify the public organization policy for {target}') from None


def repo_writers(get, target):
    policy = get(f'repos/{target}/actions/permissions/fork-pr-contributor-approval').get('approval_policy')
    if policy != APPROVAL:
        raise Unsafe(f'{target} runs some outside pull requests without approval (approval_policy {policy}). '
                     f'Fix: gh api -X PUT repos/{target}/actions/permissions/fork-pr-contributor-approval '
                     f'-f approval_policy={APPROVAL}')
    writers, page = [], 1
    while True:
        batch = get(f'repos/{target}/collaborators?permission=push&per_page=100&page={page}')
        writers += [user['login'] for user in batch]
        if len(batch) < 100:
            return sorted(writers)
        page += 1


def runner_state(log_path):
    try:
        receipt = json.loads(log_path.with_suffix('.json').read_text())
        if isinstance(receipt, dict) and 'job_result' in receipt:
            return receipt.get('job_name'), receipt['job_result']
    except (OSError, ValueError):
        pass
    with log_path.open('rb') as file:
        assigned = result = None
        for line in iter(lambda: file.readline(CONSOLE_CHUNK), b''):
            if b'Running job: ' in line:
                assigned = running_job(line) or assigned
            if b' completed with result: ' in line:
                result = job_outcome(line)[1] or result
    return assigned, result


def stop_once(*_):
    if not DRAINING.is_set() and ACTIVE_LOG is not None:
        try:
            assigned, result = runner_state(ACTIVE_LOG)
        except OSError:
            assigned = result = None
        if assigned and not result:
            DRAINING.set()
            return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    sys.exit(143)


def exit_code(receipt):
    return {'pass': 0, 'fail': 1}.get(receipt['verdict'], 125)


def worker_argv(args, *extra):
    argv = [sys.executable, str(Path(__file__).resolve()), 'serve', args.target, '--worker', '--ttl', str(args.ttl),
            '--slots', str(min(args.slots, 1))]
    return argv + ['--allow-public'] * args.allow_public + list(extra)


def serve_slots(args):
    children = [subprocess.Popen(worker_argv(args, *['--once'] * args.once)) for _ in range(args.slots)]
    bursts = []
    STOPPING.clear()
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, lambda *_: [STOPPING.set()] + [child.send_signal(signal.SIGTERM)
                                                               for child in children + bursts if child.poll() is None])
    if args.once:
        return max(child.wait() for child in children)
    github = GitHub() if '/' in args.target else None
    next_pass = 0
    while not STOPPING.is_set() and all(child.poll() is None for child in children):
        if github and time.time() >= next_pass:
            started = time.time()
            next_pass = started + AUTOSCALE_SECONDS
            try:
                next_pass = started + autoscale(github, args, bursts)
            except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as error:
                print(f'coldbox: autoscale pass failed: {type(error).__name__}: {error}', file=sys.stderr, flush=True)
        time.sleep(1)
    if not STOPPING.is_set():
        for child in children + bursts:
            if child.poll() is None:
                child.send_signal(signal.SIGTERM)
    return max((child.wait() for child in children + bursts), default=143) or 1


def release_idle(target, runner_id, stop=None):
    if CLEANUP.is_set() or (stop and stop.is_set()):
        return
    try:
        gh('-X', 'DELETE', f'{scope(target)}/actions/runners/{runner_id}')
    except RuntimeError as error:
        if 'HTTP 422' not in str(error):
            retry = threading.Timer(60, release_idle, (target, runner_id, *[stop] * bool(stop)))
            retry.daemon = True
            retry.start()
        return
    with RELEASING:
        if not (stop and stop.is_set()):
            os.kill(os.getpid(), signal.SIGUSR1)


def guest_fingerprint():
    try:
        return sorted((entry.name, entry.inode(), entry.stat(follow_symlinks=False).st_mtime_ns)
                      for entry in os.scandir(GUEST_FILES / 'opt'))
    except OSError:
        return None


def watch_guest(target, runner_id, pushed, stop):
    while not stop.wait(GUEST_POLL_SECONDS):
        if guest_fingerprint() != pushed:
            release_idle(target, runner_id, stop)
            return


def idle_released(*_):
    if not CLEANUP.is_set():
        raise RuntimeError(IDLE_RELEASED)


def wait_for_coldverify():
    while True:
        with COLDVERIFY_LOCK:
            if not COLDVERIFY_CHILDREN:
                return
            child = COLDVERIFY_CHILDREN.pop()
        child.wait()


def serve(args):
    _, primary = ci_host()
    if not args.worker and (args.slots > 1 or not args.once):
        note_supervisor_build(args.target)
        return serve_slots(args)
    signal.signal(signal.SIGTERM, stop_once)
    signal.signal(signal.SIGUSR1, idle_released)
    try:
        return serve_worker(args, primary)
    finally:
        with COLDVERIFY_LOCK:
            has_coldverify = bool(COLDVERIFY_CHILDREN)
        if has_coldverify or TEARDOWN_REAPER is not None:
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            wait_for_teardowns(close=True)
            wait_for_coldverify()


def org_job_recheck(args, writers):
    try:
        current = public_rules(GitHub(), args)
        return isinstance(current, OrgPublicWriters) and current == writers
    except (ValueError, KeyError, TypeError, AttributeError, RuntimeError, OSError, subprocess.SubprocessError):
        return False


def serve_worker(args, primary):
    env = ['ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/coldbox-job-started.sh',
           f'COLDBOX_CI_PRIMARY={primary}']
    memory, limits = vm_shape(args.size)
    labels = runner_labels(args.size)
    while True:
        with COLDVERIFY_LOCK:
            COLDVERIFY_CHILDREN[:] = [child for child in COLDVERIFY_CHILDREN if child.poll() is None]
        writers = guard(args.target, args.allow_public)
        kind = 'burst' if args.idle else 'once' if args.once else 'base'
        reload_pending = not args.once and compile(Path(__file__).read_bytes(), __file__, 'exec') != LOADED_CODE
        pooled = not (reload_pending or limits)
        claimed = claim_warm_job(args.target, kind, args.ttl, offline=False, writers=writers, memory=memory,
                                 preferred=args.name) if pooled else None
        if claimed:
            name = claimed
            fill_warm_pool_later()
        else:
            name = args.name or new_id()
            if args.name and (getattr(args, 'standby', False) or (
                    (WARM_POOL.exists() or os.environ.get('COLDBOX_WARM_POOL_SIZE')) and args.name in host_vms())):
                name = new_id()
            if not admit(args.target, name, kind, writers, memory) and not (
                    yield_warm_job() and admit(args.target, name, kind, writers, memory)):
                if args.once:
                    raise SystemExit('coldbox: the host is at its job VM ceiling; not starting another')
                print('coldbox: the host is at its job VM ceiling; waiting', file=sys.stderr, flush=True)
                time.sleep(30)
                continue
        if reload_pending or (not args.once and compile(Path(__file__).read_bytes(), __file__, 'exec') != LOADED_CODE):
            extra = (['--idle', str(args.idle)] if args.idle else []) + (['--name', args.name] if args.name else []) + \
                (['--size', args.size] if args.size != 'default' else [])
            with host_lock():
                (STATE / 'workers' / str(os.getpid())).unlink(missing_ok=True)
            wait_for_teardowns(close=True)
            wait_for_coldverify()
            os.execv(sys.executable, worker_argv(args, *extra))
        admission = runner_admission(args.target, name, time.time() + args.ttl)
        (STATE / 'receipts').mkdir(parents=True, exist_ok=True)
        marker = STATE / 'receipts' / f'{name}.registered'
        marker.touch()
        try:
            runner = gh('-X', 'POST', f'{scope(args.target)}/actions/runners/generate-jitconfig',
                        body=dict(name=name, runner_group_id=1, labels=labels, work_folder='_work'))
        except GitHubTransient:
            raise
        except RuntimeError:
            marker.unlink(missing_ok=True)
            raise
        idle = threading.Timer(args.idle, release_idle, (args.target, runner['runner']['id'])) if args.idle else None
        stop_watch = threading.Event()
        watcher = threading.Thread(target=watch_guest, daemon=True,
                                   args=(args.target, runner['runner']['id'], guest_fingerprint(), stop_watch))
        reaper = None if args.once else get_teardown_reaper()
        job_extra = dict(pooled=pooled)
        if reaper is not None:
            job_extra.update(teardown=reaper,
                             on_teardown=lambda done, target=args.target, vm_name=name: publish_verify(target, vm_name, done))
        if claimed:
            job_extra['warm_claimed'] = True
        try:
            if idle:
                idle.daemon = True
            print(f'coldbox: runner {name} waiting for a job on {args.target}', file=sys.stderr, flush=True)
            receipt = job('runner', name, args.ttl, ['sh', '-c', 'read -r c; exec ./run.sh --jitconfig "$c"'],
                          repo=args.target, stdin=(runner['encoded_jit_config'] + '\n').encode(),
                          cwd='/opt/actions-runner',
                          env=env + ([f"COLDBOX_PUBLIC_WRITERS={','.join(writers)}"] if writers is not None else []),
                          extra=dict(runner_id=runner['runner']['id'], admission=admission),
                          on_ready=lambda: [idle.start() if idle else None, watcher.start()],
                          config=incus_config(limits), cache=cache_folder(args.target, args.allow_public),
                          recheck_org=(lambda: org_job_recheck(args, writers)) if isinstance(writers, OrgPublicWriters) else None,
                          **job_extra)
        finally:
            with RELEASING:
                stop_watch.set()
            if idle:
                idle.cancel()
            try:
                gh('-X', 'DELETE', f"{scope(args.target)}/actions/runners/{runner['runner']['id']}")
            except RuntimeError:
                pass
        async_teardown = (receipt.get('vm') or {}).get('teardown') == 'async'
        if not async_teardown:
            publish_verify(args.target, name, receipt)
        if DRAINING.is_set():
            wait_for_teardowns(close=True)
            return 143
        if args.once:
            return exit_code(receipt)
        if (receipt.get('vm') or {}).get('destroyed') or async_teardown:
            with host_lock():
                (STATE / 'workers' / str(os.getpid())).unlink(missing_ok=True)
        if 'job_seconds' not in receipt and receipt.get('error') != IDLE_RELEASED:
            time.sleep(30)


class GitHub:
    def __init__(self):
        self.cache, self.used = {}, set()
        self.remaining, self.reset = None, 0

    def get(self, path):
        if self.remaining is not None and self.remaining < QUOTA_RESERVE and time.time() < self.reset:
            raise RuntimeError(f'GitHub API quota low ({self.remaining} left); waiting for its reset')
        token = app_token(path) or personal_login() or subprocess.run(
            ['gh', 'auth', 'token'], env=dict(os.environ, GH_HOST='github.com'), capture_output=True, text=True,
            check=True, timeout=60).stdout.strip()
        headers = {'Authorization': f'Bearer {token}', 'Accept': 'application/vnd.github+json',
                   'X-GitHub-Api-Version': '2022-11-28', 'User-Agent': 'coldbox'}
        self.used.add(path)
        if path in self.cache:
            headers['If-None-Match'] = self.cache[path][0]
        request = urllib.request.Request(f'https://api.github.com/{path}', headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                self.note(response.headers)
                value = json.loads(response.read())
                if response.headers.get('ETag'):
                    self.cache[path] = (response.headers['ETag'], value)
                return value
        except urllib.error.HTTPError as error:
            self.note(error.headers)
            if error.code == 304 and path in self.cache:
                return self.cache[path][1]
            raise RuntimeError(f'GET {path}: HTTP {error.code}') from None

    def note(self, headers):
        if headers and headers.get('X-RateLimit-Remaining') is not None:
            self.remaining = int(headers['X-RateLimit-Remaining'])
            self.reset = int(headers.get('X-RateLimit-Reset', 0))

    def forget_unused(self):
        self.cache = {path: entry for path, entry in self.cache.items() if path in self.used}
        self.used = set()


def listing(github, path, key, max_pages=None):
    items, page = [], 1
    while True:
        response = github.get(f'{path}per_page=100&page={page}')
        batch = response[key]
        items += batch
        if len(batch) < 100:
            return items
        if page == max_pages:
            total = response['total_count']
            if len(items) < total:
                print(f'coldbox: {path} listing limited to {len(items)} of {total} results',
                      file=sys.stderr, flush=True)
            return items
        page += 1


def runner_labels(size):
    return LABELS if size == 'default' else LABELS[:3] + [f'coldbox-{size}']


def job_size(labels):
    labels = {label.casefold() for label in labels}
    return next((size for size in SIZES if labels and labels <= set(runner_labels(size))), None)


def runs_here(labels):
    return job_size(labels) is not None


def queued_jobs(github, repo, older_than=0, writers=None, witnesses=None, stall_seconds=0, observed=None):
    active_statuses = ('queued', 'in_progress', 'pending')
    runs = [run for status in active_statuses
            for run in listing(github, f'repos/{repo}/actions/runs?status={status}&', 'workflow_runs')]
    recent = listing(github, f'repos/{repo}/actions/runs?', 'workflow_runs', max_pages=2)
    runs.extend(run for run in recent if run.get('status') in active_statuses)
    run_ids = dict.fromkeys(run['id'] for run in runs if not held(run, repo, writers))
    now = time.time()
    jobs = [(run_id, job) for run_id in run_ids
            for job in listing(github, f"repos/{repo}/actions/runs/{run_id}/jobs?", 'jobs')
            if job['status'] == 'queued' and runs_here(job['labels'])]
    eligible = [(run_id, job) for run_id, job in jobs if not older_than or queued_at(job) <= now - older_than]
    if observed is not None:
        observed.extend(dict(id=job.get('id'), created_at=job.get('created_at')) for _, job in eligible)
    oldest, sizes = 0, collections.Counter()
    for run_id, job in eligible:
        age = int(max(0, now - queued_at(job))) if job.get('created_at') else 0
        oldest = max(oldest, age)
        size = job_size(job['labels'])
        sizes[size] += 1
        if (witnesses is not None and age >= stall_seconds
                and (size not in witnesses or age > witnesses[size][0])):
            witnesses[size] = age, run_id, job.get('id'), job.get('run_attempt')
    return len(eligible), oldest, sizes


def queue_job_times(jobs):
    for job in jobs:
        try:
            if type(job['id']) is int:
                yield job, at(job['created_at'])
        except (KeyError, TypeError, ValueError):
            continue


def observe_queue(github, repo, writers=None, witnesses=None):
    threshold = int(os.environ.get('COLDBOX_QUEUE_STALL_SECONDS', '300'))
    if threshold <= 0:
        raise ValueError('COLDBOX_QUEUE_STALL_SECONDS must be positive')
    jobs = []
    count, oldest, sizes = queued_jobs(github, repo, writers=writers, witnesses=witnesses, stall_seconds=threshold,
                                       observed=jobs)
    path = STATE / 'queues' / f'{repo}.json'
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            previous = json.loads(path.read_text())
        except (FileNotFoundError, ValueError):
            previous = {}
        if not isinstance(previous, dict):
            previous = {}
        retained = previous.get('accepted_jobs')
        cutoff = time.time() - KEEP_DAYS * 86400
        accepted = {job['id']: job for job, created in queue_job_times(retained if isinstance(retained, list) else [])
                    if created >= cutoff}
        identified = [job for job, _ in queue_job_times(jobs)]
        accepted.update((job['id'], job) for job in identified)
        stalled = bool(count) and oldest >= threshold
        observation = dict(queued=count, accepted_jobs=list(accepted.values()),
                           unidentified_queued=count - len(identified), oldest_wait_seconds=oldest, stalled=stalled,
                           observed_at=now_iso(), threshold_seconds=threshold)
        write_json(path, observation)
        if stalled != previous.get('stalled', False):
            print(f"coldbox: queue {'STALLED' if stalled else 'CLEARED'} on {repo}; "
                  f'{count} queued job(s); oldest waited {oldest} s', file=sys.stderr, flush=True)
    except OSError as error:
        print(f'coldbox: queue observation unavailable on {repo}: {error}', file=sys.stderr, flush=True)
    return count, oldest, sizes


def held(run, repo, writers):
    head = (run.get('head_repository') or {}).get('full_name') or ''
    actor = (run.get('triggering_actor') or run.get('actor') or {}).get('login')
    event = run.get('event')
    fork = head.casefold() != repo.casefold() if head else event in ('pull_request', 'pull_request_target', 'workflow_run')
    why = outsider(event, fork, actor, writers)
    if why:
        print(f"coldbox: not scaling for run {run['id']} on {repo}: {why}", file=sys.stderr, flush=True)
    return why


def queued_at(job):
    return datetime.fromisoformat(job['created_at'][:19]).replace(tzinfo=timezone.utc).timestamp()


def host_setting(path, unit):
    try:
        text = path.read_text().strip()
    except FileNotFoundError:
        return 0
    if not text.isdigit():
        raise ValueError(f'{path} must hold a whole number of {unit}, not {text!r}')
    return int(text)


def host_cpu_load():
    cpus = host_cpus()
    try:
        samples = []
        for index in range(2):
            if index:
                time.sleep(1)
            fields = Path('/proc/stat').read_text().splitlines()[0].split()
            if fields[0] != 'cpu' or len(fields) < 9:
                raise ValueError('invalid aggregate CPU counters')
            counters = [int(value) for value in fields[1:9]]
            if any(value < 0 for value in counters):
                raise ValueError('negative CPU counter')
            samples.append(counters)
        delta = [end - start for start, end in zip(*samples)]
        total = sum(delta)
        if any(value < 0 for value in delta) or not total:
            raise ValueError('invalid CPU counter delta')
        return cpus * (1 - delta[3] / total)
    except (OSError, ValueError, IndexError):
        return max(os.getloadavg()[0], cpus)


def ramp_room(add, running, now=None):
    try:
        cap = json.loads((STATE / 'ramp-cap.json').read_text())
    except FileNotFoundError:
        return add
    except (OSError, ValueError) as error:
        raise ValueError(f"invalid ramp cap: {STATE / 'ramp-cap.json'}") from error
    if (not isinstance(cap, dict) or type(cap.get('limit')) is not int or cap['limit'] < 0
            or ('expires' not in cap)
            or (cap['expires'] is None and not re.fullmatch(r'[a-f0-9]{64}', str(cap.get('evidence', ''))))
            or (cap['expires'] is not None and (type(cap['expires']) not in (int, float)
                                              or not math.isfinite(cap['expires'])))):
        raise ValueError(f"invalid ramp cap: {STATE / 'ramp-cap.json'}")
    if cap['expires'] is not None and cap['expires'] <= (time.time() if now is None else now):
        return add
    return max(0, min(add, cap['limit'] - running))


def rooms(vms, cpus, load, available, floor, vm_memory, reserve=0, ceiling=math.inf):
    """The one admission rule, for every job VM on every host: room for more VMs by each check. ceiling is how many
    more fit when every job VM, idle or busy, uses CORES_PER_JOB of the threads left after the reserve and grows to
    its full memory; an idle VM that takes a job only changes state, so a rush of jobs onto idle VMs never passes
    it. available is real MemAvailable less VMs still booting. The load already counts the other work, so the
    reserve only caps the VMs; each VM started now takes CORES_PER_JOB of the idle threads."""
    return dict(ceiling=min((cpus - reserve) // CORES_PER_JOB - vms, ceiling), memory=(available - floor) // vm_memory,
                load=-(int(load - cpus) // CORES_PER_JOB))


def burst_count(wanted, room):
    """How many job VMs to start for wanted queued jobs under the admission rule."""
    return max(0, min(wanted, *room.values()))


def declined(room):
    return min(room, key=room.get)


